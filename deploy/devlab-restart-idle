#!/usr/bin/env bash
# devlab-restart-idle — restart devlabd as soon as its run slot is FREE.
#
# Why this exists: deploying the DevLab service itself restarts devlabd — and devlabd is the process
# that executes Mercury runs. A restart mid-run kills the agent, loses the push/PR that was about to
# happen, and leaves a half-finished execution behind. The historical answer was to never dev-deploy
# the own repo, which meant the one service the owner watches never updated from its own runs.
#
# The split that fixes it: INSTALLING a new binary is harmless (the running process keeps its loaded
# image), only the RESTART is disruptive. So the per-repo deploy script installs immediately and hands
# the restart to this helper, launched as a transient systemd unit (systemd-run) so it lives OUTSIDE
# devlabd's control group and therefore survives the very restart it performs.
#
# It waits while devlabd holds the busy marker, and treats a STALE marker (writing PID gone) as free,
# so a crashed devlabd can never block the restart forever. After MAX_WAIT it restarts anyway: a run
# still going then is past every configured cap (DEVLAB_RUNS_MAX_DURATION defaults to 4h) and is not a
# reason to keep serving an outdated binary indefinitely.
#
# Install: sudo install -o root -g root -m 0755 deploy/devlab-restart-idle /usr/local/sbin/devlab-restart-idle
set -euo pipefail

MARKER="${DEVLAB_MERCURY_BUSY:-/var/lib/devlab/mercury/run-active}"
# The MIRROR of the busy marker: while we wait, devlabd reads this to learn "a restart is pending" and
# holds off starting new runs (the mutual exclusion of restart and run-start). We write our own PID as
# field 1 so devlabd ignores it if we crash, and remove it right before the restart. It sits beside
# run-active, in the same mercury dir devlabd owns; devlabd may override the path with the same env.
PENDING="${DEVLAB_MERCURY_RESTART_PENDING:-$(dirname "$MARKER")/restart-pending}"
UNIT="${DEVLAB_UNIT:-devlabd}"
POLL="${DEVLAB_RESTART_POLL:-10}"      # seconds between checks
MAX_WAIT="${DEVLAB_RESTART_MAXWAIT:-21600}"  # 6h — beyond any capped run

log() { logger -t devlab-restart-idle -- "$*" 2>/dev/null || true; echo "devlab-restart-idle: $*"; }

# busy: marker present AND the devlabd process that wrote it is still alive.
busy() {
  [[ -f "$MARKER" ]] || return 1
  local pid
  pid="$(awk '{print $1}' "$MARKER" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1        # unreadable/garbled → treat as free
  kill -0 "$pid" 2>/dev/null                  # dead writer → stale marker → free
}

# Announce the pending restart to devlabd, and always clear it on exit (even on error) so a start can
# never be wedged by a stale pending marker we left behind.
printf '%d %s\n' "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$PENDING" 2>/dev/null || true
trap 'rm -f "$PENDING" 2>/dev/null || true' EXIT

waited=0
while busy; do
  if (( waited == 0 )); then
    log "run in flight ($(cat "$MARKER" 2>/dev/null | tr -d '\n')) — deferring restart of $UNIT (new runs queue meanwhile)"
  fi
  if (( waited >= MAX_WAIT )); then
    log "waited ${waited}s (max ${MAX_WAIT}s) — restarting $UNIT anyway"
    break
  fi
  sleep "$POLL"
  waited=$(( waited + POLL ))
done

# Clear the pending marker BEFORE the restart so the freshly-started devlabd never sees a phantom pending
# restart (the trap also covers an early error exit).
rm -f "$PENDING" 2>/dev/null || true
log "restarting $UNIT after ${waited}s wait"
systemctl restart "$UNIT"
log "done"

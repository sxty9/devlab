#!/usr/bin/env bash
# holistic-sync-local — bringt die Holistic-Verfassung (CLAUDE.md) in die LOKALEN Arbeitskopien.
#
# Warum es das gibt: Der Mercury-Rollout schreibt via GitHub-API auf den Default-Branch der
# Remotes. Die lokalen Klone erfahren davon nie. Wer auf einem Feature-Branch arbeitet, bekommt
# die Verfassung auch durch ein Pull nicht — sie liegt auf main. Ergebnis: Claude sieht lokal
# keine Verfassung, und der Rollout steuert genau die Arbeit nicht, für die er gedacht ist.
#
# Warum als Skript und nicht in devlabd: Der Dienst läuft als User `devlab`, /home/nanu ist
# drwxr-x---. Der Dienst kommt da strukturell nicht rein, und das über sudo aufzubohren würde
# die Isolation des Runners für reine Bequemlichkeit opfern. Also läuft dies als DU.
#
# Was es tut, pro Repo mit Verfassung auf origin:
#   1. fetch, dann pull --ff-only (nur wenn gefahrlos — nie Merge, nie Rebase, nie force)
#   2. CLAUDE.md byte-identisch aus origin/<default> in den AUSGECHECKTEN Branch schreiben
#   3. ausschliesslich diese eine Datei committen
#
# Der Merge bleibt dadurch sauber: Branch und main tragen identischen Inhalt, git loest das als
# Add/Add ohne Konflikt und ohne Diff auf.
#
# Aufruf:  holistic-sync-local [--dry-run]
#          DEVLAB_REPOS_PATH=/pfad holistic-sync-local
set -uo pipefail

ROOT="${DEVLAB_REPOS_PATH:-$HOME}"
DRY=""
[ "${1:-}" = "--dry-run" ] && DRY=1

cd "$ROOT" || { echo "kein Zugriff auf $ROOT" >&2; exit 1; }

# Erkennungsmerkmal des generierten Blocks (Mercury schreibt ihn mit diesem Marker).
MARKER="BEGIN HOLISTIC AXIOMS"

pulled=0; synced=0; already=0; skipped=0

for d in */; do
  r="${d%/}"
  [ -d "$r/.git" ] || continue

  git -C "$r" fetch -q --prune origin 2>/dev/null || { skipped=$((skipped+1)); continue; }

  # Nur Repos, die die Verfassung auf ihrem Default-Branch tragen.
  src=$(git -C "$r" show origin/HEAD:CLAUDE.md 2>/dev/null) || continue
  printf '%s' "$src" | grep -q "$MARKER" || continue

  branch=$(git -C "$r" branch --show-current 2>/dev/null)
  [ -n "$branch" ] || { printf "  – %-26s detached HEAD, uebersprungen\n" "$r"; skipped=$((skipped+1)); continue; }

  # 1) Gefahrloses Nachziehen. Schlaegt fehl, wenn divergiert -> wir lassen es in Ruhe.
  if [ "$(git -C "$r" rev-list --count HEAD..origin/HEAD 2>/dev/null || echo 0)" -gt 0 ]; then
    if [ -z "$DRY" ] && git -C "$r" pull -q --ff-only 2>/dev/null; then
      pulled=$((pulled+1))
    fi
  fi

  # 2) Ist die Verfassung im Arbeitsverzeichnis schon identisch?
  if [ -f "$r/CLAUDE.md" ] && [ "$(cat "$r/CLAUDE.md")" = "$src" ]; then
    already=$((already+1))
    continue
  fi

  if [ -n "$DRY" ]; then
    printf "  → %-26s wuerde CLAUDE.md auf '%s' setzen\n" "$r" "$branch"
    synced=$((synced+1))
    continue
  fi

  printf '%s\n' "$src" > "$r/CLAUDE.md"
  git -C "$r" add -- CLAUDE.md 2>/dev/null
  if git -C "$r" commit -q -m "Holistic: Verfassung (CLAUDE.md) lokal angleichen

Inhaltsgleich mit dem Default-Branch, damit ein Merge dieses Branches keinen
Diff und keinen Konflikt erzeugt." -- CLAUDE.md 2>/dev/null; then
    printf "  ✓ %-26s CLAUDE.md auf '%s' angeglichen\n" "$r" "$branch"
    synced=$((synced+1))
  else
    printf "  – %-26s Commit nicht moeglich auf '%s'\n" "$r" "$branch"
    skipped=$((skipped+1))
  fi
done

echo
echo "nachgezogen: $pulled   angeglichen: $synced   bereits aktuell: $already   uebersprungen: $skipped"
[ -n "$DRY" ] && echo "(Probelauf — nichts geaendert)"
exit 0

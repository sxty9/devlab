#!/usr/bin/env bash
# devlab-exec — pinned per-user executor for DevLab. Invoked ONLY by the devlab service via:
#     sudo -n -u <targetuser> /usr/local/sbin/devlab-exec <verb> <args...>
# It runs AS the target user (sudo -u) and CONFINES every path to that user's workspace root
# (<state root>/workspaces/<self>), so a compromised devlab service cannot reach another user's
# files, /home, or the token store. Must be root-owned and non-writable (see devlab.sudoers).
#
# Verbs:
#   git   <dir> <git-args...>   run git in <dir>  (clone: <dir> = the workspace root)
#   claude<dir> <cli-args...>   run the claude CLI (agentic AI) in <dir>
#   write <file>                write stdin to <file> (parents created)
#   rm    <file>                remove <file>
# The GitHub token, when needed, is passed via the DEVLAB_GH_TOKEN env (sudoers env_keep), never argv.
set -euo pipefail
# 0027: files 0640 / dirs 0750 — the workspace's setgid group is `devlab`, so the read-only devlab
# service can read what the user creates here; other users (not in the group) cannot.
umask 0027

SELF="$(id -un)"
# The ONE state-root derivation every DevLab wrapper shares, mirroring statepath.Workspaces():
# workspaces live at <state root>/workspaces. Keep it identical in devlab-install.
#
# These are env-overridable DEFAULTS and the override is a DIRECT-INVOCATION test seam only:
# devlab-exec is invoked BY the devlab service through sudo, whose env_reset strips the caller's
# environment. DEVLAB_STATE_DIR and DEVLAB_WORKSPACES must therefore NEVER be added to the env_keep
# list in devlab.sudoers — a service that could set them could move the very boundary this wrapper
# exists to hold. The check below is the belt to that brace.
STATE_DIR="${DEVLAB_STATE_DIR:-/var/lib/devlab}"
WORKSPACES_ROOT="${DEVLAB_WORKSPACES:-$STATE_DIR/workspaces}"
ROOT="$WORKSPACES_ROOT/$SELF"

die() { echo "devlab-exec: $*" >&2; exit 64; }

# A workspace root is a directory owned by the user we run as. Anything else is not this user's
# workspace, so there is nothing to confine against — refuse before any verb runs.
{ [ -d "$ROOT" ] && [ -O "$ROOT" ]; } || die "no workspace root owned by $SELF at $ROOT"

# require_under_root <path> — resolve the deepest existing ancestor (defeating symlink escapes) and
# require the result stays within $ROOT.
require_under_root() {
  local p="$1" parent real
  [ -n "$p" ] || die "empty path"
  case "$p" in /*) : ;; *) die "path must be absolute: $p" ;; esac
  parent="$p"
  while [ ! -e "$parent" ] && [ "$parent" != "/" ]; do parent="$(dirname "$parent")"; done
  real="$(realpath -e -- "$parent")" || die "cannot resolve: $p"
  local rootreal
  rootreal="$(realpath -e -- "$ROOT")" || die "no workspace root for $SELF"
  case "$real/" in
    "$rootreal"/*) : ;;
    *) die "path escapes workspace root: $p" ;;
  esac
}

verb="${1:-}"; shift || true
case "$verb" in
  git)
    dir="${1:-}"; shift || true
    require_under_root "$dir"
    cd -- "$dir"
    export GIT_TERMINAL_PROMPT=0
    # safe.directory='*': the workspace is confined + owned by this same user, but sudo's env
    # (HOME/uid handling) can otherwise trip git's dubious-ownership guard. Safe here by construction.
    exec git -c "safe.directory=*" "$@"
    ;;
  claude)
    dir="${1:-}"; shift || true
    require_under_root "$dir"
    cd -- "$dir"
    # claude reads the invoking user's ~/.claude (config + auth). sudo may not reset HOME, so set
    # it (and USER) from the passwd entry of whoever we are running as, so the RIGHT config loads.
    HOME="$(getent passwd "$SELF" | cut -d: -f6)"; export HOME
    export USER="$SELF" LOGNAME="$SELF"
    command -v claude >/dev/null 2>&1 || die "claude CLI not installed for $SELF"
    exec claude "$@"
    ;;
  write)
    file="${1:-}"; shift || true
    require_under_root "$file"
    mkdir -p -- "$(dirname -- "$file")"
    cat > "$file"
    ;;
  rm)
    file="${1:-}"; shift || true
    require_under_root "$file"
    rm -f -- "$file"
    ;;

  artifact-build)
    # Build the repo's deployable artifact AS THIS USER (the workspace owner), path-confined to the
    # workspace root. The autonomous runner builds here and the root deploy wrapper only INSTALLS the
    # prebuilt result — root NEVER builds agent/repo code (Finding C: an npm postinstall or go build
    # directive would otherwise run as root). Trust-equivalent to the `claude` verb: it runs the repo's
    # own npm/go build as this user, which the agent could run anyway. Produces <wt>/.mercury-artifact
    # holding the Go daemon binary, the built web SPA in web/ (self repo), and — for a holistic service
    # that carries a ui/ directory — that dashboard-facing UI SOURCE in ui/ (built later by the shared
    # dashboard, never here: a service ui may use only @holistic/ui, react, react-dom or relative files,
    # so it has no deps of its own and cannot be built in isolation).
    wt="${1:-}"; require_under_root "$wt"
    [ -d "$wt" ] || die "no such workspace: $wt"
    cd -- "$wt"
    HOME="$(getent passwd "$SELF" | cut -d: -f6)"; export HOME
    export USER="$SELF" LOGNAME="$SELF" GIT_TERMINAL_PROMPT=0 CGO_ENABLED=0
    art="$wt/.mercury-artifact"
    rm -rf -- "$art"; mkdir -p -- "$art"
    built=0
    # The service's DECLARED build kind — a single word in a checked-in build.kind at the repo root (see
    # setup_valid_build_kind in devlab-setup-lib.sh: go-daemon | python-app). It is what makes a service
    # SAY what it is instead of the installer guessing from a filename. A Go service needs no declaration:
    # when the Go build below produces a binary and nothing was declared, the kind is recorded as
    # go-daemon (the historical default, now written down). The declaration DRIVES the python-app payload
    # build below and is stamped into the artifact so the installer reads it (never re-derives it).
    declared_kind=""
    [ -f build.kind ] && declared_kind="$(head -n1 build.kind | tr -d '[:space:]')"
    repo_name="$(basename -- "$wt")"
    # The shared setup library, sourced ONCE for the whole build: the serve-root convention the web stamp
    # follows and the python bundling the payload branch uses come from the SAME source the installer and
    # the production receiver read, so a build can never stamp a destination the installer would not accept.
    SETUP_LIB="${DEVLAB_SETUP_LIB:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/devlab-setup-lib.sh}"
    [ -r "$SETUP_LIB" ] || die "shared setup library not found: $SETUP_LIB"
    # shellcheck source=/dev/null
    . "$SETUP_LIB"
    if [ -f package.json ]; then
      npm ci --no-audit --no-fund || npm install --no-audit --no-fund
      # Where the built web bundle lands is READ FROM THE BUILD'S OWN RESULT, never guessed from a
      # fixed ./dist|./build list at the repo root. A hardcoded list ages the moment a project
      # restructures — holistic is a pnpm monorepo whose bundle lives in frontend/app/dist, not at the
      # root, so the old list found nothing and this wrapper wrongly reported 'nothing to build' right
      # after a successful build, pointing every reader at the innocent repository. The build itself
      # names its output: a deployable web bundle is the directory into which it writes an index.html —
      # the browser's start page, and exactly what the installer later demands (serve_readable requires
      # index.html). We tell that output apart from the checkout's source files by MODIFICATION TIME: a
      # marker stamped just before the build makes the freshly written index.html newer than everything
      # the clone brought in. This is tool-agnostic (vite, webpack, parcel, CRA all emit index.html into
      # their outDir) and survives any future layout change.
      marker="$art/.build-start"; : > "$marker"
      CI=true npm run build
      # Directories holding an index.html the build just wrote, newest-independent, with the checkout's
      # own machinery excluded: node_modules can carry package index.html files; .git and the artifact
      # under construction are ours.
      mapfile -t webdirs < <(
        find . -type f -name index.html -newer "$marker" \
          -not -path '*/node_modules/*' -not -path './.git/*' -not -path './.mercury-artifact/*' \
          -printf '%h\n' 2>/dev/null | sort -u
      )
      rm -f -- "$marker"
      if [ "${#webdirs[@]}" -eq 0 ]; then
        # A build that SUCCEEDED but whose result we cannot find is a fault of THIS wrapper's output
        # detection — never the same state as 'there was nothing to build' (no package.json / go.mod),
        # and never a reason to accuse the repository. Kept as its own named error (task point 2+3).
        die "build succeeded but its web bundle was not found (no index.html written under $wt after 'npm run build') — this is a fault of devlab-exec, not of the repository: the build itself ran"
      fi
      # One deployable SPA is the norm. A multi-app monorepo that writes several is genuinely ambiguous;
      # pick the shallowest deterministically and NAME the alternatives rather than guess in silence.
      webdir="${webdirs[0]}"
      if [ "${#webdirs[@]}" -gt 1 ]; then
        webdir="$(printf '%s\n' "${webdirs[@]}" | awk -F/ '{print NF, $0}' | sort -n -k1,1 -k2 | head -n1 | cut -d' ' -f2-)"
        echo "devlab-exec: note: the build wrote more than one web bundle (${webdirs[*]}); delivering the shallowest ($webdir)" >&2
      fi
      cp -a "$webdir" "$art/web"; built=1
      # ── THE PACKAGE SAYS WHERE ITS FACE BELONGS ────────────────────────────────────────────────
      # A built web bundle travels with a `web.root` stamp: the absolute directory the target host must
      # install it into. The installer and the production receiver READ that stamp; neither derives a
      # destination from the repository name. That derivation is exactly what left every service's face
      # in the package — the receiver installed a web bundle for ONE name and dropped every other — and
      # what made the instance root serve that one service instead of the landscape's dashboard.
      #
      # The value comes from the PACKAGE'S OWN DECLARATION (holistic-service.json, edge.serveRoot),
      # falling back to the landscape's serve convention (setup_service_www: /opt/<repo>/www) when the
      # repository declares nothing. It used to come from a comparison against the repository NAME —
      # `if [ "$repo_name" = devlab ]` — which is the same defect as the route below in its second guise:
      # a property of the PACKAGE derived from its spelling, and therefore holdable by exactly one member
      # of the landscape. Whatever the value, it is inside the service's OWN territory or the installer
      # refuses it (setup_valid_web_root) — the stamp says where, it does not grant where.
      web_root="$(setup_decl_serve_root "$wt" "$repo_name")" \
        || die "cannot stamp where the face of '$repo_name' belongs (see the reason above)"
      printf '%s\n' "$web_root" > "$art/web.root"
    fi
    if [ -f backend/go.mod ]; then gd=backend; elif [ -f go.mod ]; then gd=.; else gd=""; fi
    if [ -n "$gd" ]; then
      # ── graves: cgo storage backends that are compiled in ONLY behind a build tag ──────────────────
      # A Holistic service can carry a "grave": a store implemented in Rust and reached over its C ABI
      # (aigentic: scheme + lakearch, scrapr: lakearch), each gated by `//go:build <grave>`. Miss the tag
      # and the build still SUCCEEDS — it just yields a binary whose grave answers "built without <grave>
      # support", which crash-loops the unit the moment it is deployed. So a tag is never optional: EVERY
      # grave whose sources are present is compiled in, and one we cannot satisfy FAILS THE BUILD LOUDLY
      # instead of shipping a silently crippled binary. (Handling only `scheme` here is what let a
      # dev-deploy install a lakearch-less scraprd and take the service down.)
      #
      # Uniform per grave <g>: the prebuilt lib+header live at the instance-neutral, build-user-readable
      # PINNED path in /etc/devlab/<g>-lib-dir, laid out as <pin>/target/release/lib<g>_ffi.a and
      # <pin>/crates/<g>-ffi/include/<g>_ffi.h. The cgo directives reach them through a <g> dir that is a
      # SIBLING of the repo clone (${SRCDIR}/../../../<g>), so we materialize exactly those two files into
      # that sibling — creating it when the repo was never cloned there, and overwriting a SOURCE checkout's
      # missing cargo artifacts. prod stays install-only: the libs are prebuilt here, never built on a target.
      tags=""
      for g in scheme lakearch; do
        # The tag itself is the signal: a positive `//go:build … <g> …` term anywhere in the Go sources.
        # `//go:build !<g>` (the pure-Go stand-in) must NOT count, hence the two explicit patterns.
        grep -rqsE --include='*.go' -e "^//go:build ${g}\b" -e "^//go:build .*[^!]${g}\b" . || continue
        pin="/etc/devlab/${g}-lib-dir"
        [ -r "$pin" ] || die "$g build required but $pin is missing"
        gdir="$(head -n1 "$pin" | tr -d '[:space:]')"
        lib="$gdir/target/release/lib${g}_ffi.a"
        hdr="$gdir/crates/${g}-ffi/include/${g}_ffi.h"
        { [ -n "$gdir" ] && [ -f "$lib" ] && [ -f "$hdr" ]; } \
          || die "pinned $g dir invalid: need target/release/lib${g}_ffi.a + crates/${g}-ffi/include/${g}_ffi.h under '$gdir'"
        sib="$(dirname -- "$wt")/$g"
        install -d "$sib/target/release" "$sib/crates/${g}-ffi/include"
        cp -f "$lib" "$sib/target/release/lib${g}_ffi.a"
        cp -f "$hdr" "$sib/crates/${g}-ffi/include/${g}_ffi.h"
        tags="${tags:+$tags,}$g"; export CGO_ENABLED=1
      done
      ( cd -- "$gd" && if [ -d cmd ]; then go build ${tags:+-tags "$tags"} -o "$art/" ./cmd/...; else go build ${tags:+-tags "$tags"} -o "$art/" ./...; fi )
      built=1
    fi
    # ── python-app: a prebuilt, SELF-CONTAINED payload the installer copies VERBATIM to /opt/<repo> ──────
    # A service DECLARES `python-app` in build.kind; there is no go.mod to build and there never will be a
    # <repo>d. The deployable program is a virtualenv (built HERE, as the unprivileged runner — prod never
    # builds) plus whatever the app needs, laid out UNDER payload/ so it becomes /opt/<repo>/ on install.
    # The venv is built with --copies, but that copies only the INTERPRETER, not its standard library — the
    # interpreter would still fetch the stdlib from the BUILD host's python (…/usr/lib/pythonX.Y), which a
    # target with a different python version does not have, so the service would die before its first line.
    # So we BUNDLE the interpreter and its full stdlib into the payload (setup_bundle_python) and re-point
    # the venv at them: the payload is truly relocatable across python versions, depending on nothing the
    # target's own python provides. Console-script shebangs are relocated to the FINAL /opt/<repo>/venv, and
    # the bundle's runnability is PROVEN here before it can ship (setup_python_payload_selftest — the same
    # proof the receiver re-runs on the target before copying). A python-app MUST ship setup/<unit>.service:
    # only the unit knows how to start it (its ExecStart names the interpreter and module), so the unit — not
    # a name convention — is the source of truth. The build fails LOUDLY rather than ship a half payload.
    if [ "$declared_kind" = python-app ]; then
      command -v python3 >/dev/null 2>&1 || die "build.kind declares python-app but python3 is not available to build the venv"
      [ -d setup ] || die "a python-app must ship its own setup/<unit>.service — only the unit knows how to start it; none was found in the repo"
      payload="$art/payload"; venv="$payload/venv"
      rm -rf -- "$payload"; mkdir -p -- "$payload"
      python3 -m venv --copies "$venv" || die "failed to create the virtualenv for the python-app payload"
      "$venv/bin/python" -m pip install --disable-pip-version-check --no-input --upgrade pip >/dev/null 2>&1 || true
      if [ -f requirements.txt ]; then
        "$venv/bin/python" -m pip install --disable-pip-version-check --no-input -r requirements.txt \
          || die "pip install -r requirements.txt failed for the python-app payload"
      fi
      if [ -f pyproject.toml ] || [ -f setup.py ] || [ -f setup.cfg ]; then
        "$venv/bin/python" -m pip install --disable-pip-version-check --no-input . \
          || die "pip install . failed for the python-app payload (the app package must be installable)"
      fi
      # Bundle the interpreter + stdlib so the venv is version-portable, then relocate its shebangs to the
      # final install prefix. Both come from the ONE shared library the installer and receiver also source.
      pyver="$(setup_bundle_python "$venv" "/opt/$repo_name/venv")" \
        || die "failed to bundle a relocatable python into the python-app payload"
      setup_relocate_venv "$venv" "/opt/$repo_name/venv"
      # Prove the bundle actually runs and is self-contained BEFORE it ships (the build host trivially passes;
      # the value is that the identical proof runs at receive, where a differing target is caught pre-copy).
      setup_python_payload_selftest "$payload" >/dev/null \
        || die "the bundled python payload failed its self-test on the build host — refusing to ship a payload that cannot even run here"
      printf '%s\n' "$pyver" > "$art/build.python"
      built=1
    fi
    # ── the service UI belongs INTO the artifact (a delivery ships all a service needs, not just its
    # program). A holistic service contributes its dashboard face through a ui/ directory; its SOURCE
    # is staged verbatim so the root installer can wire it into the shared dashboard and let THAT build
    # verify it (only @holistic/ui, react, react-dom or relative files are allowed there, so the source
    # carries no deps and is never built here). A repo without ui/ is untouched — nothing is invented.
    if [ -d ui ]; then
      rm -rf -- "$art/ui"; mkdir -p -- "$art/ui"
      # node_modules / dist / build are the dashboard's to produce, never shipped in the source stage.
      ( cd ui && tar --exclude=./node_modules --exclude=./dist --exclude=./build -cf - . ) \
        | ( cd "$art/ui" && tar -xf - )
      built=1
    fi
    # ── a service may SHIP ITS OWN first-time setup product: a top-level setup/ dir carrying its systemd
    # unit under its OWN name (setup/<unit>.service — e.g. a dashboard's <repo>-dashboard.service), and
    # optionally its edge route / rights. It travels into the artifact verbatim so the installer READS the
    # unit's real name from it instead of computing <repo>.service. Nothing here is trusted or executed —
    # only carried; the root installer validates it (User=<repo>, foreign-unit refusal, reserved names)
    # exactly as it validates the generated product. A repo WITHOUT a setup/ dir is untouched: emit-setup
    # then generates the uniform product from the ONE template as before.
    if [ -d setup ]; then
      rm -rf -- "$art/setup"; mkdir -p -- "$art/setup"
      ( cd setup && tar -cf - . ) | ( cd "$art/setup" && tar -xf - )
      built=1
    fi
    # ── STAMP the build kind into the artifact so the installer READS it, never guesses ─────────────────
    # The kind is authoritative from the declaration when present (validated), else recorded as go-daemon
    # when the Go build produced a binary. An artifact that produced no program (only ui/ or setup/) gets
    # NO stamp — the installer then refuses it BY NAME rather than assume a Bauart.
    if [ -n "$declared_kind" ]; then
      case "$declared_kind" in
        go-daemon | python-app) printf '%s\n' "$declared_kind" > "$art/build.kind" ;;
        *) die "repo declares an unknown build kind '$declared_kind' in build.kind (known: go-daemon python-app)" ;;
      esac
    elif [ -n "${gd:-}" ]; then
      printf 'go-daemon\n' > "$art/build.kind"
    fi
    # ── STAMP THE EDGE ROLE so the installer READS how this delivery is reached, never guesses ─────────
    # Derived from the repository's own declaration (holistic-service.json, edge.role; absent = service)
    # and travelling with the artifact exactly like build.kind and web.root. It is stamped for EVERY
    # package, so a delivery says what it is rather than leaving the installer to fall back on a default.
    # What it does NOT carry is a hostname: which name a root application answers to is the target host's
    # to declare, and no package can state it.
    edge_role="$(setup_decl_edge_role "$wt")" \
      || die "cannot stamp the edge role of '$repo_name' (see the reason above)"
    printf '%s\n' "$edge_role" > "$art/edge.role"
    [ "$built" = 1 ] || die "nothing to build (no package.json / go.mod / ui / setup)"
    ;;

  emit-setup)
    # Lay the service's first-time SETUP product (systemd unit + edge route + rights) BESIDE the built
    # program, under <wt>/.mercury-artifact/setup/, so the production receiver INSTALLS it rather than
    # generating anything of its own ("Ein Erzeuger, ein Installierer"). The templates come from the ONE
    # shared library the dev installer also uses (devlab-setup-lib.sh) — no second unit template exists.
    # Runs AS THIS USER (like artifact-build) so the emitted files are the workspace owner's, never root.
    wt="${1:-}"; repo="${2:-}"; port="${3:-}"
    require_under_root "$wt"
    [ -d "$wt" ] || die "no such workspace: $wt"
    { [ -n "$repo" ] && [ -n "$port" ]; } || die "emit-setup needs <wt> <repo> <port>"
    [[ "$port" =~ ^[0-9]{1,5}$ ]] || die "invalid port: $port"
    SETUP_LIB="${DEVLAB_SETUP_LIB:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/devlab-setup-lib.sh}"
    [ -r "$SETUP_LIB" ] || die "shared setup library not found: $SETUP_LIB"
    # shellcheck source=/dev/null
    . "$SETUP_LIB"
    # The repo name must be path-safe (it becomes $dst/<repo>.*): validate its SHAPE for every branch. The
    # reserved-IDENTITY refusal is NOT applied here, though — it is applied only in the GENERATE branch
    # below, where emit-setup itself fabricates <repo>.service/<repo>.caddy with `User=<repo>`. A service
    # that SHIPS ITS OWN setup product (a divergently-named unit like <repo>-dashboard.service) or the self
    # repo NAMES its own identity in the delivered unit; emit-setup generates nothing over it, and only the
    # root installer — which alone can see the host — decides ownership there (a reserved name is admitted
    # for the service the identity already belongs to). Refusing a reserved <repo> HERE would trap exactly
    # that owner (holistic: the landscape's own dashboard, whose repo name is on the reserved list), which
    # is the defect being removed. Shape now; reserved only when generating.
    setup_valid_repo_shape "$repo" || die "refusing to emit setup for '$repo'"
    art="$wt/.mercury-artifact"
    [ -d "$art" ] || die "no artifact at $art — build before emitting setup"
    dst="$art/setup"
    # Do NOT wipe: artifact-build may have staged a service's OWN setup product here. mkdir is enough.
    mkdir -p -- "$dst"

    # ── HOW THIS DELIVERY IS REACHED FROM OUTSIDE is read, never derived from the repository name ──────
    # THE RULE, and it is the whole point of this branch: the SELF REPO NAME decides a LAYOUT question
    # (which unit file is shipped) and NOTHING about the edge, ever again. It used to decide both, so the
    # one repository called `devlab` was also the one that could own the whole `/api/*` prefix — and when
    # the landscape dashboard grew into the same role, the two collided in one site block and the alphabet
    # decided whose API existed (measured on production 2026-08-09). The edge role now comes from the
    # PACKAGE (holistic-service.json → $art/edge.role, stamped by artifact-build), and a root application
    # gets NO caddy text here at all: emit-setup runs in a developer's working tree and cannot know the
    # hostname of the TARGET host. That site block is rendered where the host is visible — at install.
    # Re-derived from the SAME one source artifact-build stamped from (the repository's declaration), not
    # read back off the stamp: emit-setup runs only on the production path and can meet an artifact built
    # by an older devlab-exec that carries no stamp at all. Reading the declaration makes it independent
    # of that, and re-stamping keeps the artifact self-describing for the installer that receives it.
    role="$(setup_decl_edge_role "$wt")" \
      || die "cannot emit a setup product for '$repo' without knowing how it is reached (see the reason above)"
    printf '%s\n' "$role" > "$art/edge.role"
    self_layout=0
    [ "$repo" = "${DEVLAB_SELF_REPO:-devlab}" ] && self_layout=1

    case "$role" in
      application|dashboard)
        # A root application that ALSO ships a naked service fragment is contradicting itself: the
        # fragment would be a route into a path space that is no longer reached that way. Named, not
        # silently ignored.
        if [ -f "$dst/${repo}.caddy" ]; then
          die "'$repo' declares the edge role '$role' (a root application on its own hostname) but its package also ships a service route fragment at setup/${repo}.caddy — these are two different ways of being reached and only one can be true; remove the fragment"
        fi
        ;;
    esac

    if [ "$self_layout" = 1 ]; then
      # The self repo (devlab) is a LAYOUT special case, and only that: its unit is NOT the generated
      # /opt/<repo> template but the CHECKED-IN deploy/devlabd.service (User=devlab, /usr/local/bin/devlabd,
      # its own fixed listen port), so the delivered setup product is that unit verbatim under its real
      # name. The atlas-proposed <port> is not used for self: devlab's port is fixed in its committed unit.
      src_unit="$wt/deploy/devlabd.service"
      [ -f "$src_unit" ] || die "self setup needs the checked-in unit at $src_unit"
      cp -- "$src_unit" "$dst/devlabd.service"
      selfport="$(setup_unit_listen_port "$src_unit")"; [ -n "$selfport" ] || selfport="$port"
      [ "$role" = service ] && setup_route_text "$repo" "$selfport" > "$dst/${repo}.caddy"
      if [ -f "$wt/permissions/${repo}.json" ]; then
        cp -- "$wt/permissions/${repo}.json" "$dst/${repo}.json"
      fi
      echo "devlab-exec: emitted self setup product (devlabd.service on :$selfport, edge role '$role') into $dst"
    elif ls "$dst"/*.service >/dev/null 2>&1; then
      # The service SHIPPED its own setup product (a *.service already staged by artifact-build): its unit
      # carries its own name, so nothing is generated over it. The receiver reads that name on install.
      echo "devlab-exec: setup product already present in $dst (repo-provided, edge role '$role') — leaving it, generating nothing"
    else
      # THE GENERATE BRANCH — emit-setup fabricates the uniform identity <repo>.service (User=<repo>) and,
      # for a uniform service, <repo>.caddy. A reserved <repo> would fabricate a colliding OS/package/
      # landscape identity, and a freshly generated uniform unit can never be the OWNER of a reserved
      # identity (the owner ships its own setup product and took a branch above, never this one). So the
      # reserved list is enforced HERE, the one place emit-setup coins a name into an identity. The root
      # installer refuses it again at install; this is the early, same-rule refusal.
      setup_valid_repo_name "$repo" || die "refusing to generate a setup product for the reserved name '$repo'"
      setup_unit_text "$repo" "$port" > "$dst/${repo}.service"
      [ "$role" = service ] && setup_route_text "$repo" "$port" > "$dst/${repo}.caddy"
      # The rights manifest travels too when the checkout carries one — a validated COPY, never executed.
      if [ -f "$wt/permissions/${repo}.json" ]; then
        cp -- "$wt/permissions/${repo}.json" "$dst/${repo}.json"
      fi
      echo "devlab-exec: emitted setup product for '$repo' (port $port, edge role '$role') into $dst"
    fi
    ;;

  *)
    die "unknown verb: ${verb:-<none>}"
    ;;
esac

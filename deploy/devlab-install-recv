#!/usr/bin/env bash
# devlab-install-recv — put the PRODUCTION host in order, in ONE self-checking pass. It has two jobs
# behind the SAME entry point (Keine ähnlichen Geschwister — there is no second script that installs
# the receiver a second way):
#
#   1. DEFAULT (no --provision): install (or refresh) the prod-side deploy receiver — the one root
#      artifact the delivery chain can NOT deliver to itself: devlab-deploy-recv and the library it
#      sources, devlab-setup-lib.sh, live in /usr/local/sbin and are the forced command behind the
#      deploy key. That key can only rsync into staging and trigger an install, so it can never
#      overwrite the receiver with a new version (that would be self-escalation; see the receiver
#      header and backend/internal/deploy/wrappers.go, where `selfWrappers` deliberately EXCLUDES the
#      receiver). A receiver fix therefore reaches production ONLY through an operator with root on the
#      target running this script.
#
#   2. --provision: bring a NAKED, freshly-installed server all the way to being a production target
#      the chain can deliver to — in ONE run, with no prose left to hand-copy. Before today the naked
#      host needed a person to transcribe an authorized_keys forced-command line, ensure rrsync,
#      create the staging and web roots, and stand up Caddy, all from deploy/RUNS-PROVISIONING.md. That
#      manual stretch was not reproducible, not checkable, not repeatable. This mode does all of it and
#      then PROVES it, and it REUSES the receiver install above (install_one) rather than growing a
#      second copy of it.
#
# WHY THE DEFAULT MODE EXISTS: the first-time-setup fix (a service's systemd unit now travels in the
# delivery artifact and the receiver installs it on first arrival) was merged, but every service that
# had never been set up on the production host kept failing `systemctl restart <repo>: Unit not found`,
# because the OLD receiver on the target only ever restarted an existing unit. This script puts the
# fixed receiver on the target and, for each service named, brings it up from the artifact the last
# (failed) send already staged — so the missing setup happens immediately instead of on the next retry.
#
# RUN IT ON THE PRODUCTION HOST, AS ROOT, FROM A CHECKOUT OF THE MERGED STANDARD BRANCH:
#     sudo /path/to/deploy/devlab-install-recv [service ...]                       # refresh receiver
#     sudo /path/to/deploy/devlab-install-recv --provision \
#          --deploy-pubkey <path|-|literal> --edge-address <host:port|:port> [--recv-user <user>] \
#          [--staging <dir>] [--www <dir>] [--caddyfile <file>] [--no-pkg] \
#          [--overlay-address <cidr> --overlay-listen-port <port> \
#           --overlay-peer-pubkey <key|path|-> --overlay-peer-allowed <cidr> \
#           [--overlay-endpoint <host:port>] [--overlay-verify-peer <ip>]] [service ...]
#   e.g.  sudo ./deploy/devlab-install-recv --provision --deploy-pubkey /root/deploy.pub \
#              --edge-address 10.10.0.1:8080 prizm presentr
# With no service names it installs/refreshes (and, with --provision, provisions) the host and proves
# it, but triggers no service.
#
# THE EDGE ADDRESS IS ONE DECLARATION, READ BY BOTH SIDES: where this environment's edge answers is a
# single fact stated in ONE runtime-config file (default /etc/holistic/edge-address, beside jwt-secret).
# --provision writes it there from --edge-address and BUILDS the Caddy edge on it; the routing layer (a
# production-side sxgate) reads the SAME file. There is NO baked-in default and neither side guesses the
# other's — a missing declaration is a NAMED deficiency, not a silent ":80". Ask the declaration with:
#     devlab-install-recv --print-edge-address        # prints the address the routing layer forwards to
#
#   3. --overlay-here: catch up THIS (home/chain) host's side of the production overlay after the far
#      side was rebuilt — swap in the far side's NEW public key and PROVE the tunnel. Same script, no
#      sibling. It configures only the overlay (the home side is not a delivery target):
#          sudo ./deploy/devlab-install-recv --overlay-here \
#               --overlay-address <cidr> --overlay-peer-pubkey <key|path|-> \
#               --overlay-peer-allowed <cidr> --overlay-peer-endpoint <host:port> \
#               [--overlay-keepalive <secs>] --overlay-verify-peer <ip>
#
# THE TRANSPORT IS THE FIRST STAGE, NOT AN ACCESSORY: the chain reaches production over a private
# WireGuard overlay; DEVLAB_RUNS_PROD_TARGET names a host that only EXISTS once the overlay carries.
# --provision sets up THIS host's side of that overlay in the same run; the closing report prints the
# ONE line that catches up the home side. Each side generates its OWN keypair and hands out only the
# PUBLIC half — a private overlay key is NEVER transmitted in either direction (Geheimnisse entstehen
# auf der Seite, die sie behält). All addresses/port/keys are arguments; none is baked into the repo.
#
# It is IDEMPOTENT (an already-current server is only reported), FAIL-CLOSED (it stops at the first
# problem rather than half-installing), and REVERSIBLE (every file it replaces is backed up first and
# restored automatically if a later step fails). For the DEPLOY PAYLOAD it NEVER builds and NEVER
# fetches: it installs the exact bytes sitting beside it in deploy/, and prints their SHA-256 so the
# installed receiver can be checked against the standard branch. Standing up the host's OS
# prerequisites (rsync/rrsync, Caddy) is a different thing from building a service: --provision may ask
# the system package manager for those two named packages when they are absent (idempotent, and
# fail-closed with the exact missing name if the package manager cannot supply them, or with --no-pkg).
# It NEVER creates a private key on the target and never writes one there — it takes only the PUBLIC
# half of the deploy key (Geheimnisse entstehen nicht auf dem Ziel).
#
# Instance-neutral: no hostname, domain, or instance path is baked in. Every such value is a default
# derived from the state root (like the receiver's own paths) or comes in as an argument.
set -euo pipefail

# The two artifacts this installs, and where they go. SBIN mirrors the receiver's own install target;
# it is overridable ONLY as a direct test seam, never an instance value baked into the repo.
SBIN="${DEVLAB_SBIN:-/usr/local/sbin}"
# The source is the deploy/ directory this script lives in (the merged checkout), so the installed
# receiver is exactly the reviewed one — no second copy of its bytes exists to drift from.
SRC_DIR="${DEVLAB_RECV_SRC:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)}"

RECV="devlab-deploy-recv"
LIB="devlab-setup-lib.sh"

# The ONE state-root derivation the receiver itself carries: every host path DERIVES from it, so a
# provisioned host stages, serves and confines under the same root the running daemon expects. These
# are DEFAULTS; --staging / --www override them, and the receiver reads the same env at run time.
STATE_DIR="${DEVLAB_STATE_DIR:-/var/lib/devlab}"
STAGING_ROOT="${DEVLAB_STAGING:-$STATE_DIR/staging}"
WWW_DIR="${DEVLAB_STATIC_DIR:-$STATE_DIR/www}"
# The edge the receiver reloads. conf.d holds the per-service routes the receiver drops in; the main
# Caddyfile is a site block that imports them from INSIDE it (each route is a naked handle, valid only
# inside a site block — see setup_edge_caddyfile_text). Instance-neutral defaults; the receiver reads
# the same env at run time.
CADDY_CONF="${DEVLAB_CADDY_CONF:-/etc/caddy/conf.d}"
CADDY_MAIN="${DEVLAB_CADDY_MAIN:-/etc/caddy/Caddyfile}"
CADDY_BIN="${DEVLAB_CADDY_BIN:-caddy}"
# WHERE THIS ENVIRONMENT'S EDGE ANSWERS — stated in exactly ONE runtime-config file, read by BOTH the
# edge shell built here AND the routing layer (a production-side sxgate) that forwards this
# environment's hostnames to it. This is the same path the sourced library resolves through
# setup_edge_address (SETUP_EDGE_ADDRESS_FILE); it is kept in step with that default here so the flag
# help and the reader name one file. The ADDRESS is an instance value and lives ONLY in this file —
# --edge-address writes it, never the repository. Overridable ONLY as the direct-invocation test seam.
EDGE_ADDRESS_FILE="${DEVLAB_EDGE_ADDRESS_FILE:-/etc/holistic/edge-address}"

# ── overlay (WireGuard) transport ────────────────────────────────────────────────────────────────────
# The private transport the chain reaches production over is the FIRST stage of a production target, not
# an accessory: DEVLAB_RUNS_PROD_TARGET names a host that only EXISTS once this overlay carries. These
# are the tools and the store; the addresses, port and peer key are NEVER baked in — they arrive as
# arguments (Keine Instanz-Spezifika). WG_DIR/WG_BIN/WGQUICK_BIN/PING_BIN are overridable ONLY as direct
# test seams, mirroring CADDY_BIN, never as instance values in the repo.
WG_DIR="${DEVLAB_WG_DIR:-/etc/wireguard}"
WG_BIN="${DEVLAB_WG_BIN:-wg}"
WGQUICK_BIN="${DEVLAB_WGQUICK_BIN:-wg-quick}"
PING_BIN="${DEVLAB_PING_BIN:-ping}"
OVERLAY_IFACE="${DEVLAB_OVERLAY_IFACE:-wg0}"   # generic default name, not an instance value
OVERLAY_PING_COUNT="${DEVLAB_OVERLAY_PING_COUNT:-3}"

# ── the dead-twin sweep (Part 2) ─────────────────────────────────────────────────────────────────────
# The ONE source of the production target is the runtime environment the daemon actually reads
# (DEVLAB_RUNS_PROD_TARGET / _RECV / _KEY, delivered as the devlabd systemd drop-in). A file that LOOKS
# like the target but steers nothing is worse than absent — someone edits it and changes nothing. This
# is the known dead twin; --provision removes it and never writes it. Overridable ONLY as a test seam.
PROD_TARGET_DEAD_FILE="${DEVLAB_PROD_TARGET_FILE:-/etc/devlab/prod-target}"

log()  { echo "devlab-install-recv: $*" >&2; }
# die rolls back what THIS run changed before it exits — a fail-closed abort leaves nothing half-done,
# whether the failure came from a bare command (the ERR trap) or from an explicit die. rollback clears
# its own list, so the two paths never double-restore.
die()  { log "$*"; rollback; exit 1; }
sha()  { sha256sum -- "$1" | cut -d' ' -f1; }

# ── arguments ──────────────────────────────────────────────────────────────────────────────────────
# --provision turns on the bare-server bring-up; the rest configure it. Everything that is NOT a flag
# is a service name (today's positional contract), collected in SERVICES and passed on unchanged.
PROVISION=0
PRINT_EDGE_ADDRESS=0  # query mode: print the ONE declared edge address (what the routing layer reads) and exit
DEPLOY_PUBKEY=""      # PUBLIC deploy key: a path, '-' for stdin, or the literal key line
EDGE_ADDRESS=""       # where this environment's edge answers (Caddy site addr / forward target, host:port|:port)
EDGE_BUILT=0          # set to 1 when ensure_caddy built/holds OUR shell (so its site label IS $EDGE_ADDRESS)
RECV_USER="root"      # the account whose authorized_keys carries the forced command (the deploy login)
USE_PKG=1             # ask the package manager for a missing OS prerequisite (idempotent, fail-closed)
# Overlay transport (same entry point — Keine ähnlichen Geschwister; there is no second script for it).
# --overlay-here brings THIS host's side up WITHOUT the receiver (the home side is not a delivery
# target); under --provision the overlay is set up alongside the receiver. Every value below is an
# instance value and arrives as an argument — none is baked into the repository (Part 1.5).
OVERLAY_HERE=0
OVERLAY_ADDRESS=""       # this host's overlay CIDR (e.g. 10.10.0.1/24) — required to set the overlay up
OVERLAY_LISTEN_PORT=""   # this host's WireGuard listen port (the side others dial; the roaming side omits)
OVERLAY_PEER_PUBKEY=""   # the OTHER side's PUBLIC key (path|-|literal) — the private half never travels
OVERLAY_PEER_ALLOWED=""  # the peer's overlay address (e.g. 10.10.0.2/32)
OVERLAY_PEER_ENDPOINT="" # how THIS host dials the peer (host:port); the roaming→listener side sets it
OVERLAY_ENDPOINT=""      # how the peer dials THIS host (host:port) — only to print the peer's one-liner
OVERLAY_KEEPALIVE=""     # PersistentKeepalive seconds (the side behind NAT holds the tunnel open)
OVERLAY_VERIFY_PEER=""   # overlay IP to prove reachability against; when set, the proof is fail-closed
declare -a SERVICES=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --provision)      PROVISION=1; shift ;;
    --print-edge-address) PRINT_EDGE_ADDRESS=1; shift ;;
    --edge-address)   EDGE_ADDRESS="${2:-}"; shift 2 ;;
    --edge-address=*) EDGE_ADDRESS="${1#*=}"; shift ;;
    --deploy-pubkey)  DEPLOY_PUBKEY="${2:-}"; shift 2 ;;
    --deploy-pubkey=*) DEPLOY_PUBKEY="${1#*=}"; shift ;;
    --recv-user)      RECV_USER="${2:-}"; shift 2 ;;
    --recv-user=*)    RECV_USER="${1#*=}"; shift ;;
    --staging)        STAGING_ROOT="${2:-}"; shift 2 ;;
    --staging=*)      STAGING_ROOT="${1#*=}"; shift ;;
    --www)            WWW_DIR="${2:-}"; shift 2 ;;
    --www=*)          WWW_DIR="${1#*=}"; shift ;;
    --caddyfile)      CADDY_MAIN="${2:-}"; shift 2 ;;
    --caddyfile=*)    CADDY_MAIN="${1#*=}"; shift ;;
    --no-pkg)         USE_PKG=0; shift ;;
    --overlay-here)          OVERLAY_HERE=1; shift ;;
    --overlay-iface)         OVERLAY_IFACE="${2:-}"; shift 2 ;;
    --overlay-iface=*)       OVERLAY_IFACE="${1#*=}"; shift ;;
    --overlay-address)       OVERLAY_ADDRESS="${2:-}"; shift 2 ;;
    --overlay-address=*)     OVERLAY_ADDRESS="${1#*=}"; shift ;;
    --overlay-listen-port)   OVERLAY_LISTEN_PORT="${2:-}"; shift 2 ;;
    --overlay-listen-port=*) OVERLAY_LISTEN_PORT="${1#*=}"; shift ;;
    --overlay-peer-pubkey)   OVERLAY_PEER_PUBKEY="${2:-}"; shift 2 ;;
    --overlay-peer-pubkey=*) OVERLAY_PEER_PUBKEY="${1#*=}"; shift ;;
    --overlay-peer-allowed)  OVERLAY_PEER_ALLOWED="${2:-}"; shift 2 ;;
    --overlay-peer-allowed=*) OVERLAY_PEER_ALLOWED="${1#*=}"; shift ;;
    --overlay-peer-endpoint) OVERLAY_PEER_ENDPOINT="${2:-}"; shift 2 ;;
    --overlay-peer-endpoint=*) OVERLAY_PEER_ENDPOINT="${1#*=}"; shift ;;
    --overlay-endpoint)      OVERLAY_ENDPOINT="${2:-}"; shift 2 ;;
    --overlay-endpoint=*)    OVERLAY_ENDPOINT="${1#*=}"; shift ;;
    --overlay-keepalive)     OVERLAY_KEEPALIVE="${2:-}"; shift 2 ;;
    --overlay-keepalive=*)   OVERLAY_KEEPALIVE="${1#*=}"; shift ;;
    --overlay-verify-peer)   OVERLAY_VERIFY_PEER="${2:-}"; shift 2 ;;
    --overlay-verify-peer=*) OVERLAY_VERIFY_PEER="${1#*=}"; shift ;;
    --) shift; while [ "$#" -gt 0 ]; do SERVICES+=("$1"); shift; done ;;
    -*) die "unknown option '$1' (see the header for usage)" ;;
    *)  SERVICES+=("$1"); shift ;;
  esac
done
set -- "${SERVICES[@]+"${SERVICES[@]}"}"

# ── query: ask the ONE declaration where this environment answers ─────────────────────────────────────
# This is the SAME read the routing layer (a production-side sxgate) performs to learn where to forward.
# It is a pure read — no root, no host changes — and it uses setup_edge_address, the single reader, so
# the answer is byte-for-byte what the edge is built on. Absence is NAMED, never a guessed default.
if [ "$PRINT_EDGE_ADDRESS" = 1 ]; then
  # shellcheck source=/dev/null
  . "$SRC_DIR/$LIB" 2>/dev/null || die "could not source $SRC_DIR/$LIB — cannot read the edge-address declaration"
  if addr="$(setup_edge_address "$EDGE_ADDRESS_FILE")"; then
    printf '%s\n' "$addr"; exit 0
  fi
  echo "devlab-install-recv: this environment's edge address is not declared at $EDGE_ADDRESS_FILE — provision with --edge-address <host:port> (or seed that ONE file). The generated edge and the routing layer both read this declaration." >&2
  exit 1
fi

# Backups made THIS run, newest first, so the rollback restores them in the reverse of install order.
# Each entry is a TAB-separated triple "target<TAB>backup<TAB>abs": target is the file to restore
# (relative sbin name or an absolute path), backup is the timestamped copy or empty (file did not exist
# before this run), abs is 1 when target is already an absolute path. TAB cannot appear in our paths.
declare -a BACKUPS=()
TAB="$(printf '\t')"
push_backup() { BACKUPS=("$1${TAB}$2${TAB}$3" "${BACKUPS[@]}"); }
rollback() {
  [ "${#BACKUPS[@]}" -eq 0 ] && return 0
  log "a step failed — rolling back the files this run replaced"
  local entry target bak abs path
  for entry in "${BACKUPS[@]}"; do
    target="${entry%%${TAB}*}"; entry="${entry#*${TAB}}"
    bak="${entry%%${TAB}*}";    abs="${entry#*${TAB}}"
    if [ "$abs" = 1 ]; then path="$target"; else path="$SBIN/$target"; fi
    if [ -n "$bak" ] && [ -e "$bak" ]; then
      cp -a -- "$bak" "$path" && log "restored $path from $bak"
    else
      rm -f -- "$path" && log "removed $path (it did not exist before this run)"
    fi
  done
  BACKUPS=()   # cleared so a following die/ERR cannot restore the same files twice
}
trap 'rollback' ERR

# Root is required to write $SBIN, root's authorized_keys, the edge config, and to install/start a
# systemd service. DEVLAB_RECV_TEST is a DIRECT-INVOCATION test seam (never set in operation): it lets
# the install/backup/rollback and provisioning logic be proven against fixture directories without
# root, mirroring the receiver's own --check seam.
if [ "${DEVLAB_RECV_TEST:-0}" != 1 ]; then
  [ "$(id -u)" = 0 ] || die "must run as root (it writes $SBIN, the deploy login's authorized_keys, the edge config, and installs a systemd service)"
fi
[ -d "$SBIN" ] || die "target directory $SBIN does not exist"

# The source bytes must be present and the receiver must at least PARSE before it can be trusted as a
# root command — a syntactically broken receiver installed to sbin would break every future deploy.
for f in "$RECV" "$LIB"; do
  [ -r "$SRC_DIR/$f" ] || die "source $SRC_DIR/$f not found or unreadable — run this from a checkout's deploy/ directory"
done
bash -n -- "$SRC_DIR/$RECV" || die "$SRC_DIR/$RECV does not parse — refusing to install a broken receiver"
bash -n -- "$SRC_DIR/$LIB"  || die "$SRC_DIR/$LIB does not parse — refusing to install a broken library"

# The edge shell the receiver's routes must live in is authored by ONE template, shared with the route
# it must contain (setup_route_text / setup_edge_caddyfile_text in the library beside us). We source the
# library so --provision builds the edge from that one source rather than a second, hand-written shape.
# shellcheck source=/dev/null
. "$SRC_DIR/$LIB" || die "could not source $SRC_DIR/$LIB — the edge shell and route templates are unavailable"
# A port used only to PROVE the edge accepts a route (a probe route is dropped in, the edge is validated
# with it, and it is removed). It is never served; any valid port number does.
CADDY_PROBE_PORT="${DEVLAB_CADDY_PROBE_PORT:-65535}"

# backup_file <abs> — record a timestamped backup of an arbitrary file we are about to change (or note
# its absence), so the rollback can restore the host exactly. Idempotent callers back up once.
backup_file() {
  local abs="$1" bak=""
  if [ -e "$abs" ]; then
    bak="$abs.bak-$(date +%Y%m%d-%H%M%S)"
    cp -a -- "$abs" "$bak" || die "could not back up $abs before changing it"
    log "backed up $abs to $bak"
  fi
  push_backup "$abs" "$bak" 1
}

# install_one <name> <mode> — install SRC_DIR/<name> to SBIN/<name> with the given mode, root-owned.
# An identical installed copy is left untouched (idempotent). A differing or missing copy is backed
# up (when it exists) and replaced; the replacement is verified byte-for-byte before we move on.
install_one() {
  local name="$1" mode="$2" src="$SRC_DIR/$1" dst="$SBIN/$1"
  if [ -f "$dst" ] && cmp -s -- "$src" "$dst"; then
    log "$name already current at $dst (sha256 $(sha "$dst")) — left untouched"
    return 0
  fi
  local bak=""
  if [ -e "$dst" ]; then
    bak="$dst.bak-$(date +%Y%m%d-%H%M%S)"
    cp -a -- "$dst" "$bak" || die "could not back up $dst before replacing it"
    log "backed up the existing $name to $bak"
  fi
  push_backup "$name" "$bak" 0
  # Ownership is root:root in operation; the test seam (non-root fixture) cannot chown, so it omits it.
  local own=(-o root -g root); [ "${DEVLAB_RECV_TEST:-0}" = 1 ] && own=()
  install "${own[@]}" -m "$mode" -- "$src" "$dst"
  cmp -s -- "$src" "$dst" || die "installed $dst does not match the source — rolled back"
  log "installed $name -> $dst (mode $mode, sha256 $(sha "$dst"))"
}

# ── provisioning helpers (only reached under --provision) ────────────────────────────────────────────

# rrsync_path — echo an executable rrsync the receiver would find (its own search list), or empty. The
# receiver searches: rrsync (PATH), /usr/bin/rrsync, /usr/share/rsync/scripts/rrsync, /usr/lib/rsync/rrsync.
rrsync_path() {
  local c p
  for c in rrsync /usr/bin/rrsync /usr/share/rsync/scripts/rrsync /usr/lib/rsync/rrsync; do
    p="$(command -v "$c" 2>/dev/null || true)"; [ -z "$p" ] && [ -x "$c" ] && p="$c"
    [ -n "$p" ] && { echo "$p"; return 0; }
  done
  return 1
}

# pkg_install <package> — ask the system package manager for a MISSING OS prerequisite. This is host
# bring-up, not the deploy doctrine (which never builds/fetches a SERVICE): only the two named packages
# (rsync, caddy) ever pass through here, only when absent, and --no-pkg forbids it entirely. Fail-closed.
pkg_install() {
  local pkg="$1"
  [ "$USE_PKG" = 1 ] || die "'$pkg' is required but missing and --no-pkg was given — install it and re-run"
  if command -v apt-get >/dev/null 2>&1; then
    log "installing OS prerequisite '$pkg' via apt-get"
    DEBIAN_FRONTEND=noninteractive apt-get update -y >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y "$pkg" >&2 \
      || die "package manager could not install '$pkg' — provide it and re-run (fail-closed, nothing half-done)"
  else
    die "'$pkg' is required but missing and no supported package manager (apt-get) was found — install '$pkg' and re-run"
  fi
}

# ensure_rrsync — the transport confinement the receiver depends on (it exits 5 without it). If rsync's
# rrsync is present only as a gzipped script (older Debian shipped /usr/share/rsync/scripts/rrsync.gz),
# materialize an executable copy where the receiver looks; otherwise ensure the rsync package.
ensure_rrsync() {
  if rrsync_path >/dev/null; then log "rrsync present at $(rrsync_path)"; return 0; fi
  local gz="/usr/share/rsync/scripts/rrsync.gz"
  if [ -f "$gz" ]; then
    log "materializing rrsync from $gz -> /usr/local/bin/rrsync"
    zcat -- "$gz" > /usr/local/bin/rrsync && chmod 0755 /usr/local/bin/rrsync
    rrsync_path >/dev/null && return 0
  fi
  command -v rsync >/dev/null 2>&1 || pkg_install rsync
  if ! rrsync_path >/dev/null && [ -f "$gz" ]; then
    zcat -- "$gz" > /usr/local/bin/rrsync && chmod 0755 /usr/local/bin/rrsync
  fi
  rrsync_path >/dev/null || die "rsync is installed but no rrsync helper was found — the receiver cannot confine an rsync receive without it"
  log "rrsync ready at $(rrsync_path)"
}

# ensure_roots — the two host paths the receiver stages into and serves from. Pure filesystem, no
# fetch; created only when absent (idempotent), root-owned.
ensure_roots() {
  local own=(-o root -g root); [ "${DEVLAB_RECV_TEST:-0}" = 1 ] && own=()
  install -d "${own[@]}" -m 0755 "$STAGING_ROOT" && log "staging root ready: $STAGING_ROOT"
  install -d "${own[@]}" -m 0755 "$WWW_DIR"      && log "web root ready:     $WWW_DIR"
}

# caddy_validates_with_probe — PROVE the edge accepts a route, not merely that it parses empty (an empty
# edge validates even when its shape cannot hold a single delivered route — the exact defect this fixes).
# A probe route (the very shape setup_route_text emits) is dropped into the route directory, the ASSEMBLED
# edge is validated with it present, and the probe is ALWAYS removed. Returns caddy's verdict. Requires
# the real caddy; callers gate it behind the test seam. If a probe cannot be written, that is itself a
# failure (return 2), never a silent pass.
caddy_validates_with_probe() {
  local probe="$CADDY_CONF/zz-devlab-provision-probe.caddy"
  setup_route_text "devlabprovisionprobe" "$CADDY_PROBE_PORT" > "$probe" 2>/dev/null \
    || { rm -f -- "$probe"; return 2; }
  local rc=0
  "$CADDY_BIN" validate --config "$CADDY_MAIN" >/dev/null 2>&1 || rc=1
  rm -f -- "$probe"
  return "$rc"
}

# edge_imports_holistic_routes <file> — true when the edge already pulls in our route directory (the
# grown holistic edge, e.g. the home host, does this inside its site block). Matched loosely so a grown
# file that imports the same directory under a slightly different spelling still counts.
edge_imports_holistic_routes() {
  grep -Eq "^[[:space:]]*import[[:space:]]+.*${CADDY_CONF//\//\\/}/\*\.caddy" -- "$1" 2>/dev/null
}

# ensure_edge_address — establish the ONE declaration of where this environment's edge answers, and set
# $EDGE_ADDRESS to it, BEFORE the edge is built from it. This closes the single-source-of-truth gap: the
# edge shell and the routing layer (a production-side sxgate) both read this ONE file, so they can never
# name different addresses. It NEVER guesses: if --edge-address is given it is validated and written to
# the file (backed up first, so a rollback restores the host; idempotent when the file already holds it);
# otherwise an already-present declaration is used as is; if neither exists the run stops with a NAMED
# deficiency (Kein stummes Ausbleiben) — a guessed default is exactly the bug this fixes. The address is
# an instance value and lives ONLY in this runtime-config file, never in the repository.
ensure_edge_address() {
  local want="$EDGE_ADDRESS" have=""
  have="$(setup_edge_address "$EDGE_ADDRESS_FILE" 2>/dev/null || true)"
  if [ -n "$want" ]; then
    setup_valid_edge_address "$want" \
      || die "--edge-address '$want' is not a valid edge address — give a Caddy site address / forward target like ':8080' or '10.10.0.1:8080'"
    if [ "$want" = "$have" ]; then
      EDGE_ADDRESS="$have"
      log "edge address already declared as '$EDGE_ADDRESS' in $EDGE_ADDRESS_FILE — left untouched (the edge and the routing layer both read this ONE declaration)"
      return 0
    fi
    local own=(-o root -g root); [ "${DEVLAB_RECV_TEST:-0}" = 1 ] && own=()
    install -d "${own[@]}" -m 0755 "$(dirname -- "$EDGE_ADDRESS_FILE")"
    backup_file "$EDGE_ADDRESS_FILE"   # notes absence too, so rollback removes a file we create
    printf '# Managed by devlab-install-recv — the ONE declaration of where this environment'\''s edge\n# answers. Read by the generated Caddy edge AND by the routing layer (sxgate). Instance value;\n# never copy it into a repository.\n%s\n' "$want" > "$EDGE_ADDRESS_FILE"
    [ "${DEVLAB_RECV_TEST:-0}" != 1 ] && chmod 0644 "$EDGE_ADDRESS_FILE"
    EDGE_ADDRESS="$want"
    log "declared this environment's edge address as '$EDGE_ADDRESS' in $EDGE_ADDRESS_FILE (the edge and the routing layer both read this ONE declaration)"
  elif [ -n "$have" ]; then
    EDGE_ADDRESS="$have"
    log "using the edge address already declared as '$EDGE_ADDRESS' in $EDGE_ADDRESS_FILE"
  else
    die "this environment's edge address is not declared — pass --edge-address <host:port> (e.g. --edge-address 10.10.0.1:8080) so the edge and the routing layer read the SAME address from $EDGE_ADDRESS_FILE; it is never guessed"
  fi
}

# ensure_caddy — the edge, built in THE shape the delivered routes require. Caddy must be installed and
# its route directory must exist; the main Caddyfile must be a SITE BLOCK that imports that directory
# from INSIDE it (setup_edge_caddyfile_text — the one source, shared with the route it contains), not a
# bare top-level import beside some other site block. What it does with a pre-existing Caddyfile depends
# on what that file IS (test c — a grown edge is named and kept, not destroyed):
#   * our own shell already in place            → left untouched (idempotent).
#   * Ubuntu's shipped example (root * /usr/share/caddy), with or without our old top-level import
#     appended — the very state that fails today → REPLACED; Ubuntu's example is not the holistic edge.
#   * our own OLDER output (carries our marker)  → REPLACED (self-heal a shell we wrote before this fix).
#   * a grown holistic edge that imports our routes → kept if it validates WITH a route; a grown edge
#     that does NOT is NAMED and refused, never silently overwritten (the home host must stay unchanged).
#   * any other foreign Caddyfile               → NAMED and refused (never destroyed).
# Every replacement backs the old file up first; the assembled edge is proven to validate WITH a route
# before the running edge is touched, so a bad shape never reaches the live edge (fail-closed).
ensure_caddy() {
  command -v "$CADDY_BIN" >/dev/null 2>&1 || pkg_install caddy
  local own=(-o root -g root); [ "${DEVLAB_RECV_TEST:-0}" = 1 ] && own=()
  install -d "${own[@]}" -m 0755 "$CADDY_CONF" && log "edge route dir ready: $CADDY_CONF"

  local desired
  desired="$(setup_edge_caddyfile_text "$CADDY_CONF" "$WWW_DIR" "$EDGE_ADDRESS")" \
    || die "cannot build the edge: no declared edge address (ensure_edge_address must run first) — the edge address is read from $EDGE_ADDRESS_FILE, never guessed"
  local seam=0; [ "${DEVLAB_RECV_TEST:-0}" = 1 ] && seam=1

  write_edge() {  # back up (backup_file notes absence too, so rollback removes what we create), then write
    backup_file "$CADDY_MAIN"
    install -d "${own[@]}" -m 0755 "$(dirname -- "$CADDY_MAIN")"
    printf '%s\n' "$desired" > "$CADDY_MAIN"
    EDGE_BUILT=1   # our shell, so its site label is the declared $EDGE_ADDRESS (proven in the self-check)
  }

  if [ ! -f "$CADDY_MAIN" ]; then
    write_edge
    log "created the holistic edge shell at $CADDY_MAIN (a site block on $EDGE_ADDRESS importing $CADDY_CONF)"
  elif [ "$(cat -- "$CADDY_MAIN")" = "$desired" ]; then
    EDGE_BUILT=1   # already OUR shell on the declared address (idempotent re-run)
    log "the holistic edge shell is already in place at $CADDY_MAIN — left untouched"
  elif grep -Fq -- "/usr/share/caddy" "$CADDY_MAIN"; then
    write_edge
    log "replaced Ubuntu's shipped example Caddyfile at $CADDY_MAIN with the holistic edge shell (the example is not the holistic edge; the delivered routes could not live beside it)"
  elif grep -Fq -- "devlab-install-recv" "$CADDY_MAIN"; then
    write_edge
    log "replaced an older devlab-install-recv edge at $CADDY_MAIN with the current holistic edge shell (self-heal)"
  elif edge_imports_holistic_routes "$CADDY_MAIN"; then
    if [ "$seam" = 1 ] || caddy_validates_with_probe; then
      log "found a grown edge at $CADDY_MAIN that already imports $CADDY_CONF and holds a delivered route — left untouched (a grown, working edge is not overwritten)"
    else
      die "found a grown edge at $CADDY_MAIN that imports $CADDY_CONF but does NOT validate with a delivered route — refusing to overwrite a hand-grown edge; reconcile it so the route import lives inside a single site block, then re-run"
    fi
  else
    die "found an existing Caddyfile at $CADDY_MAIN that is neither Ubuntu's example nor a holistic edge and does not import $CADDY_CONF — refusing to overwrite a foreign edge; move it aside (or make it import $CADDY_CONF from inside a site block) and re-run"
  fi

  # PROVE the assembled edge validates WITH a route before the running edge is touched (a leaf that only
  # validates empty is exactly the defect this fixes), then bring the edge up. Skipped in the test seam,
  # which has no caddy; the seam checks the written shape textually in the self-check below.
  if [ "$seam" != 1 ]; then
    caddy_validates_with_probe \
      || die "the edge configuration does not validate WITH a delivered route ($CADDY_MAIN) — rolled back so the edge keeps its last good config; a route dropped into $CADDY_CONF could not take effect"
    if command -v systemctl >/dev/null 2>&1; then
      systemctl enable caddy >/dev/null 2>&1 || true
      if systemctl is-active --quiet caddy; then
        systemctl reload caddy || die "caddy reload failed after building the edge"
        log "caddy reloaded with the holistic edge shell"
      else
        systemctl start caddy || die "caddy could not be started after building the edge"
        log "caddy started"
      fi
    fi
  fi
}

# read_pubkey — resolve the PUBLIC deploy key from a path, stdin ('-'), or a literal argument. It
# REFUSES anything that looks like a private key (Geheimnisse entstehen nicht auf dem Ziel) and anything
# that is not a single ssh public-key line.
read_pubkey() {
  [ -n "$DEPLOY_PUBKEY" ] || die "--provision needs --deploy-pubkey (the PUBLIC half of the deploy key: a path, '-', or the literal key)"
  local key=""
  if [ "$DEPLOY_PUBKEY" = "-" ]; then
    key="$(cat)"
  elif [ -f "$DEPLOY_PUBKEY" ]; then
    key="$(cat -- "$DEPLOY_PUBKEY")"
  else
    key="$DEPLOY_PUBKEY"
  fi
  key="$(printf '%s' "$key" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$key" in
    *"PRIVATE KEY"*) die "the value given to --deploy-pubkey looks like a PRIVATE key — pass ONLY the public half; a private key is never written to the target" ;;
  esac
  [ "$(printf '%s\n' "$key" | grep -c .)" = 1 ] || die "--deploy-pubkey must be exactly one public-key line"
  case "$key" in
    ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-*\ *|sk-ssh-ed25519@openssh.com\ *|sk-ecdsa-sha2-*\ *) : ;;
    *) die "--deploy-pubkey does not look like an ssh public key (want 'ssh-ed25519 …', 'ssh-rsa …', or 'ecdsa-sha2-… …')" ;;
  esac
  printf '%s' "$key"
}

# authorized_keys_path — where the receiver user's authorized_keys lives. Derived from the account's
# home in operation; DEVLAB_RECV_AK overrides it only under the direct-invocation test seam.
authorized_keys_path() {
  if [ "${DEVLAB_RECV_TEST:-0}" = 1 ] && [ -n "${DEVLAB_RECV_AK:-}" ]; then
    echo "$DEVLAB_RECV_AK"; return 0
  fi
  local home
  home="$(getent passwd "$RECV_USER" 2>/dev/null | cut -d: -f6)"
  [ -n "$home" ] || die "receiver user '$RECV_USER' has no home directory (does the account exist?)"
  echo "$home/.ssh/authorized_keys"
}

# install_forced_command — write the locked-down deploy-key line into the receiver user's
# authorized_keys: command="<recv>",restrict <pubkey>. `restrict` strips agent/port/pty/X11/user-rc
# forwarding and `command=` pins EVERY login to the receiver, so the key can do nothing but rsync into
# staging and trigger an install. Idempotent: an identical line already present is left as is; a line
# for the SAME key with a different/absent forced command is replaced (the file is backed up first).
install_forced_command() {
  local pubkey="$1"
  local keytype keydata
  keytype="$(printf '%s' "$pubkey" | awk '{print $1}')"
  keydata="$(printf '%s' "$pubkey" | awk '{print $2}')"
  local forced="command=\"$SBIN/$RECV\",restrict $keytype $keydata devlab-prod-deploy"

  # Where the receiver user's authorized_keys lives (default root → /root/.ssh/authorized_keys).
  # DEVLAB_RECV_AK is a DIRECT-INVOCATION test seam (points authorized_keys at a fixture file), honoured
  # only under the test seam; in operation the location is always derived from the account's home.
  local ak dir
  ak="$(authorized_keys_path)"
  dir="$(dirname -- "$ak")"
  local own=(-o "$RECV_USER" -g "$RECV_USER"); [ "${DEVLAB_RECV_TEST:-0}" = 1 ] && own=()
  install -d "${own[@]}" -m 0700 "$dir"

  if [ -f "$ak" ] && grep -Fq -- "$keydata" "$ak"; then
    # The line carrying this key already carries our forced command → nothing to do (idempotent).
    if grep -F -- "$keydata" "$ak" | grep -Fq -- "command=\"$SBIN/$RECV\""; then
      log "deploy key already carries the forced command in $ak — left untouched"
      return 0
    fi
    # Same key present but NOT behind the forced command — replace only its line(s), back up first.
    backup_file "$ak"
    grep -Fv -- "$keydata" "$ak" > "$ak.tmp.$$" || true
    printf '%s\n' "$forced" >> "$ak.tmp.$$"
    install "${own[@]}" -m 0600 "$ak.tmp.$$" "$ak"; rm -f "$ak.tmp.$$"
    log "re-pinned the deploy key behind the forced command in $ak"
    return 0
  fi

  if [ -e "$ak" ]; then backup_file "$ak"; else push_backup "$ak" "" 1; fi
  printf '%s\n' "$forced" >> "$ak"
  chmod 0600 "$ak"; [ "${DEVLAB_RECV_TEST:-0}" != 1 ] && chown "$RECV_USER":"$RECV_USER" "$ak"
  log "installed the deploy-key forced command in $ak"
}

# ── dead-twin sweep (Part 2) ─────────────────────────────────────────────────────────────────────────
# Remove the one file that impersonates the production target without steering anything. Reversible (the
# removed file is backed up so the run can be undone), idempotent (absence is a clean no-op), and NEVER
# recreated by this script. Under the test seam the sweep only runs when a fixture path is named, so a
# developer's real /etc is never touched by the effect-free logic tests.
sweep_dead_prod_target() {
  if [ "${DEVLAB_RECV_TEST:-0}" = 1 ] && [ -z "${DEVLAB_PROD_TARGET_FILE:-}" ]; then
    return 0
  fi
  if [ -e "$PROD_TARGET_DEAD_FILE" ]; then
    backup_file "$PROD_TARGET_DEAD_FILE"
    rm -f -- "$PROD_TARGET_DEAD_FILE"
    log "removed the dead production-target twin $PROD_TARGET_DEAD_FILE — no code reads it; the ONE source is the runtime environment (DEVLAB_RUNS_PROD_TARGET / _RECV / _KEY)"
  else
    log "no dead production-target twin at $PROD_TARGET_DEAD_FILE — the ONE source is the runtime environment (DEVLAB_RUNS_PROD_TARGET / _RECV / _KEY)"
  fi
}

# ── overlay (WireGuard) transport helpers (Part 1) ────────────────────────────────────────────────────
# resolve_key_arg <path|-|literal> — echo a single trimmed public-key line, REFUSING a private key. A
# private overlay key is never handed to this script — it stays on the host that generated it (Part 1.2).
resolve_key_arg() {
  local v="$1" key=""
  if [ "$v" = "-" ]; then key="$(cat)"
  elif [ -f "$v" ]; then key="$(cat -- "$v")"
  else key="$v"; fi
  key="$(printf '%s' "$key" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$key" in *"PRIVATE KEY"*) die "a value that must be a PUBLIC key looks like a PRIVATE key — a private overlay key is never passed to or written by this script (Geheimnisse entstehen auf der Seite, die sie behält)" ;; esac
  [ "$(printf '%s\n' "$key" | grep -c .)" = 1 ] || die "the overlay peer public key must be exactly one line"
  printf '%s' "$key"
}

# A WireGuard public key is 32 bytes as base64: 44 characters ending in '='.
valid_wg_pubkey() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9+/]{43}=$'; }

overlay_key_path()  { echo "$WG_DIR/${OVERLAY_IFACE}.key"; }
overlay_conf_path() { echo "$WG_DIR/${OVERLAY_IFACE}.conf"; }

# ensure_wg_tools — WireGuard is host bring-up (like rsync/caddy), not a service build: install the one
# named package only when absent, fail-closed, and never with --no-pkg.
ensure_wg_tools() {
  if command -v "$WG_BIN" >/dev/null 2>&1 && command -v "$WGQUICK_BIN" >/dev/null 2>&1; then return 0; fi
  pkg_install wireguard-tools
  command -v "$WG_BIN" >/dev/null 2>&1 && command -v "$WGQUICK_BIN" >/dev/null 2>&1 \
    || die "wireguard-tools is installed but '$WG_BIN'/'$WGQUICK_BIN' are not on PATH — the overlay cannot be brought up"
}

overlay_iface_up() { "$WG_BIN" show "$OVERLAY_IFACE" >/dev/null 2>&1; }

# overlay_conf_render <keyfile> <peerpubkey> — the desired wg-quick config for THIS host's side. The
# private key is inlined as wg-quick expects; the file is 0600 and its bytes are never logged.
overlay_conf_render() {
  local kf="$1" peerpub="$2"
  printf '# generated by devlab-install-recv — this host'\''s side of the production overlay\n'
  printf '[Interface]\n'
  printf 'Address = %s\n' "$OVERLAY_ADDRESS"
  [ -n "$OVERLAY_LISTEN_PORT" ] && printf 'ListenPort = %s\n' "$OVERLAY_LISTEN_PORT"
  printf 'PrivateKey = %s\n' "$(cat -- "$kf")"
  printf '\n[Peer]\n'
  printf 'PublicKey = %s\n' "$peerpub"
  printf 'AllowedIPs = %s\n' "$OVERLAY_PEER_ALLOWED"
  [ -n "$OVERLAY_PEER_ENDPOINT" ] && printf 'Endpoint = %s\n' "$OVERLAY_PEER_ENDPOINT"
  [ -n "$OVERLAY_KEEPALIVE" ]     && printf 'PersistentKeepalive = %s\n' "$OVERLAY_KEEPALIVE"
  return 0
}

# overlay_setup_this_side — bring up THIS host's side of the overlay from arguments. Generates this
# host's keypair once (private stays here — Part 1.2), writes the config, and brings the interface up
# idempotently: an already-up interface carrying the intended config is REPORTED, not torn down (Part
# 1.6); a changed config is applied with `syncconf`, which never drops the link. Sets OVERLAY_OURPUB.
overlay_setup_this_side() {
  [ -n "$OVERLAY_ADDRESS" ]      || die "the overlay needs --overlay-address (this host's overlay CIDR, e.g. 10.10.0.1/24) — no instance address is baked in"
  [ -n "$OVERLAY_PEER_PUBKEY" ]  || die "the overlay needs --overlay-peer-pubkey (the OTHER side's PUBLIC key; the private half never leaves its own host)"
  [ -n "$OVERLAY_PEER_ALLOWED" ] || die "the overlay needs --overlay-peer-allowed (the peer's overlay address, e.g. 10.10.0.2/32)"
  ensure_wg_tools
  local peerpub; peerpub="$(resolve_key_arg "$OVERLAY_PEER_PUBKEY")"
  valid_wg_pubkey "$peerpub" || die "--overlay-peer-pubkey is not a WireGuard public key (expected 44 base64 characters ending in '=')"

  local own=(-o root -g root); [ "${DEVLAB_RECV_TEST:-0}" = 1 ] && own=()
  install -d "${own[@]}" -m 0700 "$WG_DIR"
  local kf cf; kf="$(overlay_key_path)"; cf="$(overlay_conf_path)"
  if [ ! -s "$kf" ]; then
    ( umask 077; "$WG_BIN" genkey > "$kf" ) || die "could not generate this host's overlay private key"
    chmod 0600 "$kf"
    log "generated this host's overlay private key at $kf (it never leaves this host)"
  else
    log "overlay private key already present at $kf — kept, not regenerated (Part 1.6)"
  fi
  OVERLAY_OURPUB="$("$WG_BIN" pubkey < "$kf")" || die "could not derive this host's overlay public key from $kf"

  local desired; desired="$(overlay_conf_render "$kf" "$peerpub")"
  if [ -f "$cf" ] && [ "$(cat -- "$cf")" = "$desired" ] && overlay_iface_up; then
    log "overlay $OVERLAY_IFACE already up with the intended config — a standing connection is reported, not interrupted (Part 1.6)"
    return 0
  fi
  if [ -f "$cf" ]; then backup_file "$cf"; else push_backup "$cf" "" 1; fi
  printf '%s\n' "$desired" > "$cf"; chmod 0600 "$cf"
  if overlay_iface_up; then
    log "overlay $OVERLAY_IFACE already up — applying the updated config in place (syncconf; the link is not dropped)"
    if [ "${DEVLAB_RECV_TEST:-0}" != 1 ]; then
      "$WG_BIN" syncconf "$OVERLAY_IFACE" <("$WGQUICK_BIN" strip "$OVERLAY_IFACE") \
        || die "could not sync the updated overlay config onto the running interface $OVERLAY_IFACE"
    fi
  else
    log "bringing the overlay interface $OVERLAY_IFACE up"
    "$WGQUICK_BIN" up "$OVERLAY_IFACE" || die "could not bring the overlay interface $OVERLAY_IFACE up"
  fi
}

# overlay_prove — prove the tunnel CARRIES with numbers (Part 1.4): the peer's latest handshake age and
# a ping's loss/round-trip. When --overlay-verify-peer is set the proof is FAIL-CLOSED (a peer that does
# not answer aborts with the real reason, no half-built path — test c). Returns the report on stdout.
overlay_prove() {
  local peerip="$1"
  local hs age rc pingout
  hs="$("$WG_BIN" show "$OVERLAY_IFACE" latest-handshakes 2>/dev/null | awk 'NR==1{print $NF}')"
  if [ -n "${hs:-}" ] && [ "$hs" != "0" ]; then
    if [ "${DEVLAB_RECV_TEST:-0}" = 1 ]; then age="(seam)"; else age="$(( $(date +%s) - hs ))s ago"; fi
    echo "handshake: last completed $age"
  else
    echo "handshake: none yet"
  fi
  set +e
  pingout="$("$PING_BIN" -c "$OVERLAY_PING_COUNT" -W 3 "$peerip" 2>&1)"; rc=$?
  set -e
  # The loss/rtt summary lines carry the numbers; print them, not the whole trace.
  printf '%s\n' "$pingout" | grep -E 'packet loss|min/avg|rtt|round-trip' || printf '%s\n' "$pingout" | tail -n 2
  return $rc
}
overlay_report_pubkey() { [ -n "${OVERLAY_OURPUB:-}" ] && echo "  this host's overlay public key: $OVERLAY_OURPUB"; }

# ── overlay-here: catch up THIS (home) side, no receiver (Part 1.3) ───────────────────────────────────
# The chain's home side must be caught up when the far side was reinstalled: its old public key is
# swapped for the new one and the tunnel is PROVEN. This is the SAME script, not a sibling (Part 1.1). It
# does NOT install the receiver — the home side is not a delivery target.
if [ "$OVERLAY_HERE" = 1 ]; then
  if [ "${DEVLAB_RECV_TEST:-0}" != 1 ]; then
    [ "$(id -u)" = 0 ] || die "--overlay-here must run as root (it writes $WG_DIR and configures the $OVERLAY_IFACE interface)"
  fi
  [ "$PROVISION" = 1 ] && die "--overlay-here catches up THIS host's overlay side only; do not combine it with --provision (the home side is not a delivery target)"
  log "── catching up this host's side of the production overlay ──"
  overlay_setup_this_side
  echo
  echo "devlab-install-recv — overlay (this side):"
  overlay_report_pubkey
  if [ -n "$OVERLAY_VERIFY_PEER" ]; then
    echo "  proving the tunnel to $OVERLAY_VERIFY_PEER carries:"
    if out="$(overlay_prove "$OVERLAY_VERIFY_PEER")"; then
      printf '%s\n' "$out" | sed 's/^/    /'
      echo "  the production overlay carries — the chain can reach $OVERLAY_VERIFY_PEER."
    else
      # This side is fully built; the PEER did not answer. Report the real reason and fail closed —
      # WITHOUT tearing this side's correct config back down (rollback here would undo a good local
      # side over an external condition). Not a die: the ERR-rollback must not fire.
      trap - ERR
      printf '%s\n' "$out" | sed 's/^/    /'
      echo "devlab-install-recv: the overlay peer $OVERLAY_VERIFY_PEER did not answer over $OVERLAY_IFACE — this host's side is up but the transport does NOT carry yet (see the numbers above). Bring the FAR side up, then re-run; nothing on this side is half-built." >&2
      exit 1
    fi
  else
    echo "  (no --overlay-verify-peer given — reachability was not proven)"
  fi
  exit 0
fi

# ── PROVISION (bare host → production target) ───────────────────────────────────────────────────────
# Runs BEFORE the receiver install so the receiver lands into an already-prepared host; everything here
# is idempotent and reversible, and the ERR trap above unwinds every file it touched on any failure.
if [ "$PROVISION" = 1 ]; then
  log "── provisioning this host as a production target ──"
  PUBKEY="$(read_pubkey)"
  ensure_rrsync
  ensure_roots
  ensure_edge_address
  ensure_caddy
  install_forced_command "$PUBKEY"
  sweep_dead_prod_target
  # The transport the chain reaches this host over is the FIRST stage of the target, set up in the SAME
  # run (Part 1.1). It is opt-in by naming the overlay address, so a host reached over an already-standing
  # transport is provisioned without touching it.
  if [ -n "$OVERLAY_ADDRESS" ]; then
    log "── setting up this host's side of the production overlay ──"
    overlay_setup_this_side
  fi
fi

# ── receiver install (REUSED by both modes) ─────────────────────────────────────────────────────────
# The library is installed FIRST because the receiver sources it; installing the receiver over a stale
# library would leave a moment where a deploy runs new receiver logic against old templates.
install_one "$LIB"  0644
install_one "$RECV" 0755

# Prove the receiver loads and makes the right first-time-vs-update decision WITHOUT effect, via its
# own --check dry-run. With a service name it also proves that service's artifact is staged and its
# delivered unit passes the identity checks — the exact gate the real trigger will apply.
check_ok=1
if [ "$#" -eq 0 ]; then
  DEVLAB_STAGING="${DEVLAB_STAGING:-$STAGING_ROOT}" \
    "$SBIN/$RECV" --check __selftest__ >/dev/null 2>&1 || true  # exit 3 (no such artifact) is expected
  log "receiver installed and parses; no service named, so nothing was triggered"
else
  for svc in "$@"; do
    log "── dry-run for '$svc' ──"
    if "$SBIN/$RECV" --check "$svc"; then
      log "dry-run for '$svc' is clean"
    else
      log "dry-run for '$svc' did NOT pass (see the receiver's message above) — '$svc' will NOT be triggered"
      check_ok=0
    fi
  done
fi

# ── self-check: PROVE the host is a production target, do not claim it (Part 1.6) ────────────────────
# Every check reports its own line; any failure makes the whole pass fail-closed (non-zero exit) so the
# operator never reads a green result over a half-ready host. In the test seam the effect-free checks
# still run; the ones that need root/systemd (caddy validate, forced-command over sshd) are skipped and
# named as skipped rather than faked.
selfcheck_failed=0
sc_ok()   { echo "  [ok]   $*"; }
sc_fail() { echo "  [FAIL] $*"; selfcheck_failed=1; }
sc_skip() { echo "  [skip] $*"; }
echo
echo "devlab-install-recv — self-check:"

# 1. rrsync present (the receiver exits 5 without it).
if rp="$(rrsync_path)"; then sc_ok "rrsync present ($rp)"; else sc_fail "rrsync NOT found — an rsync receive cannot be confined"; fi

# 2. receiver + library installed with the expected checksums (rechecked against the source beside us).
if [ -f "$SBIN/$RECV" ] && cmp -s -- "$SRC_DIR/$RECV" "$SBIN/$RECV"; then sc_ok "receiver $SBIN/$RECV matches source (sha256 $(sha "$SBIN/$RECV"))"; else sc_fail "receiver at $SBIN/$RECV does not match the source beside this script"; fi
if [ -f "$SBIN/$LIB" ] && cmp -s -- "$SRC_DIR/$LIB" "$SBIN/$LIB"; then sc_ok "library  $SBIN/$LIB matches source (sha256 $(sha "$SBIN/$LIB"))"; else sc_fail "library at $SBIN/$LIB does not match the source beside this script"; fi

# 3. the forced command really bites: a request for ANYTHING that is not an rsync receive or an install
#    trigger must be refused (the receiver falls through to repo-name validation and exits non-zero). We
#    prove this against the INSTALLED receiver by handing it a shell request the way sshd would.
if SSH_ORIGINAL_COMMAND="exec bash -i" DEVLAB_STAGING="$STAGING_ROOT" "$SBIN/$RECV" >/dev/null 2>&1; then
  sc_fail "the receiver ACCEPTED a shell request — the forced command is not confining input"
else
  sc_ok "the receiver rejects a shell request (a login can only rsync-into-staging or trigger an install)"
fi

# 4. the deploy-key line under the forced command is present (only meaningful when we provisioned it).
if [ "$PROVISION" = 1 ]; then
  ak="$(authorized_keys_path)"
  if [ -f "$ak" ] && grep -Fq -- "command=\"$SBIN/$RECV\"" "$ak"; then sc_ok "deploy key is pinned to the forced command in $ak"; else sc_fail "no forced-command deploy-key line in $ak"; fi
fi

# 5. the staging and web roots exist (a provisioning guarantee; the receiver-only refresh does not own
#    them — the receiver creates its staging at run time — so this is checked only when we provisioned).
if [ "$PROVISION" = 1 ]; then
  [ -d "$STAGING_ROOT" ] && sc_ok "staging root exists ($STAGING_ROOT)" || sc_fail "staging root missing ($STAGING_ROOT)"
  [ -d "$WWW_DIR" ]      && sc_ok "web root exists ($WWW_DIR)"         || sc_fail "web root missing ($WWW_DIR)"
fi

# 6. the edge validates WITH a delivered route (not merely empty) and imports the route directory from
#    inside a site block (needs the real caddy; the seam checks the written shape textually).
if [ "$PROVISION" = 1 ]; then
  if [ "${DEVLAB_RECV_TEST:-0}" = 1 ]; then
    sc_skip "caddy validation (test seam has no caddy) — edge shape checked textually below"
    if grep -Fq -- "import ${CADDY_CONF}/*.caddy" "$CADDY_MAIN" 2>/dev/null && grep -Eq '^[^#]*\{[[:space:]]*$' "$CADDY_MAIN" 2>/dev/null; then
      sc_ok "edge is a site block importing $CADDY_CONF ($CADDY_MAIN)"
    else
      sc_fail "edge does not import $CADDY_CONF from inside a site block ($CADDY_MAIN)"
    fi
  elif command -v "$CADDY_BIN" >/dev/null 2>&1 && caddy_validates_with_probe; then
    sc_ok "edge configuration validates WITH a delivered route ($CADDY_MAIN)"
    command -v systemctl >/dev/null 2>&1 && { systemctl is-active --quiet caddy && sc_ok "caddy is active" || sc_fail "caddy is not active"; }
  else
    sc_fail "edge configuration does not validate WITH a delivered route ($CADDY_MAIN) — a route dropped into $CADDY_CONF could not take effect"
  fi
fi

# 6b. SINGLE SOURCE OF TRUTH: the edge is BUILT ON the one declared address, and asking the declaration
#     (the same read the routing layer performs) yields that very address. If these two disagree the edge
#     answers where nothing forwards — the exact 502 this fixes — so the provision fails closed here.
if [ "$PROVISION" = 1 ]; then
  declared="$(setup_edge_address "$EDGE_ADDRESS_FILE" 2>/dev/null || true)"
  if [ -z "$declared" ]; then
    sc_fail "the edge address is not declared at $EDGE_ADDRESS_FILE — the routing layer has nothing to read"
  elif [ "$declared" != "$EDGE_ADDRESS" ]; then
    sc_fail "the declaration ($declared) and the address the edge was built on ($EDGE_ADDRESS) disagree — one source, two answers"
  elif [ "$EDGE_BUILT" != 1 ]; then
    # A grown edge we left untouched carries the operator's own site address; we do not govern its label.
    # The declaration is still established, so the routing layer reads the same address the operator runs.
    sc_ok "edge address declared as $EDGE_ADDRESS ($EDGE_ADDRESS_FILE); a grown edge at $CADDY_MAIN was kept as is, so its own site address stands and the routing layer reads the declaration"
  elif grep -Fq -- "$EDGE_ADDRESS {" "$CADDY_MAIN" 2>/dev/null; then
    sc_ok "edge answers on the ONE declared address $EDGE_ADDRESS ($EDGE_ADDRESS_FILE) — the routing layer reads the same"
  else
    sc_fail "the edge at $CADDY_MAIN is not a site block on the declared address $EDGE_ADDRESS"
  fi
fi

# 7. the overlay transport (only when we set it up). The interface must be up and carry the intended
#    config; the deep proof (handshake + ping) is reported below and, when --overlay-verify-peer is
#    given, is fail-closed there. The dead production-target twin must NOT be present after a provision.
if [ "$PROVISION" = 1 ] && [ -n "$OVERLAY_ADDRESS" ]; then
  if [ "${DEVLAB_RECV_TEST:-0}" = 1 ]; then
    [ -f "$(overlay_conf_path)" ] && sc_ok "overlay config written ($(overlay_conf_path))" || sc_fail "overlay config missing ($(overlay_conf_path))"
  else
    overlay_iface_up && sc_ok "overlay interface $OVERLAY_IFACE is up" || sc_fail "overlay interface $OVERLAY_IFACE is NOT up"
  fi
fi
if [ "$PROVISION" = 1 ]; then
  if [ "${DEVLAB_RECV_TEST:-0}" = 1 ] && [ -z "${DEVLAB_PROD_TARGET_FILE:-}" ]; then
    sc_skip "dead production-target twin check (test seam without a fixture path — the real /etc is not touched)"
  elif [ -e "$PROD_TARGET_DEAD_FILE" ]; then
    sc_fail "the dead production-target twin still exists ($PROD_TARGET_DEAD_FILE) — the ONE source is the runtime environment"
  else
    sc_ok "no dead production-target twin ($PROD_TARGET_DEAD_FILE); the ONE source is the runtime environment"
  fi
fi

if [ "$selfcheck_failed" != 0 ]; then die "self-check FAILED — the host is NOT a ready production target (see the lines above); nothing is left half-done because the run is fail-closed"; fi
echo "  all self-checks passed."

# The overlay's deep proof (Part 1.4): the handshake age and ping numbers. On the FIRST provision the
# peer (the home side) is usually not yet caught up, so the prod side reports the tunnel as PENDING (it
# cannot force the far side up) rather than faking a green link — unless --overlay-verify-peer is given,
# in which case the proof is fail-closed here too. The far side is completed and PROVEN by the one-liner
# printed in the closing report.
if [ "$PROVISION" = 1 ] && [ -n "$OVERLAY_ADDRESS" ]; then
  if [ -n "$OVERLAY_VERIFY_PEER" ]; then
    echo "  proving the overlay to $OVERLAY_VERIFY_PEER carries:"
    if out="$(overlay_prove "$OVERLAY_VERIFY_PEER")"; then
      printf '%s\n' "$out" | sed 's/^/    /'
    else
      # The receiver, edge and this host's overlay side are all correctly built; the PEER did not
      # answer. Fail closed on the proof WITHOUT rolling the whole provision back over an external
      # condition (a die here would undo the receiver install too). ERR-rollback already cleared? No —
      # so drop it explicitly before the honest non-zero exit.
      trap - ERR
      printf '%s\n' "$out" | sed 's/^/    /'
      echo "devlab-install-recv: the overlay peer $OVERLAY_VERIFY_PEER did not answer over $OVERLAY_IFACE — this host is provisioned and its overlay side is up, but the transport does NOT carry yet (see the numbers above). Bring the FAR side up, then re-run to prove it." >&2
      exit 1
    fi
  else
    echo "  overlay: this host's side is up; the peer handshake is PENDING until the home side is caught up (see the one-liner below) — not a green link claimed over a dead peer."
  fi
fi

# Past this point the receiver is installed and PROVEN; the file work is DONE. Triggering services is a
# per-service action whose failure must NOT roll the receiver back (the receiver is correct and other
# services depend on it), so the ERR-rollback is cleared here.
trap - ERR

# Bring each named service up from its already-staged artifact, over the SAME install path the chain
# uses (no separate first-install path). A first-time service is set up; an already-running one is only
# refreshed. Each result is reported; a failure here is named, not swallowed, and does not stop others.
declare -a WENT_UP=() STAYED_DOWN=()
for svc in "$@"; do
  if [ "$check_ok" != 1 ] && ! "$SBIN/$RECV" --check "$svc" >/dev/null 2>&1; then
    STAYED_DOWN+=("$svc (dry-run not clean — nothing triggered)")
    continue
  fi
  log "── triggering install of '$svc' ──"
  if "$SBIN/$RECV" "$svc"; then
    WENT_UP+=("$svc")
  else
    STAYED_DOWN+=("$svc (install trigger failed — see the message above)")
  fi
done

# ── closing report: what is done, and what remains and why (Handarbeit kommt als Skript) ──
echo
echo "devlab-install-recv — done."
if [ "$PROVISION" = 1 ]; then
  echo "  provisioned: rrsync, staging ($STAGING_ROOT), web ($WWW_DIR), edge ($CADDY_MAIN), deploy-key forced command ($RECV_USER)"
  echo "  edge address: this environment answers on $EDGE_ADDRESS, declared once in $EDGE_ADDRESS_FILE."
  echo "                The routing layer (a production-side sxgate) reads the SAME declaration —"
  echo "                'devlab-install-recv --print-edge-address' returns it. Neither side guesses the other."
  if [ -n "$OVERLAY_ADDRESS" ]; then
    echo "  overlay:   this host's side up on $OVERLAY_IFACE at $OVERLAY_ADDRESS${OVERLAY_LISTEN_PORT:+ (listening on $OVERLAY_LISTEN_PORT)}"
    overlay_report_pubkey
    # The exact next one-liner for the HOME side — its old copy of this host's key is now stale (Part
    # 1.3). Instance values already filled in from what this run generated and was told; the operator
    # runs ONE line on the home host, and it proves the tunnel.
    if [ -n "${OVERLAY_OURPUB:-}" ]; then
      here_ip="${OVERLAY_ADDRESS%%/*}"; peer_ip="${OVERLAY_PEER_ALLOWED%%/*}"
      echo "  Catch up the HOME side (run as root on the chain's host), then the transport carries:"
      echo "    sudo ./deploy/devlab-install-recv --overlay-here \\"
      echo "      --overlay-iface $OVERLAY_IFACE --overlay-address ${peer_ip}/${OVERLAY_ADDRESS#*/} \\"
      echo "      --overlay-peer-pubkey '$OVERLAY_OURPUB' --overlay-peer-allowed ${here_ip}/32 \\"
      echo "      --overlay-peer-endpoint ${OVERLAY_ENDPOINT:-<this-host-public-address>:${OVERLAY_LISTEN_PORT:-51820}} \\"
      echo "      --overlay-keepalive 25 --overlay-verify-peer ${here_ip}"
    fi
  fi
fi
echo "  receiver:  $SBIN/$RECV   (sha256 $(sha "$SBIN/$RECV"))"
echo "  library:   $SBIN/$LIB    (sha256 $(sha "$SBIN/$LIB"))"
if [ "${#WENT_UP[@]}" -gt 0 ]; then
  echo "  brought up now: ${WENT_UP[*]}"
fi
if [ "${#STAYED_DOWN[@]}" -gt 0 ]; then
  echo "  NOT brought up: ${STAYED_DOWN[*]}"
fi
echo
if [ "$PROVISION" = 1 ]; then
  echo "  This host is now a production target: the delivery chain can rsync into staging behind the"
  echo "  deploy key's forced command and trigger an install. No further step on the target is needed to"
  echo "  ACCEPT a delivery. Arm the chain on the DEV side by naming this host in the runtime"
  echo "  configuration (DEVLAB_RUNS_PROD_TARGET, DEVLAB_RUNS_PROD_RECV, DEVLAB_RUNS_PROD_KEY)."
fi
echo "  Any service NOT named above that is merged but never set up on this host is unblocked: the"
echo "  running DevLab service re-sends every production-owing delivery on its own schedule and the"
echo "  receiver sets it up on the next attempt. To bring one up immediately, re-run with its name,"
echo "  e.g.:  sudo $0 <service>"
if [ "${#STAYED_DOWN[@]}" -gt 0 ]; then
  exit 1  # at least one named service did not come up — honest non-zero for the operator
fi

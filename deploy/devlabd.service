# DevLab backend (devlabd) — systemd unit TEMPLATE.
#
# Instance values (domain, cookie domain, ports, run user) belong in a local drop-in
# (/etc/systemd/system/devlabd.service.d/*.conf), NEVER in this repo. The values below are
# overridable defaults. There is NO operating-mode variable — modes do not exist
# (REQ-027.1); DEVLAB_RUNS_MAX_CONCURRENCY, when set, is only the FIRST-start seed of the
# runtime settings pool (REQ-013.2).
#
# Install (once, as root — the `service` CLI performs these steps interactively):
#   sudo install -m0755 devlabd /usr/local/bin/devlabd
#   sudo install -m0644 deploy/devlabd.service /etc/systemd/system/devlabd.service
#   sudo install -m0644 permissions/devlab.json /etc/holistic/permissions.d/devlab.json
#   sudo groupadd -f hp_devlab_access
#   sudo systemctl daemon-reload && sudo systemctl enable --now devlabd

[Unit]
Description=DevLab backend (devlabd)
After=network.target

[Service]
Type=simple
# Dedicated unprivileged service user. Per-user git/file ops (and terminal/AI) run AS the
# logged-in Linux user via the pinned devlab-exec sudo wrapper; the service itself only reads.
User=devlab
SupplementaryGroups=holistic
ExecStart=/usr/local/bin/devlabd
Restart=on-failure
RestartSec=3
# On SIGTERM devlabd drains: admissions close, agent children get SIGTERM, every running
# execution is persisted as interrupted with its continuation (< DEVLAB_RUNS_DRAIN_GRACE),
# then HTTP shuts down. Keep TimeoutStopSec above that grace (K-2) — a long run never blocks
# the stop.
TimeoutStopSec=90

# The ONE state root. Every persisted path derives from it (internal/statepath).
Environment=DEVLAB_STATE_DIR=/var/lib/devlab
# Listen address (loopback; the edge proxy routes the public host here).
Environment=DEVLAB_ADDR=127.0.0.1:8781
# Shared Holistic session secret (validates the h_access SSO cookie). Missing/unreadable
# secret makes devlabd refuse to start in SSO mode (fail closed).
Environment=HOLISTIC_SECRET_FILE=/etc/holistic/jwt-secret
Environment=DEVLAB_COOKIE_SECURE=1
# Honor a Holistic logout/rotation at refresh time (read-only).
Environment=HOLISTIC_REVOKED=/var/lib/holistic/revoked.json
# Per-user GitHub link store key + OAuth app config (operator-provisioned files).
Environment=DEVLAB_LINK_ENC_KEY_FILE=/etc/devlab/link-key
Environment=DEVLAB_GITHUB_OAUTH_FILE=/etc/devlab/github-oauth.json
# Drain/resume knobs (runtime settings win over env where a settings value exists).
Environment=DEVLAB_RUNS_DRAIN_GRACE=60s
Environment=DEVLAB_RUNS_RESUME_WINDOW=240h

# Hardening. NoNewPrivileges must be false (the service escalates via the pinned sudo
# wrappers to run ops as the end user); ProtectHome false so per-user git/claude configs
# resolve. Isolation is at the sudo/OS-user layer (devlab-exec), not the mount namespace.
StateDirectory=devlab
ReadWritePaths=/var/lib/devlab
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=false
PrivateTmp=false

[Install]
WantedBy=multi-user.target

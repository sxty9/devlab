# /etc/sudoers.d/devlab — the ONLY privileges the devlab service holds.
# Install: sudo install -m0440 -o root -g root deploy/devlab.sudoers /etc/sudoers.d/devlab
# then: sudo visudo -cf /etc/sudoers.d/devlab   (validate before trusting)
#
# 1) Run per-user ops (git/claude/file/artifact-build) as any DevLab-eligible user, pinned to
#    devlab-exec. Runas is restricted to the hp_devlab_access group (developers) so the service
#    can never become root or an unrelated account. The GitHub token is passed via
#    DEVLAB_GH_TOKEN (never argv) — env_keep lets it (and GIT_TERMINAL_PROMPT) survive sudo's
#    env reset.
#    NOTHING ELSE MAY JOIN THIS LIST. devlab-exec confines every path to
#    <state root>/workspaces/<user> and resolves that root from DEVLAB_STATE_DIR /
#    DEVLAB_WORKSPACES with the template's defaults. Keeping either variable would let the calling
#    service pick the boundary it is measured against — that is, hand it every user's files. The
#    same holds for the install wrapper's seams (DEVLAB_SYSTEMCTL, DEVLAB_GH_OWNER,
#    DEVLAB_GH_OWNER_FILE): they exist for direct invocation in tests, and it is sudo's env_reset
#    that makes them harmless in production.
Defaults!/usr/local/sbin/devlab-exec env_keep += "DEVLAB_GH_TOKEN GIT_TERMINAL_PROMPT"
devlab ALL=(%hp_devlab_access) NOPASSWD: /usr/local/sbin/devlab-exec

# 2) Provision a user's workspace root (create + chown to the user) — needs root, pinned to the
#    mkworkspace helper which itself validates the target is a real, DevLab-eligible account.
devlab ALL=(root) NOPASSWD: /usr/local/sbin/devlab-mkworkspace

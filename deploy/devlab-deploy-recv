#!/usr/bin/env bash
# devlab-deploy-recv — VPS-side INSTALL-ONLY receiver for prod deploys. It is the forced command
# behind the root-held deploy key: the dev box ships a PREBUILT artifact here and then triggers an
# install. THIS HOST NEVER BUILDS (no go, no npm) — prod runs only prebuilt bytes.
#
# authorized_keys line (root's ~/.ssh/authorized_keys on the VPS — ONE logical line; the leading
# option list is what turns a normal key into a locked-down deploy key):
#
#   command="/usr/local/sbin/devlab-deploy-recv",restrict ssh-ed25519 AAAA...devkey... devlab-prod-deploy
#
# You do NOT transcribe this line by hand: `devlab-install-recv --provision --deploy-pubkey <pubkey>`
# writes it (and stands up rrsync, the staging/web roots and the Caddy edge) in one self-checking pass.
#
#   `restrict` = no-agent-forwarding,no-port-forwarding,no-pty,no-user-rc,no-X11-forwarding (and any
#   future restrictions). Combined with command="…" it means: whatever the client asks for, sshd runs
#   ONLY this script. The client's requested command arrives in $SSH_ORIGINAL_COMMAND (no argv).
#
# This script permits EXACTLY two operations, both confined to staging/prod, and rejects all else:
#   1. rsync receive   -> delegated to rrsync, which confines every path in the rsync request under
#      the staging root and allows ONLY writes (-wo). This is how the prebuilt bytes arrive; it is
#      impossible to write outside <STAGING_ROOT> or to read anything back.
#   2. install <repo>  -> copy the staged prebuilt artifact into prod paths + restart the prod unit.
#      When the unit does NOT yet exist, this is a FIRST-TIME setup: the unit/route/rights that TRAVELLED
#      IN THE ARTIFACT (staged under <repo>/setup/, produced by the one devlab-install template) are
#      installed, the service account is created, systemd is reloaded, the unit enabled and started.
#      The receiver ERZEUGT nichts — it INSTALLS what was delivered, guarded by the SAME name/namespace/
#      identity rules devlab-install applies (shared via devlab-setup-lib.sh).
# So even a COMPROMISED dev key can only push files into staging and (re)install a KNOWN repo — never
# run an arbitrary command as this host's ssh user, never escape the staging/prod paths.
#
# A --check dry-run (direct invocation, no ssh) runs the FIRST-TIME-vs-UPDATE decision and the setup
# validations WITHOUT root and WITHOUT effect, so the install logic is provable off the production host.
#
# Exit codes: 0 ok · 2 bad/blocked request or setup validation · 3 no staged artifact / no mapping ·
#             4 external tool failed (caddy) · 5 rrsync missing / foreign unit / missing setup library ·
#             10 staged input missing · 11 unit did not come up after start.
#
# Install/refresh (on the VPS) with the ONE self-checking script beside this file — it installs this
# receiver AND the shared library together, backs up what it replaces, proves the result, and can
# bring already-staged services up in the same pass (Handarbeit kommt als Skript):
#   sudo /path/to/deploy/devlab-install-recv [service ...]
# This receiver cannot deliver itself: the deploy key behind it is a forced command limited to
# rsync-into-staging and install-trigger, so a new receiver version reaches this host only through
# that operator script (backend/internal/deploy/wrappers.go — selfWrappers deliberately excludes it).
set -euo pipefail

# The ONE state-root derivation shared by every DevLab wrapper (devlab-install, devlab-exec,
# devlab-mkworkspace carry it verbatim): every path this receiver touches DERIVES from the state root,
# so an instance with a different root does not end up with a receiver staging in one place and a
# daemon serving from another. This host has no per-user workspaces — it is install-only — so what it
# derives are the staging root the forced command receives into and the web root it serves from
# (mirroring statepath.Www()).
#
# The overrides are a DIRECT-INVOCATION seam, never an input of the forced command: sshd hands the
# client no environment (AcceptEnv does not list these names, and the key's `restrict` option disables
# user-rc), so a client cannot move the staging boundary it is confined to.
STATE_DIR="${DEVLAB_STATE_DIR:-/var/lib/devlab}"
STAGING_ROOT="${DEVLAB_STAGING:-$STATE_DIR/staging}"
WWW_DIR="${DEVLAB_STATIC_DIR:-$STATE_DIR/www}"

# The system paths a first-time setup writes into, and the tools it asks. Instance-neutral defaults of
# this template; the env overrides are the direct-invocation test seam (sshd strips the client's env).
UNIT_DIR="${DEVLAB_UNIT_DIR:-/etc/systemd/system}"
CADDY_CONF="${DEVLAB_CADDY_CONF:-/etc/caddy/conf.d}"
CADDY_MAIN="${DEVLAB_CADDY_MAIN:-/etc/caddy/Caddyfile}"
CADDY_BIN="${DEVLAB_CADDY_BIN:-caddy}"
PERMS_DIR="${DEVLAB_HOLISTIC_PERMS:-/etc/holistic/permissions.d}"
# systemd is the authority on which units exist — asked through this binary so the question is
# answerable in a dry run (the seam is stripped by sshd in production).
SYSTEMCTL="${DEVLAB_SYSTEMCTL:-systemctl}"
# The account and package databases the reserved-name gate reads to tell a genuine first install of a
# reserved landscape name (nothing exists under it) from a name grab (an OS account or a distro package
# already holds it). Seams for the direct-invocation dry run only — sshd hands the forced command no
# environment, so a client cannot move them; in production these are the real tools.
GETENT="${DEVLAB_GETENT:-getent}"
DPKG="${DEVLAB_DPKG:-dpkg-query}"

log() { logger -t devlab-deploy-recv -- "$*" 2>/dev/null || true; echo "devlab-deploy-recv: $*" >&2; }
die() { log "$1"; exit "${2:-2}"; }

# --check dry-run: FIRST arg is the flag; direct invocation only (the forced command never sets it).
CHECK=0
if [ "${1:-}" = "--check" ]; then CHECK=1; shift; fi

# run — execute for real, or record the decision as a PLAN line in --check mode (mirrors devlab-install).
run() {
  if [ "$CHECK" = 1 ]; then echo "PLAN: $*"; return 0; fi
  "$@"
}

# The honest running gate (F10), executed HERE on the production host — the SAME proof the dev delivery
# uses (deploy.VerifyRunning), just run on the target: "installed and started" is reported only once the
# unit is genuinely up AND STAYS up. A service that starts and dies immediately is not active — it is in
# a restart loop, and "active" caught in the fraction before it died is a lie the honest gate must not
# tell (WHAT-2). So the gate proves it in two phases, using the SAME signals the dev gate uses — the
# unit is active AND its port is held — applied over TIME rather than at one instant:
#   1. COME UP: within ~15s the unit is active and (when the port is known) the port is held.
#   2. STAY UP: it then REMAINS active and port-held continuously for a dwell (~12s). A restart loop
#      drops its port every cycle, so a continuous port-held requirement catches it; the same reading
#      the gate already does, just not once. If the service drops during the dwell it did not stay.
# A unit that never comes up, or comes up and drops, is a FAILED production delivery: the gate names the
# real reason from the service's own log and exits 11, so the sending side records a failure with the
# line that carries the cause (not a 'done'). In --check nothing was started — the plan names it instead.
GATE_COMEUP_SECS="${DEVLAB_GATE_COMEUP_SECS:-15}"
GATE_DWELL_SECS="${DEVLAB_GATE_DWELL_SECS:-12}"

# port_held <port> — true when something accepts a TCP connect on 127.0.0.1:<port>. Uses bash's own
# /dev/tcp so the receiver needs no extra tool on the production host.
port_held() {
  local port="$1"
  ( exec 3<>"/dev/tcp/127.0.0.1/$port" ) >/dev/null 2>&1
}

# gate_up <unit> <port> — one honest reading: unit active AND (when the port is known) port held.
gate_up() {
  local unit="$1" port="$2"
  "$SYSTEMCTL" is-active --quiet "$unit" || return 1
  [ -n "$port" ] && { port_held "$port" || return 1; }
  return 0
}

# gate_reason <unit> — the real cause from the service's OWN log, for a failed delivery message. The
# last few journal lines carry the line that killed it (e.g. "no JWT secret: set HOLISTIC_SECRET_FILE").
gate_reason() {
  local unit="$1" out
  out="$(journalctl -u "$unit" -n 5 --no-pager -o cat 2>/dev/null | grep -v '^$' | tail -n 2 | tr '\n' ' ' || true)"
  [ -n "$out" ] && printf '%s' "$out" || printf 'no log line captured'
}

prove_running() {
  local unit="$1" port="${2:-}" deadline
  if [ "$CHECK" = 1 ]; then
    echo "PLAN: prove '$unit' is active AND holds its port${port:+ (:$port)}, then STAYS up for ${GATE_DWELL_SECS}s (F10) — else fail the delivery with the reason from its log"
    return 0
  fi
  # phase 1 — come up
  deadline=$((SECONDS + GATE_COMEUP_SECS))
  until gate_up "$unit" "$port"; do
    (( SECONDS >= deadline )) && die "prod gate: unit '$unit' did NOT come up within ${GATE_COMEUP_SECS}s — delivery failed: $(gate_reason "$unit")" 11
    sleep 1
  done
  # phase 2 — stay up: continuous over the dwell, or it was a restart loop
  deadline=$((SECONDS + GATE_DWELL_SECS))
  while (( SECONDS < deadline )); do
    sleep 1
    gate_up "$unit" "$port" \
      || die "prod gate: unit '$unit' came up but did NOT stay (a restart loop, not a start) — delivery failed: $(gate_reason "$unit")" 11
  done
  log "prod gate: unit '$unit' is active and stayed up${port:+ holding :$port} for ${GATE_DWELL_SECS}s"
  return 0
}

mkdir -p "$STAGING_ROOT"

# ── operation 1: rsync receive (the prebuilt upload) ──────────────────────────────────────────────
# Match only an rsync SERVER receive; hand it to rrsync locked to the staging root. rrsync (shipped
# with rsync) rejects absolute paths, '..', and any non-receive mode, so the client can write ONLY
# under <STAGING_ROOT>/<its-chosen-subdir>. Skipped in --check (no ssh command in a dry run).
if [ "$CHECK" = 0 ]; then
  CMD="${SSH_ORIGINAL_COMMAND:-$*}"
  case "$CMD" in
    rsync\ --server\ *)
      rrsync=""
      for c in rrsync /usr/bin/rrsync /usr/share/rsync/scripts/rrsync /usr/lib/rsync/rrsync; do
        p="$(command -v "$c" 2>/dev/null || true)"; [[ -n "$p" ]] && { rrsync="$p"; break; }
      done
      [[ -n "$rrsync" ]] || die "rrsync not found; cannot confine rsync receive" 5
      exec "$rrsync" -wo "$STAGING_ROOT"
      ;;
  esac

  # ── operation 2: install trigger — "[devlab-deploy-recv] <repo>" ───────────────────────────────
  # Disable globbing before word-splitting the (untrusted) command so a '*' cannot expand to filenames.
  set -f
  # shellcheck disable=SC2086
  set -- $CMD
  set +f
  case "${1:-}" in devlab-deploy-recv|*/devlab-deploy-recv) shift ;; esac
  [[ $# -le 1 ]] || die "unexpected extra arguments" 2
fi
REPO="${1:-}"

# The repo name must be path-safe under staging (charset + no traversal). The STRICTER service-name
# grammar (setup_valid_repo_name) is applied only where it decides an identity — first-time setup below.
{ [[ "$REPO" =~ ^[A-Za-z0-9._-]+$ ]] && [[ "$REPO" != *..* ]]; } || die "invalid repo name '${REPO:-<none>}'" 2

# Resolve the staged artifact and require it stays under the staging root (defeat symlink escapes).
SRC="$STAGING_ROOT/$REPO"
real="$(realpath -e -- "$SRC" 2>/dev/null)" || die "no staged artifact for '$REPO' ($SRC)" 3
rootreal="$(realpath -e -- "$STAGING_ROOT")"
case "$real/" in "$rootreal"/*) : ;; *) die "staged path escapes staging root" 2 ;; esac

dryrun_note=""; [ "$CHECK" = 1 ] && dryrun_note=" (dry-run)"
log "install-only prod deploy of '$REPO' from $real$dryrun_note"

# The shared first-time SETUP product + rules — the SAME library devlab-install sources on the dev host,
# so the receiver INSTALLS exactly what that one template produced and applies the identical name,
# reserved-identity, foreign-unit and User= checks. Sourced HERE (an rsync receive above never needs
# it) — beside this wrapper (same sbin dir in production, same deploy/ dir in the test tree);
# DEVLAB_SETUP_LIB is the direct-invocation test seam. A missing library is a config-state failure.
SETUP_LIB="${DEVLAB_SETUP_LIB:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/devlab-setup-lib.sh}"
[ -r "$SETUP_LIB" ] || die "shared setup library not found: $SETUP_LIB (devlab-setup-lib.sh must be installed beside this receiver)" 5
# shellcheck source=/dev/null
. "$SETUP_LIB"

# ensure_secrets_for <repo> <unit-file> — MINT this host's instance secrets before the service starts,
# derived from what the unit demands (the SAME rule the dev host applies via devlab-install). A blank
# host has none, so without this the service installs and then dies at start with "no JWT secret …" and
# loops. Secrets are minted HERE and never transported; a missing OUTSIDE credential is NAMED, not
# swallowed. In --check it only plans (no effect).
ensure_secrets_for() {
  local repo="$1" unit="$2"
  if [ "$CHECK" = 1 ]; then setup_plan_secrets "$unit"; return 0; fi
  setup_ensure_secrets "$repo" "$unit"
}

# Install the prebuilt artifact into concrete prod paths + unit. NO build, and no per-repo
# scripts (B-44): every uniform service takes the ONE generic branch below; only the self repo
# has a different artifact shape (daemon + web SPA) and therefore its own layout.
case "$REPO" in
  devlab)
    # The self repo is a genuine LAYOUT special case (its Code-Struktur differs by necessity): a daemon
    # PLUS a web SPA, its binary at /usr/local/bin/devlabd, its dashboard mirrored into the www root, and
    # its unit named devlabd.service (not devlab.service). What is NOT special is the DECISION between a
    # first-time setup and a renewal, nor the refusal of a foreign unit — those are the SAME shared logic
    # the uniform branch uses (setup_unit_state), so a bare host sets devlab up completely instead of
    # dying on `systemctl restart: Unit devlabd.service not found` (measured 2026-08-06). The unit NAME
    # and the own-file PATH are the only differences fed into that shared decision.
    BIN="$real/devlabd"; WEB="$real/web"
    [[ -f "$BIN" ]] || die "staged binary missing: $BIN" 10
    [[ -d "$WEB" ]] || die "staged web dir missing:  $WEB" 10

    DEVLABD_UNIT_FILE="$UNIT_DIR/devlabd.service"
    state="$(setup_unit_state devlabd "$DEVLABD_UNIT_FILE" "$SYSTEMCTL")" || die "could not ask systemd about devlabd.service" 4
    case "$state" in
      first-time) SELF_FIRST=1 ;;
      update)     SELF_FIRST=0 ;;
      foreign:*)  die "unit devlabd.service already exists outside this receiver's control (${state#foreign:}) — refusing to shadow or overwrite a foreign unit" 5 ;;
      *)          die "unexpected unit state '$state' for devlabd.service" 2 ;;
    esac

    # The program and the web SPA are installed the SAME way in both cases — the layout is what makes
    # devlab special, and the layout does not change between a first-time setup and a renewal.
    run install -o root -g root -m 0755 "$BIN" /usr/local/bin/devlabd
    run mkdir -p "$WWW_DIR"
    run rsync -a --delete "$WEB"/ "$WWW_DIR"/
    # THE SERVED FACE IS READABLE BY THE EDGE, NOT BY THE BUILD ACCOUNT. `rsync -a` above carries the
    # SOURCE's owner and mode, and the source is the artifact built on the workbench under the
    # unprivileged build account — so on a freshly provisioned host the web root arrived drwxr-x--- /
    # uid 1001 and the edge (a different account) answered 404 over a present page. The serving side sets
    # the public-by-role readability (a+rX), symmetric to the a+rX the program install gives /opt/<repo>,
    # never the account that happened to build (setup_serve_root_readable) — then PROVE the edge can read
    # the start page, so a served tree it cannot read is a FAILED delivery named here, not a silent 404.
    if [ "$CHECK" = 1 ]; then
      echo "PLAN: make the served web root $WWW_DIR readable by the edge's role (a+rX; symmetric to /opt/<repo>), then PROVE the edge account can read $WWW_DIR/index.html — else fail the delivery BENANNT"
    else
      setup_serve_root_readable "$WWW_DIR"
      serve_reason="$(setup_serve_root_check "$WWW_DIR" 2>&1)" || die "prod web delivery of 'devlab' failed: $serve_reason" 11
    fi

    if [ "$SELF_FIRST" = 1 ]; then
      # ── FIRST-TIME SETUP of devlab — install the DELIVERED unit/route/rights (the receiver erzeugt
      # nichts). The unit is devlab's CHECKED-IN deploy/devlabd.service, carried in the artifact under
      # setup/; the route is devlab's own /api/* route. A devlabd that runs but is unreachable is NOT
      # set up (task point 4), so the route belongs to the setup exactly as the unit does. ──
      log "Erstinstallation of 'devlab' — no devlabd.service on this host; installing the delivered setup product"
      SETUP="$real/setup"
      DELIV_UNIT="$SETUP/devlabd.service"
      [ -d "$SETUP" ] || die "first-time setup of 'devlab' needs a delivered setup/ in the artifact, but none was shipped — the build did not attach the unit (a change without its delivery is a failure)" 10
      [ -f "$DELIV_UNIT" ] || die "first-time setup of 'devlab' has no delivered unit at $DELIV_UNIT" 10
      # The delivered unit is not trusted blindly: it must run as its OWN service account, exactly
      # `User=devlab` (the same gate the uniform branch applies; a foreign unit was already refused above).
      setup_unit_declares_user "$DELIV_UNIT" devlab \
        || die "delivered unit $DELIV_UNIT does not run as 'User=devlab' — refusing (a unit that starts something else or runs as root is not installed)" 2

      DELIV_ROUTE="$SETUP/devlab.caddy"
      DELIV_RIGHTS="$SETUP/devlab.json"

      if [ "$CHECK" = 1 ]; then
        echo "PLAN: Erstinstallation of 'devlab' (no devlabd.service on this host)"
        echo "PLAN: create nologin system account 'devlab' (home /var/lib/devlab) if missing"
        echo "PLAN: install delivered unit $DELIV_UNIT -> $DEVLABD_UNIT_FILE (verified User=devlab)"
        [ -f "$DELIV_ROUTE" ] && echo "PLAN: install delivered route $DELIV_ROUTE -> $CADDY_CONF/devlab.caddy (caddy validate + reload; unwind on failure)" \
                              || echo "PLAN: no delivered route in the artifact — none installed"
        [ -f "$DELIV_RIGHTS" ] && echo "PLAN: install delivered rights $DELIV_RIGHTS -> $PERMS_DIR/devlab.json + groupadd its hp_* groups" \
                               || echo "PLAN: no delivered rights in the artifact — installed without declared rights"
        setup_plan_secrets "$DELIV_UNIT"
        echo "PLAN: $SYSTEMCTL daemon-reload && $SYSTEMCTL enable devlabd"
        echo "PLAN: restart devlabd (the existing self-repo restart; no second, inline start path is built)"
        prove_running devlabd "$(setup_unit_listen_port "$DELIV_UNIT")"
        echo "PLAN: prod deploy of 'devlab' done (first-time setup)"
        exit 0
      fi

      setup_ensure_account devlab
      install -o root -g root -m 0644 "$DELIV_UNIT" "$DEVLABD_UNIT_FILE"

      if [ -f "$DELIV_ROUTE" ] && [ -d "$CADDY_CONF" ]; then
        rc=0; reason="$(setup_install_route "$DELIV_ROUTE" "$CADDY_CONF/devlab.caddy" "$CADDY_BIN" "$CADDY_MAIN" "$SYSTEMCTL" "$DEVLABD_UNIT_FILE" 2>&1)" || rc=$?
        [ "$rc" = 0 ] || die "$reason" "$rc"
      elif [ -f "$DELIV_ROUTE" ]; then
        log "no route dir at $CADDY_CONF — delivered route NOT installed"
      fi

      if [ -f "$DELIV_RIGHTS" ]; then
        setup_install_rights "$DELIV_RIGHTS" "$PERMS_DIR" devlab
      else
        log "no delivered rights for 'devlab' — installed without declared rights"
      fi

      # Mint the host's instance secrets from what the delivered unit demands, BEFORE the first start —
      # otherwise devlabd comes up and dies on the missing JWT secret and the gate (correctly) fails.
      ensure_secrets_for devlab "$DEVLABD_UNIT_FILE"
      "$SYSTEMCTL" daemon-reload
      "$SYSTEMCTL" enable devlabd >/dev/null 2>&1 || true
      # The self repo is restarted through its EXISTING restart, not a new inline start path (task point
      # 3): on a first-time host the unit is stopped, so `restart` starts it, and on a renewal it restarts
      # it — one path for both. devlabd never restarts itself inline (that happens on the DEV host through
      # devlab-install --handover); HERE the receiver is a separate root process, so a direct restart is
      # correct and does not kill the caller.
      "$SYSTEMCTL" restart devlabd
      prove_running devlabd "$(setup_unit_listen_port "$DEVLABD_UNIT_FILE")"
    else
      # ── RENEWAL — devlabd.service already present: replace the program + web (done above) and restart,
      # minting any secret a host set up before secrets existed still lacks (idempotent self-heal). ──
      log "Aktualisierung of 'devlab' — devlabd.service already present; replacing the program and restarting"
      ensure_secrets_for devlab "$DEVLABD_UNIT_FILE"
      run "$SYSTEMCTL" restart devlabd
      prove_running devlabd "$(setup_unit_listen_port "$DEVLABD_UNIT_FILE")"
    fi
    ;;
  *)
    # Uniform Holistic service — ONE install path that carries every declared build kind, the SAME
    # dispatch the dev installer uses (shared library, no second path on prod). The artifact SAYS what it
    # is (build.kind) and the receiver installs what it CONTAINS and the unit DESCRIBES; it never guesses a
    # Bauart from a filename. <repo> is already charset+traversal validated above, so the derived paths are
    # bounded. An undeclared kind is refused BY NAME.
    KIND="$(setup_read_build_kind "$real")"
    [ -n "$KIND" ] || die "artifact for '$REPO' does not declare its build kind (no build.kind) — refusing to guess it from filenames; a service must declare its Bauart ($SETUP_BUILD_KINDS)" 2
    setup_valid_build_kind "$KIND" || die "artifact declares an unknown build kind '$KIND' (known: $SETUP_BUILD_KINDS)" 2
    case "$KIND" in
      go-daemon)
        gbin="$real/${REPO}d"
        [[ -f "$gbin" ]] || die "staged binary missing: $gbin (build.kind=go-daemon expects a prebuilt <repo>d)" 10
        ;;
      python-app)
        payload="$real/payload"
        [[ -d "$payload" ]] || die "staged payload missing: $payload (build.kind=python-app expects a prebuilt payload/ tree)" 10
        # PRE-COPY COMPATIBILITY GATE — a python-app carries its own interpreter + stdlib, so it no longer
        # depends on THIS host's python VERSION; but the interpreter is a native binary and an older system
        # C library here than on the build host would still stop it. PROVE it runs and imports its bundled
        # stdlib BEFORE the copy, so the incompatibility is NAMED here and now (Kein stummes Ausbleiben) and
        # never left to surface as a restart loop in the unit log. The proof is side-effect-free, so it runs
        # in --check too — a plan that could not be carried out must not read as clean.
        pyself="$(setup_python_payload_selftest "$payload")" \
          || die "python-app '$REPO': the delivered interpreter cannot run on this production host — refusing BEFORE copy so the incompatibility is named here, not as a restart loop in the unit log (see the reason above)" 10
        if [[ "$CHECK" == 1 ]]; then echo "PLAN: pre-copy gate — bundled python $pyself verified runnable on this host"; else log "python-app '$REPO': bundled python $pyself verified runnable on this host — proceeding to copy"; fi
        ;;
    esac

    # install_program / plan_program — install the prebuilt program per its declared kind (a pure copy;
    # THIS HOST NEVER BUILDS). go-daemon: the single <repo>d binary. python-app: the payload/ tree copied
    # verbatim to /opt/<repo> (venv shebangs relocated at build time), --safe-links dropping any escaping
    # symlink, then a+rX so the service account (User=<repo>, not root) can read and run the interpreter.
    install_program() {
      case "$KIND" in
        go-daemon)
          install -d -o root -g root -m 0755 "/opt/$REPO/bin"
          install -o root -g root -m 0755 "$gbin" "/opt/$REPO/bin/${REPO}d"
          ;;
        python-app)
          install -d -o root -g root -m 0755 "/opt/$REPO"
          rsync -a --delete --safe-links "$payload/" "/opt/$REPO/"
          chmod -R a+rX "/opt/$REPO"
          ;;
      esac
    }
    plan_program() {
      case "$KIND" in
        go-daemon)  echo "PLAN: install binary $gbin -> /opt/$REPO/bin/${REPO}d" ;;
        python-app) echo "PLAN: copy prebuilt payload $payload/ -> /opt/$REPO/ (rsync --delete --safe-links + chmod a+rX; this host never builds)" ;;
      esac
    }

    # The UNIT NAME comes from the DELIVERED setup product, not from the repository name: a service whose
    # unit is legitimately named otherwise (a dashboard shipping <repo>-dashboard.service) carries that
    # unit in setup/, and the receiver installs it under THAT name. When the package ships no unit — or the
    # conventional <repo>.service — the name is <repo> exactly as before. The name is a systemctl argument
    # and a unit-file path, so a divergent one passes the lexical gate; the deeper guards (foreign unit,
    # User=<repo>) are unchanged and still bind the unit to this service's own account.
    SETUP="$real/setup"
    UNIT_NAME="$(setup_delivered_unit_name "$SETUP" "$REPO")"; [ -n "$UNIT_NAME" ] || UNIT_NAME="$REPO"
    if [ "$UNIT_NAME" != "$REPO" ]; then
      setup_valid_unit_name "$UNIT_NAME" || die "refusing delivered unit '$UNIT_NAME' for '$REPO' (name/namespace)" 2
    fi

    # FIRST-TIME vs UPDATE vs FOREIGN is decided by systemd, not by a path (setup_unit_state): the shared
    # decision the self branch below makes too. Our own unit (or one we already installed) → UPDATE. No
    # unit at all → FIRST-TIME. A FOREIGN unit → refuse: we neither shadow nor overwrite a unit that is
    # not ours (the same refusal devlab-install makes). It asks systemd about the DELIVERED unit name.
    UNIT_FILE="$UNIT_DIR/${UNIT_NAME}.service"
    state="$(setup_unit_state "$UNIT_NAME" "$UNIT_FILE" "$SYSTEMCTL")" || die "could not ask systemd about ${UNIT_NAME}.service" 4
    case "$state" in
      first-time) FIRST_TIME=1 ;;
      update)     FIRST_TIME=0 ;;
      foreign:*)  die "unit ${UNIT_NAME}.service already exists outside this receiver's control (${state#foreign:}) — refusing to shadow or overwrite a foreign unit" 5 ;;
      *)          die "unexpected unit state '$state' for ${UNIT_NAME}.service" 2 ;;
    esac

    # THE RESERVED-IDENTITY GATE — the SAME shared rules devlab-install applies, run HERE for both branches
    # so the receiver and the dev installer never drift on it. A reserved <repo> (an OS account, a package,
    # a landscape component such as the `holistic` dashboard) is judged in THREE cases, all read from the
    # host and the delivered package, never guessed from the name:
    #   renew  — the host already carries our own unit under the delivered name (an update — a foreign unit
    #            was refused above) AND that unit runs as `User=<repo>`: the identity's owner renewing
    #            itself (setup_owns_reserved_name).
    #   admit  — a FIRST-TIME setup on a bare host where NOTHING under the name exists: no foreign account,
    #            no package, and no unit (first-time). This is the whole point of the fix — on a freshly
    #            provisioned production host `holistic` owns nothing but also collides with nothing, so its
    #            first install must be admitted; the reserved list protects against foreign PROPERTY, not
    #            against ABSENCE (setup_reserved_name_free). Without this, holistic — the one landscape
    #            service not yet on a new host — could never reach production at all.
    #   refuse — anything else: a first-time name already held by a foreign account or package, or an
    #            update whose unit runs as someone else. The list is NOT shortened.
    # The shape/namespace of the name is validated separately in the first-time branch below
    # (setup_valid_repo_shape).
    is_update=0; [ "$FIRST_TIME" = 0 ] && is_update=1
    for r in $SETUP_RESERVED_REPOS; do
      if [ "$REPO" = "$r" ]; then
        if setup_owns_reserved_name "$REPO" "$UNIT_FILE" "$is_update"; then
          log "repo '$REPO' is reserved, but its unit '${UNIT_NAME}.service' is already ours and runs as 'User=$REPO' — the identity's owner renewing itself; admitted"
        elif [ "$is_update" = 0 ] && setup_reserved_name_free "$REPO" "$GETENT" "$DPKG"; then
          log "repo '$REPO' is reserved, but nothing under this name exists on this host (no account, no package, no unit) — the identity is unclaimed; first-time install admitted"
        else
          die "repo name '$REPO' is reserved (operating-system, package or landscape identity) — no unit under this name is yet ours to renew (name/namespace)" 2
        fi
        break
      fi
    done

    if [ "$FIRST_TIME" = 1 ]; then
      # ── FIRST-TIME SETUP — install the DELIVERED unit/route/rights (the receiver erzeugt nichts) ──
      log "Erstinstallation of '$REPO' — no unit '${UNIT_NAME}.service' on this host; installing the delivered setup product"
      DELIV_UNIT="$SETUP/${UNIT_NAME}.service"
      [ -d "$SETUP" ] || die "first-time setup of '$REPO' needs a delivered setup/ in the artifact, but none was shipped — the build did not attach the unit (a change without its delivery is a failure)" 10
      [ -f "$DELIV_UNIT" ] || die "first-time setup of '$REPO' has no delivered unit at $DELIV_UNIT" 10

      # The delivered unit is NOT trusted blindly (the same three gates devlab-install applies):
      #  1) the service account NAME must pass the service grammar + namespace (setup_valid_repo_shape);
      #     the reserved-identity list is judged by the shared gate above — which for a first-time setup
      #     ADMITS a reserved name only when nothing under it exists on this host (setup_reserved_name_free)
      #     and otherwise refuses it — so it is not re-checked here;
      #  2) the unit must run as its OWN account — exactly `User=<repo>`, never root, never something else;
      #  3) systemd must not already know a FOREIGN unit under this name (checked above — frag was empty).
      # The unit's own NAME may diverge from <repo> (validated lexically above); the account may not.
      setup_valid_repo_shape "$REPO" || die "refusing first-time setup of '$REPO' (name/namespace)" 2
      setup_unit_declares_user "$DELIV_UNIT" "$REPO" \
        || die "delivered unit $DELIV_UNIT does not run as 'User=$REPO' — refusing (a unit that starts something else or runs as root is not installed)" 2

      DELIV_ROUTE="$SETUP/${REPO}.caddy"
      DELIV_RIGHTS="$SETUP/${REPO}.json"

      if [ "$CHECK" = 1 ]; then
        echo "PLAN: Erstinstallation of '$REPO' (no unit ${UNIT_NAME}.service on this host)"
        echo "PLAN: create nologin system account '$REPO' (home /var/lib/$REPO) if missing"
        plan_program
        echo "PLAN: install delivered unit $DELIV_UNIT -> $UNIT_FILE (verified User=$REPO)"
        [ -f "$DELIV_ROUTE" ] && echo "PLAN: install delivered route $DELIV_ROUTE -> $CADDY_CONF/$REPO.caddy (caddy validate + reload; unwind on failure)" \
                              || echo "PLAN: no delivered route in the artifact — none installed"
        [ -f "$DELIV_RIGHTS" ] && echo "PLAN: install delivered rights $DELIV_RIGHTS -> $PERMS_DIR/$REPO.json + groupadd its hp_* groups" \
                               || echo "PLAN: no delivered rights in the artifact — installed without declared rights"
        setup_plan_secrets "$DELIV_UNIT"
        echo "PLAN: $SYSTEMCTL daemon-reload && $SYSTEMCTL enable $UNIT_NAME && $SYSTEMCTL start $UNIT_NAME"
        prove_running "$UNIT_NAME" "$(setup_unit_listen_port "$DELIV_UNIT")"
        echo "PLAN: prod deploy of '$REPO' done (first-time setup)"
        exit 0
      fi

      setup_ensure_account "$REPO"
      install_program
      install -o root -g root -m 0644 "$DELIV_UNIT" "$UNIT_FILE"

      # The route dir is SHARED by every service of the host (setup_install_route validates the ASSEMBLED
      # config and takes OUR file — plus the freshly written unit — back out on failure). A delivered
      # route is optional; its failure is NAMED, never swallowed.
      if [ -f "$DELIV_ROUTE" ] && [ -d "$CADDY_CONF" ]; then
        rc=0; reason="$(setup_install_route "$DELIV_ROUTE" "$CADDY_CONF/$REPO.caddy" "$CADDY_BIN" "$CADDY_MAIN" "$SYSTEMCTL" "$UNIT_FILE" 2>&1)" || rc=$?
        [ "$rc" = 0 ] || die "$reason" "$rc"
      elif [ -f "$DELIV_ROUTE" ]; then
        log "no route dir at $CADDY_CONF — delivered route NOT installed"
      fi

      # Rights manifest: a validated FILE COPY of the delivered manifest (never executed).
      if [ -f "$DELIV_RIGHTS" ]; then
        setup_install_rights "$DELIV_RIGHTS" "$PERMS_DIR" "$REPO"
      else
        log "no delivered rights for '$REPO' — installed without declared rights"
      fi

      # Mint the host's instance secrets from what the delivered unit demands, BEFORE the first start —
      # otherwise the service comes up and dies on the missing secret, and the gate below (correctly)
      # fails the delivery. Secrets are minted on THIS host and never transported.
      ensure_secrets_for "$REPO" "$UNIT_FILE"

      "$SYSTEMCTL" daemon-reload
      "$SYSTEMCTL" enable "$UNIT_NAME" >/dev/null 2>&1 || true
      "$SYSTEMCTL" start "$UNIT_NAME"
      prove_running "$UNIT_NAME" "$(setup_unit_listen_port "$UNIT_FILE")"
    else
      # ── UPDATE — the unit already exists: replace the program and restart (today's behaviour) ──
      log "Aktualisierung of '$REPO' — unit '${UNIT_NAME}.service' already present; replacing the program and restarting"
      if [ "$CHECK" = 1 ]; then plan_program; else install_program; fi
      # Self-heal a host set up before secrets were minted: ensure them (idempotent) before restart, so
      # an update of a service that has been looping on a missing secret can finally stay up.
      ensure_secrets_for "$REPO" "$UNIT_FILE"
      run "$SYSTEMCTL" restart "$UNIT_NAME"
      prove_running "$UNIT_NAME" "$(setup_unit_listen_port "$UNIT_FILE")"
    fi
    ;;
esac

log "prod deploy of '$REPO' done"

#!/usr/bin/env bash
# devlab-deploy-recv — VPS-side INSTALL-ONLY receiver for prod deploys. It is the forced command
# behind the root-held deploy key: the dev box ships a PREBUILT artifact here and then triggers an
# install. THIS HOST NEVER BUILDS (no go, no npm) — prod runs only prebuilt bytes.
#
# authorized_keys line (root's ~/.ssh/authorized_keys on the VPS — ONE logical line; the leading
# option list is what turns a normal key into a locked-down deploy key):
#
#   command="/usr/local/sbin/devlab-deploy-recv",restrict ssh-ed25519 AAAA...devkey... devlab-prod-deploy
#
# You do NOT transcribe this line by hand: `devlab-install-recv --provision --deploy-pubkey <pubkey>`
# writes it (and stands up rrsync, the staging/web roots and the Caddy edge) in one self-checking pass.
#
#   `restrict` = no-agent-forwarding,no-port-forwarding,no-pty,no-user-rc,no-X11-forwarding (and any
#   future restrictions). Combined with command="…" it means: whatever the client asks for, sshd runs
#   ONLY this script. The client's requested command arrives in $SSH_ORIGINAL_COMMAND (no argv).
#
# This script permits EXACTLY two operations, both confined to staging/prod, and rejects all else:
#   1. rsync receive   -> delegated to rrsync, which confines every path in the rsync request under
#      the staging root and allows ONLY writes (-wo). This is how the prebuilt bytes arrive; it is
#      impossible to write outside <STAGING_ROOT> or to read anything back.
#   2. install <repo>  -> copy the staged prebuilt artifact into prod paths + restart the prod unit.
#      When the unit does NOT yet exist, this is a FIRST-TIME setup: the unit/route/rights that TRAVELLED
#      IN THE ARTIFACT (staged under <repo>/setup/, produced by the one devlab-install template) are
#      installed, the service account is created, systemd is reloaded, the unit enabled and started.
#      The receiver ERZEUGT nichts — it INSTALLS what was delivered, guarded by the SAME name/namespace/
#      identity rules devlab-install applies (shared via devlab-setup-lib.sh).
# So even a COMPROMISED dev key can only push files into staging and (re)install a KNOWN repo — never
# run an arbitrary command as this host's ssh user, never escape the staging/prod paths.
#
# A --check dry-run (direct invocation, no ssh) runs the FIRST-TIME-vs-UPDATE decision and the setup
# validations WITHOUT root and WITHOUT effect, so the install logic is provable off the production host.
#
# Exit codes: 0 ok · 2 bad/blocked request or setup validation · 3 no staged artifact / no mapping ·
#             4 external tool failed (caddy) · 5 rrsync missing / foreign unit / missing setup library ·
#             10 staged input missing · 11 unit did not come up after start.
#
# Install/refresh (on the VPS) with the ONE self-checking script beside this file — it installs this
# receiver AND the shared library together, backs up what it replaces, proves the result, and can
# bring already-staged services up in the same pass (Handarbeit kommt als Skript):
#   sudo /path/to/deploy/devlab-install-recv [service ...]
# This receiver cannot deliver itself: the deploy key behind it is a forced command limited to
# rsync-into-staging and install-trigger, so a new receiver version reaches this host only through
# that operator script (backend/internal/deploy/wrappers.go — selfWrappers deliberately excludes it).
set -euo pipefail

# The ONE state-root derivation shared by every DevLab wrapper (devlab-install, devlab-exec,
# devlab-mkworkspace carry it verbatim): every path this receiver touches DERIVES from the state root,
# so an instance with a different root does not end up with a receiver staging in one place and a
# daemon serving from another. This host has no per-user workspaces — it is install-only — so what it
# derives are the staging root the forced command receives into and the web root it serves from
# (mirroring statepath.Www()).
#
# The overrides are a DIRECT-INVOCATION seam, never an input of the forced command: sshd hands the
# client no environment (AcceptEnv does not list these names, and the key's `restrict` option disables
# user-rc), so a client cannot move the staging boundary it is confined to.
STATE_DIR="${DEVLAB_STATE_DIR:-/var/lib/devlab}"
STAGING_ROOT="${DEVLAB_STAGING:-$STATE_DIR/staging}"
WWW_DIR="${DEVLAB_STATIC_DIR:-$STATE_DIR/www}"

# The system paths a first-time setup writes into, and the tools it asks. Instance-neutral defaults of
# this template; the env overrides are the direct-invocation test seam (sshd strips the client's env).
UNIT_DIR="${DEVLAB_UNIT_DIR:-/etc/systemd/system}"
CADDY_CONF="${DEVLAB_CADDY_CONF:-/etc/caddy/conf.d}"
CADDY_MAIN="${DEVLAB_CADDY_MAIN:-/etc/caddy/Caddyfile}"
CADDY_BIN="${DEVLAB_CADDY_BIN:-caddy}"
PERMS_DIR="${DEVLAB_HOLISTIC_PERMS:-/etc/holistic/permissions.d}"
# systemd is the authority on which units exist — asked through this binary so the question is
# answerable in a dry run (the seam is stripped by sshd in production).
SYSTEMCTL="${DEVLAB_SYSTEMCTL:-systemctl}"

log() { logger -t devlab-deploy-recv -- "$*" 2>/dev/null || true; echo "devlab-deploy-recv: $*" >&2; }
die() { log "$1"; exit "${2:-2}"; }

# --check dry-run: FIRST arg is the flag; direct invocation only (the forced command never sets it).
CHECK=0
if [ "${1:-}" = "--check" ]; then CHECK=1; shift; fi

# run — execute for real, or record the decision as a PLAN line in --check mode (mirrors devlab-install).
run() {
  if [ "$CHECK" = 1 ]; then echo "PLAN: $*"; return 0; fi
  "$@"
}

# The honest running gate (F10), executed HERE on the production host — the SAME proof the dev
# delivery uses (deploy.VerifyRunning), just run on the target: "installed and started" is reported
# only once the unit is genuinely ACTIVE. A restart is not a start; a unit that installs but does not
# come up is a FAILED production delivery, and this receiver exits non-zero so the sending side sees
# it (WHAT-2). It polls for up to ~15s, matching the dev gate's window. Exit code 11 = did not come up.
# In --check it never runs (nothing was started) — the plan names it instead.
prove_running() {
  local unit="$1" deadline=$((SECONDS + 15))
  if [ "$CHECK" = 1 ]; then echo "PLAN: prove '$unit' is active (F10), else fail the delivery"; return 0; fi
  while :; do
    if "$SYSTEMCTL" is-active --quiet "$unit"; then log "prod gate: unit '$unit' is active"; return 0; fi
    (( SECONDS >= deadline )) && die "prod gate: unit '$unit' is NOT active after start — delivery failed" 11
    sleep 1
  done
}

mkdir -p "$STAGING_ROOT"

# ── operation 1: rsync receive (the prebuilt upload) ──────────────────────────────────────────────
# Match only an rsync SERVER receive; hand it to rrsync locked to the staging root. rrsync (shipped
# with rsync) rejects absolute paths, '..', and any non-receive mode, so the client can write ONLY
# under <STAGING_ROOT>/<its-chosen-subdir>. Skipped in --check (no ssh command in a dry run).
if [ "$CHECK" = 0 ]; then
  CMD="${SSH_ORIGINAL_COMMAND:-$*}"
  case "$CMD" in
    rsync\ --server\ *)
      rrsync=""
      for c in rrsync /usr/bin/rrsync /usr/share/rsync/scripts/rrsync /usr/lib/rsync/rrsync; do
        p="$(command -v "$c" 2>/dev/null || true)"; [[ -n "$p" ]] && { rrsync="$p"; break; }
      done
      [[ -n "$rrsync" ]] || die "rrsync not found; cannot confine rsync receive" 5
      exec "$rrsync" -wo "$STAGING_ROOT"
      ;;
  esac

  # ── operation 2: install trigger — "[devlab-deploy-recv] <repo>" ───────────────────────────────
  # Disable globbing before word-splitting the (untrusted) command so a '*' cannot expand to filenames.
  set -f
  # shellcheck disable=SC2086
  set -- $CMD
  set +f
  case "${1:-}" in devlab-deploy-recv|*/devlab-deploy-recv) shift ;; esac
  [[ $# -le 1 ]] || die "unexpected extra arguments" 2
fi
REPO="${1:-}"

# The repo name must be path-safe under staging (charset + no traversal). The STRICTER service-name
# grammar (setup_valid_repo_name) is applied only where it decides an identity — first-time setup below.
{ [[ "$REPO" =~ ^[A-Za-z0-9._-]+$ ]] && [[ "$REPO" != *..* ]]; } || die "invalid repo name '${REPO:-<none>}'" 2

# Resolve the staged artifact and require it stays under the staging root (defeat symlink escapes).
SRC="$STAGING_ROOT/$REPO"
real="$(realpath -e -- "$SRC" 2>/dev/null)" || die "no staged artifact for '$REPO' ($SRC)" 3
rootreal="$(realpath -e -- "$STAGING_ROOT")"
case "$real/" in "$rootreal"/*) : ;; *) die "staged path escapes staging root" 2 ;; esac

dryrun_note=""; [ "$CHECK" = 1 ] && dryrun_note=" (dry-run)"
log "install-only prod deploy of '$REPO' from $real$dryrun_note"

# The shared first-time SETUP product + rules — the SAME library devlab-install sources on the dev host,
# so the receiver INSTALLS exactly what that one template produced and applies the identical name,
# reserved-identity, foreign-unit and User= checks. Sourced HERE (an rsync receive above never needs
# it) — beside this wrapper (same sbin dir in production, same deploy/ dir in the test tree);
# DEVLAB_SETUP_LIB is the direct-invocation test seam. A missing library is a config-state failure.
SETUP_LIB="${DEVLAB_SETUP_LIB:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/devlab-setup-lib.sh}"
[ -r "$SETUP_LIB" ] || die "shared setup library not found: $SETUP_LIB (devlab-setup-lib.sh must be installed beside this receiver)" 5
# shellcheck source=/dev/null
. "$SETUP_LIB"

# Install the prebuilt artifact into concrete prod paths + unit. NO build, and no per-repo
# scripts (B-44). BOTH branches below reach the SAME first-time-vs-update-vs-foreign decision
# (setup_unit_state) and install the delivered unit/route/rights through the SAME shared helpers
# (setup_install_route / setup_install_rights) — the self repo is not a second, hand-written setup
# path, only a different LAYOUT: its daemon is named devlabd and lives in /usr/local/bin, and it
# carries a dashboard SPA served from the web root. Everything that is not forced by that layout
# falls back into the common way.
case "$REPO" in
  devlab)
    # THE ONE genuine special case, and only in its LAYOUT: the self repo's artifact is a daemon PLUS
    # a web SPA, so (1) the daemon is named devlabd and installs to /usr/local/bin/devlabd — the unit
    # is named after the daemon, not the repository — and (2) the dashboard SPA is mirrored into the
    # host web root the edge serves, not proxied to a loopback port. NOT special: the decision between
    # first-time and update, the refusal of a foreign unit, and the way the delivered unit/route/rights
    # are installed — all shared with the generic branch below. This is the parity that was missing:
    # before, devlab only ever `systemctl restart devlabd`, so on a bare host it failed "Unit not found".
    #
    # The (re)start is the EXISTING handover, never a second path: this receiver runs as the ssh forced
    # command, a separate root process from devlabd, so `systemctl start/restart devlabd` drives the
    # (re)start from OUTSIDE the daemon's own process — nothing restarts inline. That one handover
    # serves both the first-time start and the update restart.
    SELF_UNIT="devlabd"
    BIN="$real/${SELF_UNIT}"; WEB="$real/web"
    [[ -f "$BIN" ]] || die "staged self binary missing: $BIN" 10
    [[ -d "$WEB" ]] || die "staged self web dir missing:  $WEB" 10

    UNIT_FILE="$UNIT_DIR/${SELF_UNIT}.service"
    state="$(setup_unit_state "$SELF_UNIT" "$UNIT_DIR" "$SYSTEMCTL")"
    case "$state" in
      first)     FIRST_TIME=1 ;;
      update)    FIRST_TIME=0 ;;
      foreign:*) die "unit ${SELF_UNIT}.service already exists outside this receiver's control (${state#foreign:}) — refusing to shadow or overwrite a foreign unit" 5 ;;
      *)         die "could not determine the state of ${SELF_UNIT}.service" 4 ;;
    esac

    if [ "$FIRST_TIME" = 1 ]; then
      # ── FIRST-TIME SETUP — install the DELIVERED unit/route/rights (the receiver erzeugt nichts) ──
      log "Erstinstallation of 'devlab' — no ${SELF_UNIT} unit on this host; installing the delivered setup product"
      SETUP="$real/setup"
      DELIV_UNIT="$SETUP/${SELF_UNIT}.service"
      [ -d "$SETUP" ] || die "first-time setup of 'devlab' needs a delivered setup/ in the artifact, but none was shipped — the build did not attach the unit (a change without its delivery is a failure)" 10
      [ -f "$DELIV_UNIT" ] || die "first-time setup of 'devlab' has no delivered unit at $DELIV_UNIT" 10
      # The delivered unit must run as its OWN account (User=devlab) — the same gate the generic branch
      # applies; a unit that starts something else or runs as root is never installed.
      setup_unit_declares_user "$DELIV_UNIT" "devlab" \
        || die "delivered unit $DELIV_UNIT does not run as 'User=devlab' — refusing (a unit that starts something else or runs as root is not installed)" 2

      DELIV_ROUTE="$SETUP/devlab.caddy"
      DELIV_RIGHTS="$SETUP/devlab.json"

      if [ "$CHECK" = 1 ]; then
        echo "PLAN: Erstinstallation of 'devlab' (no ${SELF_UNIT} unit on this host)"
        echo "PLAN: create nologin system account 'devlab' (home /var/lib/devlab) if missing; add it to group 'holistic' when that group exists"
        echo "PLAN: install self binary $BIN -> /usr/local/bin/${SELF_UNIT}"
        echo "PLAN: mirror web SPA $WEB -> $WWW_DIR (the dashboard the edge serves)"
        echo "PLAN: install delivered unit $DELIV_UNIT -> $UNIT_FILE (verified User=devlab)"
        [ -f "$DELIV_ROUTE" ] && echo "PLAN: install delivered route $DELIV_ROUTE -> $CADDY_CONF/devlab.caddy (caddy validate + reload; unwind on failure)" \
                              || echo "PLAN: no delivered route in the artifact — none installed"
        [ -f "$DELIV_RIGHTS" ] && echo "PLAN: install delivered rights $DELIV_RIGHTS -> $PERMS_DIR/devlab.json + groupadd its hp_* groups" \
                               || echo "PLAN: no delivered rights in the artifact — installed without declared rights"
        echo "PLAN: $SYSTEMCTL daemon-reload && $SYSTEMCTL enable ${SELF_UNIT} && $SYSTEMCTL start ${SELF_UNIT} (the existing handover restart, driven from outside the daemon)"
        prove_running "$SELF_UNIT"
        echo "PLAN: prod deploy of 'devlab' done (first-time setup)"
        exit 0
      fi

      setup_ensure_account "devlab"
      # devlabd reads the landscape's shared session secret through the 'holistic' group
      # (SupplementaryGroups=holistic in its unit). Join it when the landscape has provisioned that
      # group; warn otherwise — exactly as the interactive `service setup` does. The 'holistic' group is
      # a landscape prerequisite, not this receiver's to invent (Keine Instanz-Spezifika).
      if getent group holistic >/dev/null 2>&1; then
        usermod -aG holistic devlab || true
      else
        log "group 'holistic' is missing — devlabd cannot read the shared session secret until the landscape provides it"
      fi

      install -o root -g root -m 0755 "$BIN" "/usr/local/bin/${SELF_UNIT}"
      mkdir -p "$WWW_DIR"
      rsync -a --delete "$WEB"/ "$WWW_DIR"/
      install -o root -g root -m 0644 "$DELIV_UNIT" "$UNIT_FILE"

      # Route + rights: the SAME shared helpers the generic branch uses (no second copy of the
      # shared-edge validate/unwind or the rights grep+groupadd). A delivered route is optional; a
      # missing route DIR is logged and the install continues, any harder failure unwinds and exits.
      if [ -f "$DELIV_ROUTE" ]; then
        rc=0
        setup_install_route "$DELIV_ROUTE" "$CADDY_CONF/devlab.caddy" "$CADDY_CONF" "$CADDY_BIN" "$CADDY_MAIN" "$SYSTEMCTL" "$UNIT_FILE" || rc=$?
        case "$rc" in
          0) : ;;
          2) log "no route dir at $CADDY_CONF — delivered route NOT installed" ;;
          *) exit "$rc" ;;
        esac
      fi
      if [ -f "$DELIV_RIGHTS" ]; then
        setup_install_rights "$DELIV_RIGHTS" "$PERMS_DIR" "devlab"
      else
        log "no delivered rights for 'devlab' — installed without declared rights"
      fi

      "$SYSTEMCTL" daemon-reload
      "$SYSTEMCTL" enable "$SELF_UNIT" >/dev/null 2>&1 || true
      "$SYSTEMCTL" start "$SELF_UNIT"
      prove_running "$SELF_UNIT"
    else
      # ── UPDATE — the unit already exists: replace program + web and hand the restart to systemd ──
      log "Aktualisierung of 'devlab' — ${SELF_UNIT} already present; replacing the program + web and restarting"
      run install -o root -g root -m 0755 "$BIN" "/usr/local/bin/${SELF_UNIT}"
      run mkdir -p "$WWW_DIR"
      run rsync -a --delete "$WEB"/ "$WWW_DIR"/
      run "$SYSTEMCTL" restart "$SELF_UNIT"
      prove_running "$SELF_UNIT"
    fi
    ;;
  *)
    # Uniform Holistic Go service: the artifact holds <repo>d (go build ./cmd/... → cmd/<repo>d). Install
    # to /opt/<repo>/bin/<repo>d. <repo> is already charset+traversal validated above, so the derived
    # paths are bounded.
    gbin="$real/${REPO}d"
    [[ -f "$gbin" ]] || die "staged binary missing: $gbin (expected <repo>d)" 10

    # FIRST-TIME vs UPDATE vs FOREIGN is the shared judgement (setup_unit_state), asked of systemd and
    # not of a path: a vendor unit under /lib or /usr/lib is seen and REFUSED, never silently shadowed.
    UNIT_FILE="$UNIT_DIR/${REPO}.service"
    state="$(setup_unit_state "$REPO" "$UNIT_DIR" "$SYSTEMCTL")"
    case "$state" in
      first)     FIRST_TIME=1 ;;
      update)    FIRST_TIME=0 ;;
      foreign:*) die "unit ${REPO}.service already exists outside this receiver's control (${state#foreign:}) — refusing to shadow or overwrite a foreign unit" 5 ;;
      *)         die "could not determine the state of ${REPO}.service" 4 ;;
    esac

    if [ "$FIRST_TIME" = 1 ]; then
      # ── FIRST-TIME SETUP — install the DELIVERED unit/route/rights (the receiver erzeugt nichts) ──
      log "Erstinstallation of '$REPO' — no unit on this host; installing the delivered setup product"
      SETUP="$real/setup"
      DELIV_UNIT="$SETUP/${REPO}.service"
      [ -d "$SETUP" ] || die "first-time setup of '$REPO' needs a delivered setup/ in the artifact, but none was shipped — the build did not attach the unit (a change without its delivery is a failure)" 10
      [ -f "$DELIV_UNIT" ] || die "first-time setup of '$REPO' has no delivered unit at $DELIV_UNIT" 10

      # The delivered unit is NOT trusted blindly (the same three gates devlab-install applies):
      #  1) the NAME must pass the service grammar + reserved-identity list (shared rule);
      #  2) the unit must run as its OWN account — exactly `User=<repo>`, never root, never something else;
      #  3) systemd must not already know a FOREIGN unit under this name (checked above by setup_unit_state).
      setup_valid_repo_name "$REPO" || die "refusing first-time setup of '$REPO' (name/namespace)" 2
      setup_unit_declares_user "$DELIV_UNIT" "$REPO" \
        || die "delivered unit $DELIV_UNIT does not run as 'User=$REPO' — refusing (a unit that starts something else or runs as root is not installed)" 2

      DELIV_ROUTE="$SETUP/${REPO}.caddy"
      DELIV_RIGHTS="$SETUP/${REPO}.json"

      if [ "$CHECK" = 1 ]; then
        echo "PLAN: Erstinstallation of '$REPO' (no unit on this host)"
        echo "PLAN: create nologin system account '$REPO' (home /var/lib/$REPO) if missing"
        echo "PLAN: install binary $gbin -> /opt/$REPO/bin/${REPO}d"
        echo "PLAN: install delivered unit $DELIV_UNIT -> $UNIT_FILE (verified User=$REPO)"
        [ -f "$DELIV_ROUTE" ] && echo "PLAN: install delivered route $DELIV_ROUTE -> $CADDY_CONF/$REPO.caddy (caddy validate + reload; unwind on failure)" \
                              || echo "PLAN: no delivered route in the artifact — none installed"
        [ -f "$DELIV_RIGHTS" ] && echo "PLAN: install delivered rights $DELIV_RIGHTS -> $PERMS_DIR/$REPO.json + groupadd its hp_* groups" \
                               || echo "PLAN: no delivered rights in the artifact — installed without declared rights"
        echo "PLAN: $SYSTEMCTL daemon-reload && $SYSTEMCTL enable $REPO && $SYSTEMCTL start $REPO"
        prove_running "$REPO"
        echo "PLAN: prod deploy of '$REPO' done (first-time setup)"
        exit 0
      fi

      setup_ensure_account "$REPO"
      install -d -o root -g root -m 0755 "/opt/$REPO/bin"
      install -o root -g root -m 0755 "$gbin" "/opt/$REPO/bin/${REPO}d"
      install -o root -g root -m 0644 "$DELIV_UNIT" "$UNIT_FILE"

      if [ -f "$DELIV_ROUTE" ]; then
        rc=0
        setup_install_route "$DELIV_ROUTE" "$CADDY_CONF/$REPO.caddy" "$CADDY_CONF" "$CADDY_BIN" "$CADDY_MAIN" "$SYSTEMCTL" "$UNIT_FILE" || rc=$?
        case "$rc" in
          0) : ;;
          2) log "no route dir at $CADDY_CONF — delivered route NOT installed" ;;
          *) exit "$rc" ;;
        esac
      fi
      if [ -f "$DELIV_RIGHTS" ]; then
        setup_install_rights "$DELIV_RIGHTS" "$PERMS_DIR" "$REPO"
      else
        log "no delivered rights for '$REPO' — installed without declared rights"
      fi

      "$SYSTEMCTL" daemon-reload
      "$SYSTEMCTL" enable "$REPO" >/dev/null 2>&1 || true
      "$SYSTEMCTL" start "$REPO"
      prove_running "$REPO"
    else
      # ── UPDATE — the unit already exists: replace the program and restart (today's behaviour) ──
      log "Aktualisierung of '$REPO' — unit already present; replacing the program and restarting"
      run install -d -o root -g root -m 0755 "/opt/$REPO/bin"
      run install -o root -g root -m 0755 "$gbin" "/opt/$REPO/bin/${REPO}d"
      run "$SYSTEMCTL" restart "$REPO"
      prove_running "$REPO"
    fi
    ;;
esac

log "prod deploy of '$REPO' done"

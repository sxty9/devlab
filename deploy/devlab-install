#!/usr/bin/env bash
# devlab-install — the generic, install-only root wrapper (S11; replaces the retired
# per-repo devlab-deploy mechanics, B-44). Invoked ONLY via the pinned sudoers grant:
#     sudo -n /usr/local/sbin/devlab-install <repo> <artifact-dir> <env> [--port <n>] [--handover] [--check]
#     sudo -n /usr/local/sbin/devlab-install --renew-wrapper <name> <content-file> <grant-file>
# The second form is the WRITE half of the root-wrapper renewal — the ONE path that writes
# /usr/local/sbin, gated by merged content + a single-use user approval it re-verifies itself
# (see the "renew ONE root wrapper" block below and backend/internal/deploy/wrapperrenew.go).
# It installs BOTH halves a service needs — its program (binary/unit/route/rights) AND its dashboard
# UI — so a green delivery never stands over a half-installed service.
#
# Contract:
#   * name grammar: <repo> must match ^[a-z][a-z0-9-]{2,30}$ — nothing else ever reaches a path
#   * NAMESPACE (the grammar alone is not one — `root`, `caddy`, `sshd` and `postgres` all satisfy
#     it, and the generated unit carries `User=<repo>`, so a repository called `root` would have
#     run its own artifact as uid 0). EVERY name is measured, the SELF repo included — it is the
#     most privileged one, and exempting it would have let any checkout's artifact be installed as
#     this service's own binary. Every repository must
#       – not be a reserved OS or third-party-package identity (RESERVED_REPOS below),
#       – be the RUNNER'S STAGED ARTIFACT of the checkout that carries this name:
#         <workspaces>/<user>/<repo>/.mercury-artifact and nothing else,
#       – belong to the configured organisation (the checkout's origin remote, read as text — git
#         is never RUN on repo content as root),
#     and a FOREIGN repository additionally must
#       – be unknown to systemd or known ONLY through this wrapper's own unit file: existence is
#         asked of `systemctl show -p FragmentPath`, not of a path, so a vendor unit under
#         /lib|/usr/lib (or a masked one) is SEEN and refused instead of being shadowed,
#       – own its service account WHERE THAT IS DECIDED HERE: at first-time setup, which runs
#         `useradd` and generates `User=<repo>`, an existing account must be the nologin system
#         account under /var/lib/<repo> this wrapper creates. On an UPDATE of an already installed
#         service the unit is root-owned and its `User=` was settled when it was written, so there
#         is no identity to adopt. A landscape may well run a service whose account legitimately
#         predates DevLab — a `mail` service running as the OS `mail` account — and judging that here
#         made it permanently undeliverable.
#   * path canonicalization: <artifact-dir> resolves via `realpath -e` and MUST lie under the
#     workspace root; a traversal (…/../../tmp/evil) dies before any effect
#   * env is exactly `dev` or `prod` (prod is NOT armed in this phase — it dies)
#   * install-only for the SERVICE artifact: root copies the validated program + rights and restarts
#     the unit; root NEVER builds and NEVER executes the service's own repo code (E §7.4)
#   * the service UI (a staged ui/ in the artifact) is wired into the instance's holistic dashboard
#     (<holistic>/<frontend>/external/<repo>), the SHARED dashboard is rebuilt AS THE CHECKOUT OWNER
#     (never as root — the same "root never builds" rule as the program half; runuser drops privilege
#     so no root-owned file is left in the operator's checkout), and the freshly built bundle is then
#     DELIVERED to the serve root the browser fetches from (DEVLAB_HOLISTIC_WWW). `built` is reported
#     ONLY once the bundle has arrived there — a rebuilt-but-undelivered dashboard is a failure, not
#     green (the browser would keep serving the old bundle). The dashboard path and serve root are
#     instance configuration (DEVLAB_HOLISTIC_REPO / DEVLAB_HOLISTIC_WWW / root-owned files); absent
#     dashboard config is a NAMED deficiency, never a silent skip. The half's outcome is reported on a
#     single `MERCURY-UI: <none|built|unconfigured|failed|foreign-blocked|planned|would-fail>` line
#     (would-fail is --check-only: the dry-run predicts the relocation would carry an outside-tree config
#     into the dashboard and break the build — a regression guard, never a production outcome)
#   * first-time setup of template-conforming services generates unit/route/rights from
#     root-owned INLINE templates with validated values (port via the atlas proposal, --port)
#   * --handover (self-repo only): install + `systemd-run --unit=devlab-restart-<ts> --collect
#     /usr/local/sbin/devlab-restart-when-free` in ONE call (B-2). devlabd itself never runs
#     systemd-run; a failed systemd-run fails the stage — there is NO inline restart (K-2)
#   * --check: dry-run — run the FULL validation cascade, print the decision as PLAN lines,
#     change nothing (the testable seam; wrapper logic is verified without root)
#
# Instance values (state dir, workspace root, self unit) are env-overridable DEFAULTS of this
# template; under the pinned sudoers grant sudo's env_reset strips the caller's env, so the
# defaults stand in production and the overrides remain a direct-invocation test seam. The
# organisation is NOT among them: it is read from a root-owned file, because the caller must not be
# able to widen the namespace it is being measured against.
#
# Exit codes: 0 ok · 1 generic · 2 usage/validation · 4 external tool failed · 5 config-state
set -euo pipefail

# The ONE state-root derivation shared by every DevLab wrapper, mirroring statepath.Workspaces():
# workspaces live at <state root>/workspaces. Keep this identical in devlab-exec.
STATE_DIR="${DEVLAB_STATE_DIR:-/var/lib/devlab}"
WORKSPACES_ROOT="${DEVLAB_WORKSPACES:-$STATE_DIR/workspaces}"
SELF_REPO="${DEVLAB_SELF_REPO:-devlab}"
SELF_UNIT="${DEVLAB_UNIT:-devlabd}"
CADDY_CONF="${DEVLAB_CADDY_CONF:-/etc/caddy/conf.d}"
# The edge's assembled configuration, validated before a route of ours is adopted (see the route
# step). Instance-neutral defaults of this template, like every value above.
CADDY_MAIN="${DEVLAB_CADDY_MAIN:-/etc/caddy/Caddyfile}"
CADDY_BIN="${DEVLAB_CADDY_BIN:-caddy}"
PERMS_DIR="${DEVLAB_HOLISTIC_PERMS:-/etc/holistic/permissions.d}"
# The holistic dashboard checkout a service UI is wired into. Its path is INSTANCE-SPECIFIC (the axiom
# "Keine Instanz-Spezifika" forbids it as a literal in the repo), so it comes from runtime configuration
# exactly like PERMS_DIR: an env override for the direct-invocation test seam, otherwise a root-owned
# file. There is NO built-in default path — an unconfigured instance is a NAMED state, never a silent
# skip of the UI half. FRONTEND is the dashboard's web subtree that carries external/<id>.
HOLISTIC_REPO="${DEVLAB_HOLISTIC_REPO:-}"
HOLISTIC_REPO_FILE="${DEVLAB_HOLISTIC_REPO_FILE:-/etc/devlab/holistic-repo}"
HOLISTIC_FRONTEND="${DEVLAB_HOLISTIC_FRONTEND:-frontend}"
# WHERE THE BROWSER FETCHES THE DASHBOARD FROM — the serve root the edge exposes (Caddy: `root *
# <www>`). Building the dashboard is only half the delivery: "delivered" means the freshly built
# bundle sits HERE, where the browser reads it, not merely in the checkout's build output. This is
# an instance value like every path above (the served tree is `/opt/<product>/www` by the holistic
# convention, holding no user- or machine-specific segment), so it is an env-overridable DEFAULT
# with a root-owned file seam — never asked of the caller. HOLISTIC_DIST is the built-SPA subtree
# the dashboard's own build writes under <frontend> (holistic emits `app/dist`).
HOLISTIC_WWW="${DEVLAB_HOLISTIC_WWW:-}"
HOLISTIC_WWW_FILE="${DEVLAB_HOLISTIC_WWW_FILE:-/etc/devlab/holistic-www}"
HOLISTIC_WWW_DEFAULT="/opt/holistic/www"
HOLISTIC_DIST="${DEVLAB_HOLISTIC_DIST:-app/dist}"
RESTART_HELPER="/usr/local/sbin/devlab-restart-when-free"
# The ONE artifact directory the unprivileged per-user build produces inside a working tree
# (mirrors deploy.ArtifactDirName). Nothing else is ever installed from.
ARTIFACT_DIR_NAME=".mercury-artifact"
# systemd is the authority on which units exist — asked through this binary so the question is
# answerable in a dry run without a bus (the seam is stripped by sudo's env_reset in production).
SYSTEMCTL="${DEVLAB_SYSTEMCTL:-systemctl}"
# The unit directory this wrapper owns. A fragment ANYWHERE else belongs to somebody else. The env seam
# only ever moves the directory in a direct-invocation test (it is stripped by sudo's env_reset in
# production, like every other seam here), so it grants no privilege — it lets a test decide what unit
# already exists, exactly as devlab-deploy-recv's DEVLAB_UNIT_DIR does.
UNIT_DIR="${DEVLAB_UNIT_DIR:-/etc/systemd/system}"
# The host's account and package databases are asked through these binaries so the reserved-name gate can
# tell a genuine first install of a reserved landscape name (nothing exists under it) apart from a name
# grab (an OS account or a distro package already holds it). Seams for direct-invocation tests only —
# stripped by sudo's env_reset in production, exactly like SYSTEMCTL and UNIT_DIR — so they grant no
# privilege; they let a test decide what account/package the host carries.
GETENT="${DEVLAB_GETENT:-getent}"
DPKG="${DEVLAB_DPKG:-dpkg-query}"
# The configured organisation whose repositories may be installed: an instance value, so it lives
# in root-owned runtime configuration and never as a literal in this template.
OWNER_FILE="${DEVLAB_GH_OWNER_FILE:-/etc/devlab/gh-owner}"

# Reserved names, the first-time SETUP templates (unit/route), the service account and the identity
# checks now live in ONE sourced library, deploy/devlab-setup-lib.sh — so this wrapper (which GENERATES
# the setup on the dev host) and devlab-deploy-recv (which INSTALLS the SAME product on the production
# host) share a single source and can never drift on what a valid setup is. The list is
# SETUP_RESERVED_REPOS; the templates are setup_unit_text / setup_route_text; the account is
# setup_ensure_account. See the sourcing block below (after the renew half, which needs none of it).
#
# The RULE the list follows is unchanged: reserved is an identity that belongs to the operating system,
# to a third-party package, or to the landscape as a whole. A name the ORGANISATION can legitimately
# give a service of its own is NOT on the list even where a like-named OS account exists — what decides
# there are the identity checks (origin: is this OUR repository? unit: is the unit ours? account: are we
# about to squat an account?), not the spelling.

log() { logger -t devlab-install -- "$*" 2>/dev/null || true; echo "devlab-install: $*"; }
die() { printf 'devlab-install: error: %s\n' "$1" >&2; exit "${2:-2}"; }

CHECK=0; HANDOVER=0; PORT=0; RENEW=0
POSITIONAL=()
while [ $# -gt 0 ]; do
  case "$1" in
    --check)          CHECK=1 ;;
    --handover)       HANDOVER=1 ;;
    --renew-wrapper)  RENEW=1 ;;
    --port)           shift; PORT="${1:-}" ;;
    --*)              die "unknown flag: $1" 2 ;;
    *)                POSITIONAL+=("$1") ;;
  esac
  shift
done

# run — execute for real, or record the decision as a PLAN line in --check mode.
run() {
  if [ "$CHECK" = 1 ]; then echo "PLAN: $*"; return 0; fi
  "$@"
}

# ── the write half: renew ONE root wrapper from merged, user-approved content ─────────────────────
# Invoked ONLY by the devlab service (user `devlab`) AFTER the user explicitly approved renewing a
# named wrapper with a named checksum:
#     sudo -n /usr/local/sbin/devlab-install --renew-wrapper <name> <content-file> <grant-file>
# This is the ONE path that writes /usr/local/sbin. It re-derives EVERY check itself and trusts
# nothing the caller says (E §7.4). The list below is the authoritative one — never the call — and it
# covers EXACTLY the set the drift probe guards (selfWrappers in backend/internal/deploy/wrappers.go)
# and `service` installs: the executable wrappers (0755) AND the sourced setup library
# devlab-setup-lib.sh (0644), which both devlab-install and devlab-exec source. A stale library drifts
# a first-time setup as surely as a stale wrapper, so what the daemon can offer for approval and what
# this tool will renew must be the SAME set — otherwise a human approves renewing devlab-setup-lib.sh
# and this tool refuses it, an approval that can do nothing. Each entry carries its own INSTALL MODE
# (name:mode), because the library is installed read-only, not executable. A Go test holds this list
# against the other three (TestRenewableWrapperListsAgree) — it is no longer a comment that keeps them
# in step.
RENEWABLE="devlab-exec:0755 devlab-install:0755 devlab-mkworkspace:0755 devlab-restart-when-free:0755 devlab-setup-lib.sh:0644"
# Destination of the wrappers. Pinned; the env seam is stripped by sudo's env_reset in production
# exactly like every other seam in this wrapper, so it only ever moves the target in a direct-
# invocation test — it grants no privilege.
SBIN_DIR="${DEVLAB_SBIN_DIR:-/usr/local/sbin}"
# The tamper-evident audit: the single-use ledger + the backup of every replaced wrapper. It lives
# OUTSIDE the daemon-owned state root, root-owned, so not even the (trusted) daemon can rewrite the
# record of what root installed or what was there before (task point 5). Env seam for tests.
WRENEW_AUDIT_DIR="${DEVLAB_WRAPPER_AUDIT_DIR:-/var/lib/devlab-wrapper-audit}"

# HANDING THE WRITE OUT OF THE SERVICE'S CGROUP. The devlab service runs with ProtectSystem=strict and
# deliberately does NOT list /usr/local/sbin in its ReadWritePaths — so the service, and EVERY child it
# starts (this wrapper among them, even started root via the sudoers pin), is locked out of the very
# directory the root wrappers live in. That lock is the point: it is what stops the service from
# rewriting its own root scripts on its own, without a human's approval. But the lock also reached this
# wrapper AFTER the human approved a renewal — `mktemp` in /usr/local/sbin failed with "Read-only file
# system", so the approval installed nothing, the delivery found the drift again, and the same question
# came back: a loop the user could not win (measured 2026-08-06). The fix keeps the service locked out
# and runs the ONE approved renewal OUTSIDE the cgroup, in a transient systemd unit — the same escape the
# self-repo restart already uses (--handover). systemd-run is the seam; env-overridable for tests only,
# and stripped by sudo's env_reset in production exactly like every other seam here.
SYSTEMD_RUN="${DEVLAB_SYSTEMD_RUN:-systemd-run}"

# own_root sets root:root ownership when we ARE root (production, via sudo). In a direct-invocation
# test the tool runs as the unprivileged test user and the files stay that user's — the security
# property (root-owned) holds in production, where the tool always runs as root.
own_root() { [ "$(id -u)" -eq 0 ] && chown root:root -- "$@" || true; }

# maybe_hand_out_renewal escapes the service's ProtectSystem=strict sandbox when — and ONLY when — this
# invocation cannot write the wrapper directory. In production the devlab service starts this tool as a
# confined child (root via the sudoers pin, but inside the cgroup where /usr/local/sbin is read-only), so
# the atomic write below fails; the fix is to run the SAME renewal in a transient unit outside the cgroup,
# exactly as the self-repo restart hands its work out (see --handover). The handed-out unit runs
# unconfined as root and RE-ENTERS this very tool with the SAME arguments (the whole approval: the grant
# plus every name/content pair), so all four bindings — the renewable name, the run-unwritable source, the
# approved checksum, and single-use — are re-checked OUTSIDE the boundary; nothing the caller says is
# trusted across it. THE PATH IS DECIDED HERE, BEFORE ANY CONSUMPTION (task point 2): if the write cannot
# happen in this cgroup, the whole set is handed out up front — a doomed in-cgroup attempt that would
# touch the ledger is never made. It returns here, to run the checks and write in THIS context, when:
#   * --check: a dry run writes nothing and needs no escape;
#   * the recursion marker is set: we ARE the transient unit — do the work;
#   * the target is already writable: there is no confinement to escape (an unconfined root install, or a
#     direct-invocation test against a throwaway sbin dir).
# When the target is NOT writable it MUST escape or FAIL BY NAME — it never falls through to a write that
# would fail again, which is the silent loop the user cannot win (task points 3/4). A failed hand-out
# (systemd-run absent or the transient unit erroring) fails the renewal WITH the real reason, which the
# daemon surfaces as one disturbance rather than re-asking.
maybe_hand_out_renewal() {  # <grant-file> <name> <content-file> [<name> <content-file> ...]
  [ "$CHECK" = 1 ] && return 0
  [ "${DEVLAB_WRENEW_HANDED_OUT:-0}" = 1 ] && return 0
  [ -w "$SBIN_DIR" ] && return 0
  command -v "$SYSTEMD_RUN" >/dev/null 2>&1 \
    || die "cannot write $SBIN_DIR — the devlab service confines it read-only (ProtectSystem=strict) and '$SYSTEMD_RUN' is not available to hand the renewal out of the service; the approved renewal cannot be installed" 4
  local self
  self="$(readlink -f -- "${BASH_SOURCE[0]}")" || die "cannot resolve this wrapper's own path to hand the renewal out" 4
  log "cannot write $SBIN_DIR from inside the service (ProtectSystem=strict) — handing the approved renewal out to a transient unit outside the cgroup (like the self-repo restart)"
  # --wait: block and adopt the unit's exit status · --pipe: forward the unit's output back to the daemon
  # that invoked us · --collect: reap the unit even on failure. --setenv carries the recursion marker and
  # the already-resolved (pinned) paths so the transient unit measures the identical state. The FULL
  # argument list of this renewal follows `--`, so the transient unit renews the same set in one atomic
  # pass. A non-zero exit propagates out of this wrapper: the renewal fails with the transient unit's
  # real reason.
  "$SYSTEMD_RUN" --quiet --wait --pipe --collect \
    --unit="devlab-wrapper-renew-$(date -u +%Y%m%dT%H%M%SZ)-$$" \
    --setenv=DEVLAB_WRENEW_HANDED_OUT=1 \
    --setenv="DEVLAB_STATE_DIR=$STATE_DIR" \
    --setenv="DEVLAB_SBIN_DIR=$SBIN_DIR" \
    --setenv="DEVLAB_WRAPPER_AUDIT_DIR=$WRENEW_AUDIT_DIR" \
    -- "$self" --renew-wrapper "$@"
  exit $?
}

# renew_wrapper installs ONE approval — which may cover SEVERAL wrapper files — as ONE UNIT: either every
# named file lands, or none does (task point 4). One approval is one single-use, redeemed exactly once
# (task point 3): the old per-file design called this tool once per file with the SAME approvalId, so the
# first file's ledger entry made every later file of the same approval read as "already used" and the
# renewal stopped half-done (the 2026-08-08 defect). The call now carries the whole set — one combined
# grant (approvalId + who/when + one approved checksum per name) followed by <name> <content-file> pairs —
# and the ledger is touched ONCE, after all files are committed. A dry run or an attempt that writes
# nothing (a checksum mismatch, a read-only target that is handed out, a rolled-back commit) leaves the
# approval UNCONSUMED (task point 1).
renew_wrapper() {
  # <grant-file> then an EVEN number of <name> <content-file> pairs, at least one pair.
  local argc="${#POSITIONAL[@]}"
  { [ "$argc" -ge 3 ] && [ $(( (argc - 1) % 2 )) -eq 0 ]; } \
    || die "usage: devlab-install --renew-wrapper <grant-file> <name> <content-file> [<name> <content-file> ...]" 2
  local grantf="${POSITIONAL[0]}"

  # 0) IF THE SERVICE CONFINES US OUT OF /usr/local/sbin, run this SAME renewal (the WHOLE set) outside the
  #    cgroup and exit with its result. The path is chosen BEFORE any consumption (task point 2): it returns
  #    here only when the write can happen in this context. Every check below then runs OUTSIDE the boundary
  #    too — root re-verifies, it does not trust the confined caller.
  maybe_hand_out_renewal "${POSITIONAL[@]}"

  # 1) THE GRANT MUST BE RUN-UNWRITABLE (task point 1: no file a run produced is ever a source). It must
  #    resolve under the daemon-owned state root and NOT under the run-writable workspaces subtree (the
  #    only place an agent run can write). realpath collapses '..' and every symlink.
  local troot wroot greal
  troot="$(realpath -e -- "$STATE_DIR" 2>/dev/null)" || die "state root missing: $STATE_DIR" 5
  wroot="$troot/workspaces"
  greal="$(realpath -e -- "$grantf" 2>/dev/null)" || die "grant file does not resolve: $grantf" 2
  case "$greal/" in "$troot"/*) : ;; *) die "grant '$greal' is outside the state root $troot — refusing" 2 ;; esac
  case "$greal/" in "$wroot"/*) die "grant '$greal' is under the run-writable workspaces tree — a run must not supply the approval" 2 ;; esac
  [ -f "$greal" ] || die "grant '$greal' is not a regular file" 2

  # 2) READ THE APPROVAL HEADER — the daemon rendered it from the user's explicit approval; a run cannot
  #    write here. One approval, one approvalId, one who/when. The per-name approved checksums follow as
  #    `sha256 <name> <sha>` lines and are looked up per file below.
  local g_id g_by g_at
  g_id="$(sed -n 's/^approvalId=//p' "$greal" | head -n1)"
  g_by="$(sed -n 's/^approvedBy=//p' "$greal" | head -n1)"
  g_at="$(sed -n 's/^approvedAt=//p' "$greal" | head -n1)"
  [ -n "$g_id" ] || die "grant is incomplete (need approvalId)" 2
  [[ "$g_id" =~ ^[A-Za-z0-9_.:-]{1,128}$ ]] || die "grant approvalId has an unexpected shape: $g_id" 2

  # 3) VALIDATE THE WHOLE SET FIRST — every name, source and checksum — before ANYTHING is written. Any
  #    single failure refuses the entire approval and installs nothing (task point 4, the validation half
  #    of all-or-none). The parallel arrays carry the vetted plan into the commit stage.
  local -a v_name=() v_mode=() v_sha=() v_creal=() v_dest=() v_old=() v_backup=()
  local ts; ts="$(date -u +%Y%m%dT%H%M%SZ)"
  local i n contentf ok mode entry ename names want creal actual dest oldsha backup
  i=1
  while [ "$i" -lt "$argc" ]; do
    n="${POSITIONAL[$i]}"; contentf="${POSITIONAL[$((i + 1))]}"; i=$((i + 2))

    # 3a) THE NAME IS ON THE RENEWABLE LIST — the list lives here, not in the call (task point 4). The
    #     INSTALL MODE comes from the list too (0755 for the executable wrappers, 0644 for the sourced
    #     setup library), so a renewal never turns the read-only library into an executable.
    ok=0; mode=""; names=""
    for entry in $RENEWABLE; do
      ename="${entry%%:*}"
      names="${names:+$names }$ename"
      if [ "$n" = "$ename" ]; then ok=1; mode="${entry##*:}"; fi
    done
    [ "$ok" = 1 ] || die "refusing '$n': not a renewable root wrapper (renewable: $names)" 2

    # 3b) THE APPROVED CHECKSUM FOR THIS NAME comes from the grant, never the call — that is what makes
    #     "approve content A, then hand content B" install nothing (task points 2/3).
    want="$(awk -v want="$n" '$1 == "sha256" && $2 == want { print $3; exit }' "$greal")"
    [ -n "$want" ] || die "grant carries no approved checksum for '$n' — refusing" 2
    [[ "$want" =~ ^[0-9a-f]{64}$ ]] || die "grant checksum for '$n' is not a sha256: $want" 2

    # 3c) THE CONTENT MUST BE RUN-UNWRITABLE under the state root, not under workspaces (task point 1).
    creal="$(realpath -e -- "$contentf" 2>/dev/null)" || die "content file for '$n' does not resolve: $contentf" 2
    case "$creal/" in "$troot"/*) : ;; *) die "source '$creal' is outside the state root $troot — refusing" 2 ;; esac
    case "$creal/" in "$wroot"/*) die "source '$creal' is under the run-writable workspaces tree — a run must not supply the content" 2 ;; esac
    [ -f "$creal" ] || die "source '$creal' is not a regular file" 2

    # 3d) THE CONTENT HASHES TO THE APPROVED CHECKSUM (task points 2/3).
    actual="$(sha256sum -- "$creal" | awk '{print $1}')"
    [ "$actual" = "$want" ] \
      || die "content checksum $actual for '$n' does not match the approved $want — refusing (the approval is for exactly one content)" 2

    # Record what is there now, so the rollback (below) and the audit ledger can name the previous stand.
    dest="$SBIN_DIR/$n"; oldsha="(absent)"; backup="none"
    if [ -f "$dest" ]; then
      oldsha="$(sha256sum -- "$dest" | awk '{print $1}')"
      backup="$WRENEW_AUDIT_DIR/backups/${n}.${ts}.${oldsha}"
    fi
    v_name+=("$n"); v_mode+=("$mode"); v_sha+=("$want"); v_creal+=("$creal")
    v_dest+=("$dest"); v_old+=("$oldsha"); v_backup+=("$backup")
  done
  [ "${#v_name[@]}" -ge 1 ] || die "no wrappers to renew" 2

  # 4) SINGLE-USE, ONCE FOR THE WHOLE APPROVAL. The root-owned ledger records the approvalId of a consumed
  #    approval; a second use of the SAME approval installs nothing (task point 3). Because the whole set
  #    is one invocation now, the ledger is read here once and written once (step 7) — the approvalId of
  #    the first file no longer poisons the rest of its own approval.
  install -d -m 0700 -- "$WRENEW_AUDIT_DIR"          || die "cannot create audit dir $WRENEW_AUDIT_DIR" 4
  install -d -m 0700 -- "$WRENEW_AUDIT_DIR/backups"  || die "cannot create backups dir" 4
  own_root "$WRENEW_AUDIT_DIR" "$WRENEW_AUDIT_DIR/backups"
  local ledger="$WRENEW_AUDIT_DIR/installed.log"
  if [ -f "$ledger" ] && grep -qF "approvalId=$g_id " "$ledger"; then
    die "approval $g_id was already used — refusing to install it a second time (single-use)" 5
  fi

  if [ "$CHECK" = 1 ]; then
    for i in "${!v_name[@]}"; do
      echo "PLAN: renew ${v_name[$i]} (mode ${v_mode[$i]}) -> ${v_sha[$i]} (approved by ${g_by:-unknown}; previous ${v_old[$i]}) from ${v_creal[$i]}"
    done
    return 0
  fi

  # 5) BACK UP every file being replaced, then STAGE a temp copy of every new file. Nothing is moved into
  #    place while any file could still fail: staging every file first is what makes the commit all-or-none
  #    (task point 4). A staging failure removes the temp files staged so far and installs nothing.
  local -a staged=()
  local tmp t
  for i in "${!v_name[@]}"; do
    if [ "${v_backup[$i]}" != none ]; then
      cp -p -- "${v_dest[$i]}" "${v_backup[$i]}" \
        || { for t in "${staged[@]}"; do rm -f -- "$t"; done; die "cannot back up the current ${v_name[$i]}" 4; }
      own_root "${v_backup[$i]}"
    fi
    tmp="$(mktemp "$SBIN_DIR/.${v_name[$i]}.XXXXXX")" \
      || { for t in "${staged[@]}"; do rm -f -- "$t"; done; die "cannot stage a temp file in $SBIN_DIR" 4; }
    cp -- "${v_creal[$i]}" "$tmp" \
      || { rm -f -- "$tmp"; for t in "${staged[@]}"; do rm -f -- "$t"; done; die "cannot write staged wrapper ${v_name[$i]}" 4; }
    chmod "${v_mode[$i]}" "$tmp"; own_root "$tmp"
    staged+=("$tmp")
  done

  # 6) COMMIT — rename each staged file over its target. rename replaces the directory entry, not the inode
  #    a running process holds open, so renewing devlab-install while THIS very invocation runs is safe. If
  #    a rename fails partway, restore the already-committed targets from their backups so the set stays
  #    all-or-none, and install nothing further (task point 4).
  local -a committed=()
  local j
  for i in "${!v_name[@]}"; do
    if mv -f -- "${staged[$i]}" "${v_dest[$i]}"; then
      committed+=("$i")
    else
      for j in "${committed[@]}"; do
        if [ "${v_backup[$j]}" != none ]; then
          cp -p -- "${v_backup[$j]}" "${v_dest[$j]}" 2>/dev/null && own_root "${v_dest[$j]}"
        else
          rm -f -- "${v_dest[$j]}"
        fi
      done
      for t in "${staged[@]}"; do rm -f -- "$t"; done
      die "cannot move the new ${v_name[$i]} into place — rolled back the whole renewal (all-or-none)" 4
    fi
  done

  # 7) APPEND THE TAMPER-EVIDENT RECORD, once for the whole approval: one line per installed file, all
  #    under the same approvalId (the single-use key, step 4). Only reached after EVERY file committed, so
  #    an approval that wrote nothing is never marked consumed (task point 1).
  local rn=""
  for i in "${!v_name[@]}"; do
    printf 'installedAt=%s approvalId=%s name=%s newSha=%s oldSha=%s approvedBy=%s approvedAt=%s backup=%s\n' \
      "$ts" "$g_id" "${v_name[$i]}" "${v_sha[$i]}" "${v_old[$i]}" "${g_by:-unknown}" "${g_at:-unknown}" "${v_backup[$i]}" \
      >> "$ledger"
    rn="${rn:+$rn }${v_name[$i]}"
  done
  chmod 0600 "$ledger"; own_root "$ledger"
  log "renewed root wrapper scripts ($rn) under approval $g_id (approved by ${g_by:-unknown})"
  echo "RENEWED: approvalId=$g_id names=$rn"
}

if [ "$RENEW" = 1 ]; then
  renew_wrapper
  exit 0
fi

# The shared first-time SETUP product + rules (unit/route templates, the reserved-name list, the
# service account, the identity checks) — sourced here, AFTER the renew half, which touches none of it,
# so renewing a wrapper never depends on this library being present. It sits beside this wrapper (the
# same sbin dir in production, the same deploy/ dir in the test tree); DEVLAB_SETUP_LIB is the direct-
# invocation test seam. A missing library is a config-state failure, never a silent skip.
SETUP_LIB="${DEVLAB_SETUP_LIB:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/devlab-setup-lib.sh}"
[ -r "$SETUP_LIB" ] || die "shared setup library not found: $SETUP_LIB (deploy/devlab-setup-lib.sh must be installed beside this wrapper)" 5
# shellcheck source=/dev/null
. "$SETUP_LIB"

# ── validation cascade (every step BEFORE any effect) ────────────────────────────────────────────
[ "${#POSITIONAL[@]}" -eq 3 ] || die "usage: devlab-install <repo> <artifact-dir> <env> [--port <n>] [--handover] [--check]" 2

REPO="${POSITIONAL[0]}"
ARTIFACT="${POSITIONAL[1]}"
ENVN="${POSITIONAL[2]}"

# 1) repo must satisfy the name grammar — nothing else ever reaches a path. This is a SHAPE check;
#    the namespace itself is narrowed in step 5 (the grammar admits `root`, `caddy`, `sshd`, …).
[[ "$REPO" =~ ^[a-z][a-z0-9-]{2,30}$ ]] || die "invalid repo name '$REPO' (want ^[a-z][a-z0-9-]{2,30}$)" 2
case "$REPO" in
  *--* | *-) die "invalid repo name '$REPO' (no doubled and no trailing dash)" 2 ;;
esac

# 2) env must be exactly dev or prod; prod is NOT armed in this phase.
case "$ENVN" in
  dev) : ;;
  prod) die "env 'prod' is not armed in this phase (the prod send ships via the server-side staging path)" 5 ;;
  *) die "invalid env '$ENVN' (want dev|prod)" 2 ;;
esac

# 3) the artifact dir must CANONICALIZE (realpath -e resolves '..' and every symlink) under the
#    workspace root — a traversal collapses and is rejected on the canonical path, never a glob.
[ -n "$ARTIFACT" ] || die "empty artifact dir" 2
real="$(realpath -e -- "$ARTIFACT" 2>/dev/null)" || die "artifact dir does not resolve: $ARTIFACT" 2
rootreal="$(realpath -e -- "$WORKSPACES_ROOT" 2>/dev/null)" || die "workspace root missing: $WORKSPACES_ROOT" 5
[ -d "$real" ] || die "artifact dir is not a directory: $ARTIFACT" 2
case "$real/" in
  "$rootreal"/*) : ;;
  *) die "artifact dir '$real' escapes the workspace root $rootreal" 2 ;;
esac

# 4) flag sanity: the handover exists ONLY for the self repo; a port must be a sane TCP port.
if [ "$HANDOVER" = 1 ] && [ "$REPO" != "$SELF_REPO" ]; then
  die "--handover is the self-repo restart path; '$REPO' is not the self repo" 2
fi
if [ "$PORT" != 0 ]; then
  [[ "$PORT" =~ ^[0-9]{1,5}$ ]] && [ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || die "invalid --port '$PORT'" 2
fi

# 5) THE NAMESPACE. Every narrowing that can judge a NAME judges every name, the self repo included
#    (it is the most privileged one). The three that decide something only about a foreign SERVICE —
#    whose unit is ours, whose account we are about to create, whose rights manifest we publish — run
#    for foreign repositories only. All of them are read-only and happen before any effect.
# The UNIT NAME is READ FROM THE DELIVERED SETUP PRODUCT, not ERRECHNET from the repository name: a
# service whose unit is legitimately named otherwise (a dashboard shipping <repo>-dashboard.service)
# carries that unit in the artifact's setup/ dir, and the installer finds its real name there. A package
# that ships no unit keeps the unchanged <repo> derivation (DELIVERED_SETUP=0 → the inline templates
# below generate <repo>.service exactly as before). The self repo is decided in its own branch and never
# reaches the foreign unit-name discovery, so its default here stays <repo>. The discovery for a foreign
# repo runs in step 5d (after the setup lib and $real are in hand).
SETUP_SRC="$real/setup"
UNIT_NAME="$REPO"
DELIVERED_SETUP=0
UNIT_FILE="$UNIT_DIR/${UNIT_NAME}.service"
FIRST_TIME=0
MANIFEST=""

# 5a) systemd's own namespace is refused on the SPELLING alone — no unit under `systemd-*` is ever ours,
#     so no host state could make it admissible. The reserved-IDENTITY list (root, caddy, holistic, …) is
#     judged LATER, in step 5g, once the delivered unit name (5c-bis) and the host's unit state (5d) are
#     known: a reserved name must still be admitted for the ONE service to WHICH that identity already
#     belongs (it renews itself), and that ownership is read from the host, never guessed from the name.
case "$REPO" in
  systemd-*) die "repo name '$REPO' lies in systemd's own namespace" 2 ;;
esac

# 5b) the artifact must be the RUNNER'S STAGED ARTIFACT of the checkout that carries this name:
#     <workspaces>/<user>/<repo>/.mercury-artifact. Two facts follow from it — the <repo> argument is
#     never a free-form string that merely satisfies the grammar, and an arbitrary directory under the
#     workspace root (a user-writable place) is not an artifact.
CHECKOUT="$(dirname -- "$real")"
if [ "$(basename -- "$real")" != "$ARTIFACT_DIR_NAME" ]; then
  die "artifact dir '$real' is not a staged $ARTIFACT_DIR_NAME — only the artifact the per-user build produces is installed" 2
fi
if [ "$(basename -- "$CHECKOUT")" != "$REPO" ]; then
  die "repo '$REPO' does not name the checkout the artifact was built in ($CHECKOUT)" 2
fi

# 5c) …and the checkout must belong to the CONFIGURED organisation. The owner comes from root-owned
#     runtime configuration (never from the caller, who would otherwise widen its own namespace), and
#     the checkout's origin remote is read as TEXT — git is never executed on repo content as root.
#     Every url of the origin section must match, so a decoy first entry buys nothing.
OWNER="${DEVLAB_GH_OWNER:-}"
if [ -z "$OWNER" ]; then
  [ -r "$OWNER_FILE" ] || die "no managed organisation configured: $OWNER_FILE is missing (operator-provisioned instance value)" 5
  OWNER="$(head -n1 -- "$OWNER_FILE" | tr -d '[:space:]')"
fi
[[ "$OWNER" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ ]] || die "invalid managed organisation '$OWNER' (from $OWNER_FILE)" 5

GITCONF="$CHECKOUT/.git/config"
if [ "$REPO" = "$SELF_REPO" ] && [ ! -e "$GITCONF" ]; then
  # The ONE named limit of this cascade: the self repo's very first install can ship from a directory
  # that is not yet a clone (this service bootstraps its own workspace). Where the self checkout DOES
  # present an origin it is held to it exactly like every other repository; where it does not, the
  # identity rests on 5b — the artifact must be the staged artifact of a checkout named after the self
  # repo, inside the workspace root.
  log "self checkout '$CHECKOUT' presents no git config — origin not verifiable, identity rests on the checkout name"
else
  { [ -f "$GITCONF" ] && [ ! -L "$GITCONF" ]; } || die "checkout '$CHECKOUT' carries no git config — its repository cannot be identified" 2
  # Fed on stdin, never as an argument: a path containing '=' would otherwise read as an awk
  # variable assignment rather than a file.
  ORIGINS="$(awk '
    /^[[:space:]]*\[/ { in_origin = ($0 ~ /^[[:space:]]*\[remote[[:space:]]*"origin"\]/); next }
    in_origin && /^[[:space:]]*url[[:space:]]*=/ { sub(/^[[:space:]]*url[[:space:]]*=[[:space:]]*/, ""); print }
  ' < "$GITCONF")"
  [ -n "$ORIGINS" ] || die "checkout '$CHECKOUT' has no origin remote — its repository cannot be identified" 2
  owner_lc="${OWNER,,}"
  while IFS= read -r u; do
    u="${u,,}"; u="${u%.git}"; u="${u%/}"
    case "$u" in
      "https://github.com/$owner_lc/$REPO" | "git@github.com:$owner_lc/$REPO" | "ssh://git@github.com/$owner_lc/$REPO") : ;;
      *) die "checkout origin '$u' is not $OWNER/$REPO — only repositories of the configured organisation are installed" 2 ;;
    esac
  done <<<"$ORIGINS"
fi

if [ "$REPO" != "$SELF_REPO" ]; then
  # 5c-bis) THE UNIT NAME comes from the delivered setup product. A package that carries setup/<name>.service
  #     names its own unit; the installer reads that name rather than assuming <repo>.service. Ambiguous or
  #     absent → the <repo> derivation stands (DELIVERED_SETUP=0). A divergent name is a systemctl argument
  #     and a unit-file path, so it must pass the lexical gate; the deeper guards (foreign unit below,
  #     User=<repo> at install) still bind the unit to this service's own account.
  UNIT_NAME="$(setup_delivered_unit_name "$SETUP_SRC" "$REPO")"
  if [ -n "$UNIT_NAME" ]; then
    DELIVERED_SETUP=1
    if [ "$UNIT_NAME" != "$REPO" ]; then
      setup_valid_unit_name "$UNIT_NAME" || die "refusing delivered unit '$UNIT_NAME' for '$REPO' (name/namespace)" 2
    fi
  else
    UNIT_NAME="$REPO"
  fi
  UNIT_FILE="$UNIT_DIR/${UNIT_NAME}.service"

  # 5d) unit existence is asked of SYSTEMD, not of a path: a vendor unit lives under /lib or
  #     /usr/lib and a path test in $UNIT_DIR does not see it, so "first time" would happily
  #     generate a second unit that SHADOWS a running system service (and `systemctl restart` would
  #     then start our artifact in its place). A fragment outside $UNIT_DIR — vendor, /run, or the
  #     /dev/null of a masked unit — is refused; only our own fragment counts as "already set up".
  #     The question is asked about the DELIVERED unit name — so a service already running under its
  #     own (divergently-named) unit is recognised as ALREADY SET UP and RENEWED, never duplicated.
  frag="$("$SYSTEMCTL" show -p FragmentPath --value "${UNIT_NAME}.service" 2>/dev/null)" \
    || die "could not ask systemd about ${UNIT_NAME}.service" 4
  frag="$(printf '%s' "$frag" | tr -d '[:space:]')"
  case "$frag" in
    "$UNIT_FILE") FIRST_TIME=0 ;;
    "") if [ -e "$UNIT_FILE" ]; then FIRST_TIME=0; else FIRST_TIME=1; fi ;;
    *) die "unit ${UNIT_NAME}.service already exists outside this wrapper's control ($frag) — refusing to shadow or overwrite a foreign unit" 5 ;;
  esac

  # 5g) THE RESERVED-IDENTITY GATE — judged HERE, after the delivered unit name (5c-bis) and the host's
  #     unit state (5d) are known, so it can tell apart the THREE cases the SPELLING alone cannot:
  #       forbid  — a service CLAIMS an identity (an OS account, a package unit, a landscape component)
  #                 that is not its own;
  #       renew   — the service to WHICH that identity already belongs renews itself;
  #       admit   — the identity DOES NOT EXIST YET, so a genuine first install may take it.
  #     Every judgement is read from the HOST, never derived from the name (the same defect the whole
  #     cascade before this fix was unwinding).
  #       * renew  — systemd confirms the delivered unit is already OURS (FIRST_TIME=0, an update, and a
  #                  foreign fragment was already refused in 5d) AND that unit runs as `User=<repo>`; the
  #                  account the reserved name would collide with is the very account our unit already
  #                  runs as (setup_owns_reserved_name).
  #       * admit  — a FIRST-TIME setup owns nothing, but on a bare host a reserved landscape name (like
  #                  `holistic` on a freshly provisioned production host) also COLLIDES with nothing: no
  #                  foreign account, no package, and — because this is first-time — no unit. The reserved
  #                  list guards against taking a name that belongs to someone else, not against a name
  #                  that belongs to no one; refusing here trapped the one landscape service that isn't yet
  #                  on a new host out of ever reaching it (setup_reserved_name_free).
  #     The list is NOT shortened — `holistic` stays on it. What changed is only that NON-EXISTENCE is no
  #     longer mistaken for foreign ownership. A first-time setup whose name IS already held by a foreign
  #     account or package, and an update whose unit runs as someone else, stay refused exactly as before.
  is_update=0; [ "$FIRST_TIME" = 0 ] && is_update=1
  for r in $SETUP_RESERVED_REPOS; do
    if [ "$REPO" = "$r" ]; then
      if setup_owns_reserved_name "$REPO" "$UNIT_FILE" "$is_update"; then
        log "repo name '$REPO' is reserved, but its unit '${UNIT_NAME}.service' is already ours and runs as 'User=$REPO' — this is the service the identity belongs to, renewing itself; admitted"
      elif [ "$is_update" = 0 ] && setup_reserved_name_free "$REPO" "$GETENT" "$DPKG"; then
        log "repo name '$REPO' is reserved, but nothing under this name exists on this host (no account, no package, no unit) — the identity is unclaimed; first-time install admitted"
      else
        die "repo name '$REPO' is reserved (operating-system, package or landscape identity) — a unit and a service account under this name would collide with an existing one, and no unit under this name is yet ours to renew" 2
      fi
      break
    fi
  done

  # 5e) the service account — judged WHERE IT IS DECIDED: at first-time setup, which runs `useradd`
  #     and writes `User=<repo>` into a generated unit. An account that already exists must then be
  #     the one THIS wrapper creates (system account, nologin, home /var/lib/<repo>); anything else
  #     is a foreign identity the generated unit would silently borrow.
  #     On an UPDATE the unit already exists, is root-owned, and its `User=` was settled when it was
  #     written — nothing is adopted here, so a service whose account legitimately predates DevLab
  #     stays deliverable instead of being refused for the spelling of its name.
  if [ "$FIRST_TIME" = 1 ] && "$GETENT" passwd "$REPO" >/dev/null 2>&1; then
    IFS=: read -r _pname _ppw puid _pgid _pgecos phome pshell <<<"$("$GETENT" passwd "$REPO")"
    [ "${puid:-0}" -gt 0 ] 2>/dev/null || die "account '$REPO' is uid 0 — refusing to install a service under it" 2
    [ "${phome:-}" = "/var/lib/$REPO" ] || die "account '$REPO' already exists with home '${phome:-}' (expected /var/lib/$REPO) — refusing to adopt a foreign account" 2
    case "${pshell:-}" in
      */nologin | */false) : ;;
      *) die "account '$REPO' already exists with an interactive shell '${pshell:-}' — refusing to adopt a foreign account" 2 ;;
    esac
  fi

  # 5f) the rights manifest is a validated FILE COPY out of the checkout. It is resolved here so a
  #     symlink pointing out of the checkout (…/permissions/<repo>.json -> /etc/shadow) cannot make
  #     root publish a foreign file world-readable in $PERMS_DIR. Absent is fine; escaping is not.
  cand="$CHECKOUT/permissions/$REPO.json"
  if [ -e "$cand" ] || [ -L "$cand" ]; then
    manreal="$(realpath -e -- "$cand" 2>/dev/null)" || die "rights manifest '$cand' does not resolve" 2
    case "$manreal" in
      "$CHECKOUT"/*) [ -f "$manreal" ] || die "rights manifest '$cand' is not a regular file" 2 ;;
      *) die "rights manifest '$cand' resolves to '$manreal', outside the checkout — refusing to publish it" 2 ;;
    esac
    MANIFEST="$manreal"
  fi
fi

# ── self repo: install NOW, restart only as a handover (K-2) ─────────────────────────────────────
if [ "$REPO" = "$SELF_REPO" ]; then
  BIN="$real/${SELF_UNIT}"    # the artifact carries the daemon binary under its unit name
  WEB="$real/web"
  [ -f "$BIN" ] || die "staged self binary missing: $BIN (prebuilt by the unprivileged runner)" 5
  [ -d "$WEB" ] || die "staged self web dir missing: $WEB" 5

  run install -o root -g root -m 0755 "$BIN" "/usr/local/bin/${SELF_UNIT}"
  run install -d -m 0755 "$STATE_DIR/www"
  run rsync -a --delete "$WEB/" "$STATE_DIR/www/"
  log "self install done (binary + web); running process keeps its loaded image"

  # Keep devlabd's OWN unit current from the delivered, checked-in copy, so a SECURITY directive the unit
  # template gained reaches a devlabd that was installed before it. A self UPDATE otherwise replaces only
  # the binary and never rewrites the unit — which is why `SupplementaryGroups=… systemd-journal`, the
  # right the honest running gate needs to READ a just-delivered unit's journal and name WHY a failed start
  # died, sat in the repo and never took effect: the gate kept reporting "the gate lacks journal access"
  # (2026-08-08). The unit lives in $UNIT_DIR, which IS writable inside the service cgroup (it is a
  # ReadWritePaths entry), so this needs no hand-out; instance values live in the drop-in
  # ($UNIT_DIR/${SELF_UNIT}.service.d), which this does NOT touch. The group takes effect on the handover
  # restart below. A FOREIGN unit under this name is refused (never overwritten); an older artifact that
  # ships no setup/ unit leaves the installed one unchanged. The delivered unit is trusted only if it runs
  # as its own account (User=$SELF_REPO), the same gate the production receiver applies.
  SELF_DELIV_UNIT="$SETUP_SRC/${SELF_UNIT}.service"
  SELF_UNIT_FILE="$UNIT_DIR/${SELF_UNIT}.service"
  if [ -f "$SELF_DELIV_UNIT" ]; then
    setup_unit_declares_user "$SELF_DELIV_UNIT" "$SELF_REPO" \
      || die "delivered self unit $SELF_DELIV_UNIT does not run as 'User=$SELF_REPO' — refusing to install it" 2
    self_state="$(setup_unit_state "$SELF_UNIT" "$SELF_UNIT_FILE" "$SYSTEMCTL")" \
      || die "could not ask systemd about ${SELF_UNIT}.service" 4
    case "$self_state" in
      foreign:*) die "unit ${SELF_UNIT}.service already exists outside this wrapper's control (${self_state#foreign:}) — refusing to overwrite a foreign unit" 5 ;;
    esac
    if ! cmp -s "$SELF_DELIV_UNIT" "$SELF_UNIT_FILE" 2>/dev/null; then
      run install -o root -g root -m 0644 "$SELF_DELIV_UNIT" "$SELF_UNIT_FILE"
      run "$SYSTEMCTL" daemon-reload
      log "refreshed ${SELF_UNIT}.service from the delivered unit — its security directives (systemd-journal group) reach the running service on the restart"
    else
      log "installed ${SELF_UNIT}.service already matches the delivered unit — left unchanged"
    fi
  else
    log "no delivered ${SELF_UNIT}.service in the artifact — installed unit left unchanged"
  fi

  if [ "$HANDOVER" = 1 ]; then
    # The ONE restart path: a transient unit OUTSIDE the devlabd cgroup waits for the free
    # signal, then restarts. If systemd-run fails, THIS wrapper fails (exit 4) and the caller's
    # stage fails — there is NO inline restart fallback (K-2).
    run systemd-run --unit="devlab-restart-$(date +%s)" --collect "$RESTART_HELPER" \
      || die "systemd-run failed — restart NOT scheduled; the deliver stage must fail (K-2)" 4
    log "restart handed over to a transient unit (waits on the ready socket)"
  else
    log "no restart scheduled (self restarts only via --handover)"
  fi
  exit 0
fi

# ── foreign repo: ONE generic install path that carries every declared build kind ────────────────
# The old path assumed EVERY service is a Go daemon: it demanded a prebuilt <repo>d and refused anything
# else — even when the delivery package fully described what to start. That trapped `holistic`, a Python
# (uvicorn) service, out of production. The installer now installs what the artifact CONTAINS and the unit
# DESCRIBES: the artifact SAYS what it is (build.kind, read via the shared library), and the kind — one of
# exactly two named ones — drives ONLY which prebuilt bytes are copied and where. One path, two kinds, no
# second installer and no per-service branch. An artifact that does not declare its kind is REFUSED BY
# NAME; the installer never guesses a Bauart from a filename.
KIND="$(setup_read_build_kind "$real")"
[ -n "$KIND" ] || die "artifact '$real' does not declare its build kind (no build.kind) — refusing to guess it from filenames; a service must declare its Bauart ($SETUP_BUILD_KINDS)" 2
setup_valid_build_kind "$KIND" || die "artifact declares an unknown build kind '$KIND' (known: $SETUP_BUILD_KINDS)" 2

# The prebuilt program bytes, per kind — validated to EXIST before any effect, and NEVER built here.
case "$KIND" in
  go-daemon)
    BIN="$real/${REPO}d"    # go build ./cmd/... writes cmd/<repo>d into the artifact
    [ -f "$BIN" ] || die "staged binary missing: $BIN (build.kind=go-daemon expects a prebuilt <repo>d, never built here)" 5
    ;;
  python-app)
    # A prebuilt, relocatable payload tree (a --copies virtualenv + the app), copied verbatim to /opt/<repo>.
    PAYLOAD="$real/payload"
    [ -d "$PAYLOAD" ] || die "staged payload missing: $PAYLOAD (build.kind=python-app expects a prebuilt payload/ tree, never built here)" 5
    # A python-app carries no <repo>d template: only its unit knows how to start it (ExecStart names the
    # interpreter and module). So a FIRST-TIME setup MUST ship setup/<unit>.service — the generated
    # <repo>.service template below is a go-daemon shape and does not apply here.
    if [ "$FIRST_TIME" = 1 ] && [ "$DELIVERED_SETUP" != 1 ]; then
      die "first-time setup of python-app '$REPO' needs a delivered setup/<unit>.service in the artifact — only the unit knows how to start it; there is no <repo>d template for a python-app" 5
    fi
    ;;
esac

# UNIT_FILE / UNIT_NAME / DELIVERED_SETUP / FIRST_TIME / MANIFEST were decided in the validation cascade
# (step 5) — systemd was asked about the delivered unit name, the account was judged and the manifest was
# resolved before any effect could happen.
if [ "$FIRST_TIME" = 1 ] && [ "$DELIVERED_SETUP" = 1 ]; then
  # First-time setup from the DELIVERED setup product — the SAME rule the production receiver applies, run
  # here on the dev host: the package carries setup/<unit>.service (and optionally setup/<repo>.caddy), so
  # the installer INSTALLS those bytes under the delivered unit name instead of GENERATING a <repo>.service.
  # The delivered unit is not trusted blindly — it must run as its OWN account (exactly User=<repo>), and a
  # foreign unit under this name was already refused in step 5d. No --port is demanded: the port lives in
  # the delivered unit and the honest running gate proves it.
  DELIV_UNIT="$SETUP_SRC/${UNIT_NAME}.service"
  DELIV_ROUTE="$SETUP_SRC/${REPO}.caddy"
  [ -f "$DELIV_UNIT" ] || die "first-time setup of '$REPO' has no delivered unit at $DELIV_UNIT" 5
  setup_unit_declares_user "$DELIV_UNIT" "$REPO" \
    || die "delivered unit $DELIV_UNIT does not run as 'User=$REPO' — refusing (a unit that starts something else or runs as root is not installed)" 2
  log "first-time setup of '$REPO' from the delivered setup product (unit ${UNIT_NAME}.service)"

  if [ "$CHECK" = 1 ]; then
    echo "PLAN: create system user '$REPO' (nologin) if missing"
    echo "PLAN: install delivered unit $DELIV_UNIT -> $UNIT_FILE (verified User=$REPO)"
    if [ -f "$DELIV_ROUTE" ]; then
      echo "PLAN: install delivered route $DELIV_ROUTE -> $CADDY_CONF/$REPO.caddy ($CADDY_BIN validate --config $CADDY_MAIN + reload caddy; unwind on failure)"
    else
      echo "PLAN: no delivered route in the artifact — none installed"
    fi
    if [ -n "$MANIFEST" ]; then
      echo "PLAN: install rights manifest $MANIFEST (validated copy) + groupadd its hp_* groups"
    else
      echo "PLAN: no rights manifest in the checkout — install without declared rights"
    fi
    echo "PLAN: $SYSTEMCTL daemon-reload && $SYSTEMCTL enable $UNIT_NAME"
  else
    setup_ensure_account "$REPO"
    install -o root -g root -m 0644 "$DELIV_UNIT" "$UNIT_FILE"
    if [ -f "$DELIV_ROUTE" ] && [ -d "$CADDY_CONF" ]; then
      # The route dir is SHARED (setup_install_route validates the ASSEMBLED edge and takes OUR route AND
      # the freshly written delivered unit back out on failure, so a bad route never leaves a half setup a
      # later run reads as an update). A delivered route is optional; its failure is NAMED, never swallowed.
      rc=0; reason="$(setup_install_route "$DELIV_ROUTE" "$CADDY_CONF/$REPO.caddy" "$CADDY_BIN" "$CADDY_MAIN" "$SYSTEMCTL" "$UNIT_FILE" 2>&1)" || rc=$?
      [ "$rc" = 0 ] || die "$reason" "$rc"
    elif [ -f "$DELIV_ROUTE" ]; then
      log "no route dir at $CADDY_CONF — delivered route NOT installed"
    fi
    if [ -n "$MANIFEST" ]; then
      setup_install_rights "$MANIFEST" "$PERMS_DIR" "$REPO"
    else
      log "no rights manifest in the checkout — service installs without declared rights (Uniformity gap, reported by detection)"
    fi
    "$SYSTEMCTL" daemon-reload
    "$SYSTEMCTL" enable "$UNIT_NAME" >/dev/null 2>&1 || true
  fi
elif [ "$FIRST_TIME" = 1 ]; then
  # First-time setup from the root-owned SHARED templates (setup_unit_text / setup_route_text in
  # devlab-setup-lib.sh — the ONE source the production receiver installs from too): unit + route +
  # rights with VALIDATED values only. The port is the atlas proposal handed in by the service
  # (--port); repo content is never executed, only validated files are copied. Reached when the package
  # ships NO unit (DELIVERED_SETUP=0) — the unchanged <repo>.service derivation.
  [ "$PORT" != 0 ] || die "first-time setup of '$REPO' needs --port <n> (a free port from the atlas proposal)" 5
  log "first-time setup of '$REPO' (unit + route + rights from inline templates, port $PORT)"

  if [ "$CHECK" = 1 ]; then
    echo "PLAN: create system user '$REPO' (nologin) if missing"
    echo "PLAN: write $UNIT_FILE from the inline template (ExecStart /opt/$REPO/bin/${REPO}d --listen 127.0.0.1:$PORT)"
    echo "PLAN: write $CADDY_CONF/$REPO.caddy (route /api/services/$REPO/* -> 127.0.0.1:$PORT)"
    echo "PLAN: $CADDY_BIN validate --config $CADDY_MAIN before adopting the route; on failure remove $CADDY_CONF/$REPO.caddy and fail (the route dir is shared with every other service)"
    echo "PLAN: $SYSTEMCTL reload caddy (a failed reload fails this install — the route is taken back out)"
    if [ -n "$MANIFEST" ]; then
      echo "PLAN: install rights manifest $MANIFEST (validated copy) + groupadd its hp_* groups"
    else
      echo "PLAN: no rights manifest in the checkout — install without declared rights"
    fi
    echo "PLAN: $SYSTEMCTL daemon-reload && $SYSTEMCTL enable $REPO"
  else
    setup_ensure_account "$REPO"
    setup_unit_text "$REPO" "$PORT" > "$UNIT_FILE"
    if [ -d "$CADDY_CONF" ]; then
      # This directory is SHARED: the edge serves every other service of the host out of it, so an
      # unparseable file of ours does not break "our" route — it breaks the whole edge at the next
      # reload. So the ASSEMBLED configuration is validated first and OUR file is taken back out when
      # it does not hold, and the reload's failure is NAMED instead of swallowed: the caller must not
      # read "installed" over a service that has no route.
      ROUTE_FILE="$CADDY_CONF/$REPO.caddy"
      setup_route_text "$REPO" "$PORT" > "$ROUTE_FILE"
      # unwind_first_time removes what THIS first-time branch has created so far — the route and the
      # generated unit, both of which did not exist before this run (FIRST_TIME=1 was decided by
      # systemd). Without it a failed route step would leave a unit behind, the next attempt would read
      # as an UPDATE, skip the route step altogether, and report success over a service with no route.
      # The system account and /var/lib/<repo> stay: creating them is idempotent and harmless.
      unwind_first_time() { rm -f "$ROUTE_FILE" "$UNIT_FILE"; }
      if command -v "$CADDY_BIN" >/dev/null 2>&1 && [ -f "$CADDY_MAIN" ]; then
        if ! validate_out="$("$CADDY_BIN" validate --config "$CADDY_MAIN" 2>&1)"; then
          unwind_first_time
          die "the edge configuration does not validate with the new route — route and generated unit removed, edge untouched: $(printf '%s' "$validate_out" | tail -n 3)" 4
        fi
      else
        unwind_first_time
        die "cannot validate the shared edge configuration ($CADDY_BIN / $CADDY_MAIN) — refusing to write into a config directory serving every other service; provision the route by hand" 5
      fi
      "$SYSTEMCTL" reload caddy || {
        unwind_first_time
        die "caddy reload failed — route and generated unit removed so the edge keeps its last good configuration and the next attempt is a clean first-time setup" 4
      }
    else
      log "no route dir at $CADDY_CONF — route NOT written"
    fi
    # Rights manifest: the FILE COPY validated in step 5f (resolved inside the checkout, a regular
    # file, never a symlink out of it). Never executed.
    if [ -n "$MANIFEST" ]; then
      install -d -m 0755 "$PERMS_DIR"
      install -m 0644 "$MANIFEST" "$PERMS_DIR/$REPO.json"
      grep -oE '"group"[[:space:]]*:[[:space:]]*"hp_[a-z0-9_]+"' "$MANIFEST" | grep -oE 'hp_[a-z0-9_]+' | sort -u |
        while read -r g; do groupadd -f "$g"; done
    else
      log "no rights manifest in the checkout — service installs without declared rights (Uniformity gap, reported by detection)"
    fi
    "$SYSTEMCTL" daemon-reload
    "$SYSTEMCTL" enable "$REPO" >/dev/null 2>&1 || true
  fi
fi

# Mint this host's instance secrets from what the service's unit demands (setup_ensure_secrets in the
# shared library — the SAME rule the production receiver applies) BEFORE the restart. A service reads
# /etc/holistic/jwt-secret; a host that has none makes the program install cleanly and then die at start
# in a restart loop. Secrets are minted on THIS host and never transported; a missing OUTSIDE credential
# is NAMED, not swallowed. Derive from the unit that WILL be in place — the generated one (first-time)
# or the installed one (update); in a first-time dry-run the unit is not on disk yet, so render it.
secret_unit="$UNIT_FILE"; secret_tmp=0
if [ ! -r "$secret_unit" ] && [ "$FIRST_TIME" = 1 ]; then
  if [ "$DELIVERED_SETUP" = 1 ]; then
    # The delivered unit is right there in the artifact — read the secrets it demands from it, no render.
    secret_unit="$SETUP_SRC/${UNIT_NAME}.service"
  elif [ "$PORT" != 0 ]; then
    secret_unit="$(mktemp)"; secret_tmp=1; setup_unit_text "$REPO" "$PORT" > "$secret_unit"
  fi
fi
if [ "$CHECK" = 1 ]; then setup_plan_secrets "$secret_unit"; else setup_ensure_secrets "$REPO" "$UNIT_FILE"; fi
[ "$secret_tmp" = 1 ] && rm -f -- "$secret_unit"

# Install the prebuilt program per its DECLARED kind — a pure copy of already-built bytes; root never
# builds (E §7.4). The unit installed above (delivered or generated) already names how to start it.
case "$KIND" in
  go-daemon)
    run install -d -o root -g root -m 0755 "/opt/$REPO/bin"
    run install -o root -g root -m 0755 "$BIN" "/opt/$REPO/bin/${REPO}d"
    ;;
  python-app)
    # Copy the prebuilt payload VERBATIM to /opt/<repo> (the venv's console-script shebangs already point
    # here — relocated at build time — so this is a plain copy, not a build). --safe-links drops any
    # symlink that would escape the payload, so a crafted link cannot make root expose a foreign file under
    # the service tree; --delete keeps /opt/<repo> exactly what was delivered. The program files land
    # root-owned, then a+rX makes the tree readable and traversable for the unit's own service account
    # (User=<repo>, not root) — the same public-by-role rule the dashboard serve root uses, so the build
    # user's umask cannot leave the interpreter unreadable to the account that must run it.
    run install -d -o root -g root -m 0755 "/opt/$REPO"
    run rsync -a --delete --safe-links "$PAYLOAD/" "/opt/$REPO/"
    run chmod -R a+rX "/opt/$REPO"
    ;;
esac
run "$SYSTEMCTL" restart "$UNIT_NAME"
log "install-only deploy of '$REPO' program ($KIND) done (running-proof is the caller's honest gate, F10)"

# ── the service UI: wire it in, rebuild the dashboard, and DELIVER it to where the browser reads ──
# "Delivered" means the user SEES it — the browser fetches the NEW bundle. A service that ships a ui/
# is fully delivered only once three things have happened, in order:
#   1. its ui SOURCE (staged by the unprivileged build) is copied into <frontend>/external/<repo>;
#   2. the SHARED dashboard is rebuilt — the build IS the check (lint + typecheck + vite enforce that a
#      service ui uses only @holistic/ui, react, react-dom or relative files and no raw HTML elements);
#   3. the freshly built bundle is COPIED to the serve root the browser fetches from ($HOLISTIC_WWW).
# The old delivery did (1) and (2) and then reported `built` — but never (3), so the browser kept
# serving the OLD bundle: a green report over half-done work. `built` is now reported ONLY after (3).
# And the rebuild (2) runs AS THE CHECKOUT OWNER, never as root: "root never builds" holds for the ui
# half as much as the program half, so no root-owned file is left in the operator's checkout to trip
# their next `git`/`npm` with "Permission denied". The single `MERCURY-UI:` line reports the outcome.
UI_SRC="$real/ui"
if [ ! -d "$UI_SRC" ]; then
  echo "MERCURY-UI: none"
  log "no ui/ in the artifact — service '$REPO' ships no dashboard face"
  exit 0
fi

# The dashboard checkout is INSTANCE configuration (never a literal in the repo): env seam, else the
# root-owned file. Absent config is a NAMED deficiency of the delivery, not a silent skip of the UI half.
if [ -z "$HOLISTIC_REPO" ] && [ -r "$HOLISTIC_REPO_FILE" ]; then
  HOLISTIC_REPO="$(head -n1 -- "$HOLISTIC_REPO_FILE" | tr -d '[:space:]')"
fi
if [ -z "$HOLISTIC_REPO" ]; then
  echo "MERCURY-UI: unconfigured"
  die "service '$REPO' ships a ui/, but no holistic dashboard checkout is configured (DEVLAB_HOLISTIC_REPO / $HOLISTIC_REPO_FILE) — the program is installed, but its face could NOT be built in" 5
fi
FRONT="$HOLISTIC_REPO/$HOLISTIC_FRONTEND"
EXT="$FRONT/external/$REPO"
{ [ -d "$HOLISTIC_REPO/.git" ] || [ -f "$HOLISTIC_REPO/.git" ]; } \
  || die "configured holistic checkout '$HOLISTIC_REPO' is not a git repository — cannot wire the UI of '$REPO' in" 5
[ -d "$FRONT" ] || die "holistic frontend '$FRONT' not found under the configured checkout — cannot wire the UI of '$REPO' in" 5

# WHO builds the dashboard: the OWNER of the checkout, never root. Measured, not assumed — the build
# writes node_modules/dist into the checkout, so it must run as whoever owns that tree, or it leaves
# foreign-owned files behind (root did exactly that: 109 root-owned files the operator then could not
# touch). A root-owned checkout is itself the misconfiguration this rule removes, so it is refused by
# name rather than silently building as root again.
CO_OWNER="$(stat -c %U "$HOLISTIC_REPO" 2>/dev/null || true)"
CO_GROUP="$(stat -c %G "$HOLISTIC_REPO" 2>/dev/null || true)"
{ [ -n "$CO_OWNER" ] && [ "$CO_OWNER" != root ]; } \
  || die "holistic checkout '$HOLISTIC_REPO' is owned by '$CO_OWNER' — the dashboard build must run unprivileged (root never builds); give the checkout a non-root owner" 5
CO_HOME="$(getent passwd "$CO_OWNER" | cut -d: -f6)"

# WHERE the browser reads the dashboard from — the serve root. Instance config like the checkout: env
# seam, root-owned file, else the holistic convention. This is the MEASURE of the ui half: a build that
# does not reach here has not been delivered, whatever the checkout's build output says.
if [ -z "$HOLISTIC_WWW" ] && [ -r "$HOLISTIC_WWW_FILE" ]; then
  HOLISTIC_WWW="$(head -n1 -- "$HOLISTIC_WWW_FILE" | tr -d '[:space:]')"
fi
[ -n "$HOLISTIC_WWW" ] || HOLISTIC_WWW="$HOLISTIC_WWW_DEFAULT"
DIST_DIR="$FRONT/$HOLISTIC_DIST"

# ── the ONE rule for relocating a service ui into the dashboard ──────────────────────────────────
# The delivery MOVES a tree whose editor configuration knows its ORIGINAL place. A service
# ui/tsconfig.json extends the dashboard base by a path that resolves only where the service repo sits
# BESIDE holistic (../../holistic/frontend/tsconfig.base.json); once copied into
# <frontend>/external/<repo> that path climbs out of the tree into nothing, and the vite build dies
# before it starts — for EVERY ui-bearing service, since they all carry that same line. The
# AUTHORITATIVE build is the dashboard's OWN (this very rebuild); the tsconfig inside a service is
# editor convenience, by its own header. So the relocation NEUTRALISES it: the editor-only TS project
# configs are NOT copied into the dashboard, and the dashboard's own config governs external/<repo>/src.
# The fault is straightened at the SINGLE point where the tree changes location — the service sources
# are copied verbatim and never rewritten. Both the real wire-in and the --check simulation call THIS
# one function, so the acceptance guards exactly the behaviour that ships. Never a symlink: a link into
# the user-writable workspace would let the checkout mutate what the dashboard builds after vetting.
wire_ui_copy() {  # <src> <dst>
  install -d -m 0755 "$2"
  rsync -a --delete --exclude='/tsconfig.json' --exclude='/tsconfig.*.json' "$1/" "$2/"
}

# serve_dashboard is the DELIVERY step whose absence was the whole bug: it copies the built bundle to
# the serve root the browser fetches. Install-only (a plain copy of already-built bytes — root does
# not build here), so both the real path and the --check simulation call this ONE function and the
# acceptance guards exactly the copy that ships.
#
# THE SERVE ROOT IS READABLE BY ITS ROLE, NOT BY THE BUILDER'S UMASK. `rsync -a` carries the SOURCE's
# permission bits, and the source is the build tree in the ERBAUER's checkout: whoever built decided,
# via their umask, whether the delivered files were world-readable. That is exactly how the served tree
# ended up rw-r----- / rwxr-x--- and the webserver — a different account entirely — answered 404 over a
# page that was present. A serve root is not a private directory: it is public by role, because the
# browser fetches every byte of it. So after the copy the permissions are DERIVED FROM THAT ROLE —
# directories betretbar, files lesbar for every reader (`a+rX`) — regardless of who built or under which
# umask. World-read (rather than adding the webserver to a group) needs no knowledge of the webserver's
# account, which is instance configuration this template does not and should not carry; it makes the
# tree reachable for ANY webserver identity.
serve_dashboard() {  # <built-bundle-dir> <serve-root>
  install -d -m 0755 "$2"
  rsync -a --delete "$1/" "$2/"
  chmod -R a+rX "$2"
}

# serve_readable proves the delivered serve root is actually reachable by the webserver — point (2):
# a delivery whose result the webserver cannot read is NOT complete and must say so, never a silent
# green (F10 — proven, not assumed; the honesty rule the caller already enforces on the program half).
# The webserver's account is INSTANCE configuration this template does not carry, so we prove the ROLE
# property that makes the page readable for every possible account: an unprivileged reader with no
# special rights can read the start page. Running as root (production, via sudo) we DROP to `nobody` —
# the nologin account present on every host — and read index.html: if `nobody` can read it, the
# webserver can too, whatever its account. Without root (the direct-invocation test seam, id != 0, where
# no privilege drop is possible) we check the same property on the mode bits: the other-read bit must be
# set. Either way a serve root the webserver could not read fails BENANNT.
# It echoes the named reason to stderr and RETURNS non-zero (it does not die), so each caller decides
# what to report first — the real path prints `MERCURY-UI: failed` before failing, the --check
# simulation only records the outcome.
serve_readable() {  # <serve-root>  → 0 if the webserver can read the start page, else 1 (reason on stderr)
  local index="$1/index.html"
  [ -f "$index" ] || { echo "devlab-install: error: serve root $1 has no index.html after delivery — the browser has no start page to fetch (delivery incomplete)" >&2; return 1; }
  if [ "$(id -u)" = 0 ] && command -v runuser >/dev/null 2>&1 && getent passwd nobody >/dev/null 2>&1; then
    runuser -u nobody -- test -r "$index" && return 0
    echo "devlab-install: error: the delivered start page $index is NOT readable by an unprivileged reader ('nobody') — the webserver would answer 404 over a present page; the serve root's permissions do not match its public role (delivery incomplete)" >&2
    return 1
  fi
  local mode; mode="$(stat -c %a "$index" 2>/dev/null || echo 0)"
  [ "$(( 8#${mode:-0} & 4 ))" = 4 ] && return 0
  echo "devlab-install: error: the delivered start page $index lacks other-read (mode $mode) — the webserver could not read it (delivery incomplete)" >&2
  return 1
}

# serve_stamp is the before/after proof of arrival: the newest file mtime under the serve root. The
# measure of the ui half is THIS tree's timestamp, not the checkout's build output.
serve_stamp() {  # <serve-root>
  if [ -d "$1" ] && [ -n "$(ls -A "$1" 2>/dev/null)" ]; then
    # `|| true`: a permission-denied in find must not, under pipefail, abort the delivery it is only
    # trying to describe.
    { find "$1" -type f -printf '%TY-%Tm-%Td %TH:%TM:%TS\n' 2>/dev/null | sort | tail -n1; } || true
  else
    echo "(empty)"
  fi
}

# build_dashboard rebuilds the shared dashboard AS THE CHECKOUT OWNER — runuser drops root's privilege
# so npm runs unprivileged and every file it writes is owned by the checkout owner, not root (E §7.4:
# root never builds). A login shell loads that user's own toolchain (node/npm on their PATH), exactly
# as the operator would build by hand.
build_dashboard() {
  runuser -u "$CO_OWNER" -- env -i \
    HOME="$CO_HOME" USER="$CO_OWNER" LOGNAME="$CO_OWNER" PATH="/usr/local/bin:/usr/bin:/bin" CI=true \
    bash -lc 'cd "$1" || exit 1; if [ ! -d node_modules ]; then npm ci --no-audit --no-fund || exit 1; fi; npm run build' _ "$FRONT" 2>&1
}

if [ "$CHECK" = 1 ]; then
  echo "PLAN: rsync the service ui source $UI_SRC -> $EXT (validated copy, never a symlink into the workspace), then chown to the checkout owner '$CO_OWNER' so root leaves no file in the operator's checkout"
  # Prove BOTH location-changing steps against a throwaway pair with the very functions the real path
  # uses, without touching anything persistent: (a) the wire-in must NOT carry the editor tsconfig out
  # of its tree, and (b) the serve step must actually move a built bundle to the serve root — the step
  # whose ABSENCE let a rebuilt dashboard never reach the browser.
  sim="$(mktemp -d)"
  wire_ui_copy "$UI_SRC" "$sim/ext"
  leaked="$(cd "$sim/ext" && ls tsconfig.json tsconfig.*.json 2>/dev/null || true)"
  # A PRIVATE source bundle — the very shape (builder umask → rw-------/rwx------) that made the served
  # tree unreadable to the webserver. serve_dashboard must deliver it readable anyway, by its role.
  mkdir -p "$sim/dist"; echo "sentinel" > "$sim/dist/index.html"
  chmod 700 "$sim/dist"; chmod 600 "$sim/dist/index.html"
  serve_dashboard "$sim/dist" "$sim/www"
  arrived=no; if [ -f "$sim/www/index.html" ]; then arrived=yes; fi
  # (a) the private source is nonetheless delivered readable (serve_readable passes on the throwaway root)
  readable=no; if serve_readable "$sim/www" >/dev/null 2>&1; then readable=yes; fi
  # (b) a serve root whose start page is NOT readable is REFUSED by name (serve_readable returns non-zero)
  mkdir -p "$sim/unreadable"; echo x > "$sim/unreadable/index.html"; chmod 640 "$sim/unreadable/index.html"
  refused=no; if ! serve_readable "$sim/unreadable" >/dev/null 2>&1; then refused=yes; fi
  rm -rf -- "$sim"
  if [ -n "$leaked" ]; then
    echo "PLAN: FAULT — an editor tsconfig would be copied into external/$REPO and break the dashboard build: $leaked"
    echo "MERCURY-UI: would-fail"
    exit 2
  fi
  if [ "$arrived" != yes ]; then
    echo "PLAN: FAULT — the serve step did not deliver the bundle to the serve root (the browser would keep the old one)"
    echo "MERCURY-UI: would-fail"
    exit 2
  fi
  if [ "$readable" != yes ]; then
    echo "PLAN: FAULT — the serve step delivered the bundle but the serve root was not readable by the webserver's role (the browser would get 404 over a present page)"
    echo "MERCURY-UI: would-fail"
    exit 2
  fi
  if [ "$refused" != yes ]; then
    echo "PLAN: FAULT — an unreadable start page was NOT refused; a serve root the webserver cannot read would be reported green"
    echo "MERCURY-UI: would-fail"
    exit 2
  fi
  echo "PLAN: the serve root is made readable by its PUBLIC ROLE (a+rX), not by the builder's umask — a private source is delivered readable (verified on a throwaway pair)"
  echo "PLAN: after delivery the start page is PROVEN readable by the webserver's role (an unreadable one fails BENANNT), so a served tree the browser cannot read is never reported green"
  echo "PLAN: editor-only tsconfig is neutralised (not copied) — the dashboard's own build config governs external/$REPO"
  echo "PLAN: rebuild the shared dashboard in $FRONT AS THE CHECKOUT OWNER '$CO_OWNER' (runuser — root never builds; no root-owned file lands in the operator's checkout)"
  echo "PLAN: DELIVER the built bundle $DIST_DIR -> the serve root $HOLISTIC_WWW (rsync --delete + chown to its owner) — this is what the browser fetches; serve-copy verified on a throwaway pair (bundle arrived)"
  echo "PLAN: MERCURY-UI: built is reported ONLY after the bundle has ARRIVED at $HOLISTIC_WWW — a rebuilt-but-undelivered dashboard fails, never green"
  echo "PLAN: a build failure naming external/$REPO removes $EXT and fails with the real error (MERCURY-UI: failed)"
  echo "PLAN: a build failure naming ANOTHER service keeps $EXT and is reported, not charged to '$REPO' (MERCURY-UI: foreign-blocked)"
  echo "MERCURY-UI: planned"
  exit 0
fi

# (1) Wire the vetted ui source into the dashboard, neutralising the editor-only tsconfig (wire_ui_copy).
# rm -rf first for a clean slate. root did the copy (it reads the group-owned artifact the checkout
# owner cannot), so chown the result to the checkout owner immediately — no root-owned file stays behind.
if [ ! -d "$FRONT/external" ]; then
  install -d -m 0755 "$FRONT/external"; chown "$CO_OWNER:$CO_GROUP" "$FRONT/external" 2>/dev/null || true
fi
rm -rf -- "$EXT"
wire_ui_copy "$UI_SRC" "$EXT"
chown -R "$CO_OWNER:$CO_GROUP" "$EXT" 2>/dev/null || true

# (2) Rebuild the shared dashboard AS THE CHECKOUT OWNER (root never builds). It is EXPENSIVE and
# compiles every wired-in service at once; it runs ONCE per UI-bearing delivery — the minimal cadence
# that still proves "the user sees it".
if build_out="$(build_dashboard)"; then
  # (3) DELIVER: the bundle only counts once it sits where the browser reads. Prove the build produced
  # one, copy it to the serve root, chown it back to the serve root's owner (root's copy leaves no
  # root-owned file there either), and confirm it arrived — THEN, and only then, report built.
  { [ -d "$DIST_DIR" ] && [ -n "$(ls -A "$DIST_DIR" 2>/dev/null)" ]; } || {
    echo "MERCURY-UI: failed"
    die "the shared dashboard build reported success but produced no bundle at $DIST_DIR — nothing to deliver; a rebuilt-but-undelivered dashboard is a failure, not green" 4
  }
  www_before="$(serve_stamp "$HOLISTIC_WWW")"
  www_owner="$(stat -c %U "$HOLISTIC_WWW" 2>/dev/null || true)"
  www_group="$(stat -c %G "$HOLISTIC_WWW" 2>/dev/null || true)"
  serve_dashboard "$DIST_DIR" "$HOLISTIC_WWW"
  [ -n "$www_owner" ] && chown -R "$www_owner:$www_group" "$HOLISTIC_WWW" 2>/dev/null || true
  [ -n "$(ls -A "$HOLISTIC_WWW" 2>/dev/null)" ] || {
    echo "MERCURY-UI: failed"
    die "the serve-copy delivered nothing to the serve root $HOLISTIC_WWW — the browser would keep serving the old bundle" 4
  }
  # The delivery PROVES the webserver can read what it just delivered (point 2). serve_dashboard set the
  # role permissions; the chown above may have changed the owner but not the readability. A serve root
  # the webserver cannot read is an incomplete delivery, not green — so fail BENANNT if the start page is
  # unreadable rather than let the browser answer 404 over a present page.
  if ! serve_readable "$HOLISTIC_WWW"; then
    echo "MERCURY-UI: failed"    # serve_readable printed the named reason to stderr
    die "the delivered dashboard at the serve root $HOLISTIC_WWW is not readable by the webserver — see the reason above; the delivery is incomplete, not green" 4
  fi
  www_after="$(serve_stamp "$HOLISTIC_WWW")"
  echo "MERCURY-UI: built"
  log "service '$REPO' ui wired into $EXT; dashboard rebuilt as '$CO_OWNER' (root never built); bundle delivered to the serve root $HOLISTIC_WWW — the browser now serves the new dashboard (serve root: was [$www_before], now [$www_after])"
  exit 0
fi

# The build failed. A SHARED build must not fail THIS service for ANOTHER service's broken ui — but it
# must not hide it either. Attribution is by the paths the toolchain names: a failure touching
# external/<repo> is OURS; one that never names it belongs to a service broken before this delivery.
if printf '%s\n' "$build_out" | grep -qF "external/$REPO"; then
  rm -rf -- "$EXT"     # leave no half-wired, unbuildable tree behind — the next attempt starts clean
  echo "MERCURY-UI: failed"
  die "service '$REPO' ui does not build in the dashboard (lint/typecheck/vite) — removed $EXT: $(printf '%s' "$build_out" | tail -n 20)" 4
fi
# Blocked by another service: this ui is wired and neutralised, but the shared bundle did NOT rebuild,
